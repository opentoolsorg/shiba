{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.json"],
  "globalPassThroughEnv": ["SHIBA_DESKTOP_URL", "SHIBA_DESKTOP_SETUP", "SHIBA_ACCEPTANCE_PORT", "OPEN_CONNECTOR_*", "OOMOL_CONNECT_ORIGIN"],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "public/**",
        ".astro/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": [
        "dist/**",
        "tsconfig.tsbuildinfo"
      ]

    },
    // These checks do not emit application bundles. Restoring dist here can
    // replace a fresh build with unrelated files left by an earlier build.
    "@shiba/web#typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "@shiba/frontend#typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    // `test` stays uncached by decision: a stale green result is worse than a
    // slow one. If a live-suite escape hatch is ever needed, keep it here.
    "test": {
      "cache": false,
      "outputs": [
        "coverage/**"
      ]
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
