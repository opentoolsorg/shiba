# Copy to .env (gitignored) or run `pnpm run bootstrap`, which writes it for you.
# alchemy.run.ts loads this file; every secret present here is bound on deploy,
# and any secret missing here is REMOVED from the Worker on the next deploy.
#
# Declared in .env.schema (varlock) — add new vars there too, then validate
# with `pnpm env:load` and leak-check with `pnpm env:scan`.

# Cloudflare Access — managed on the actual public hostname for every stage.
# Or leave empty and configure BETTER_AUTH_SECRET + the bootstrap token below.
ACCESS_EMAILS=you@example.com
# The <x> in https://shiba-ai-coworker.<x>.workers.dev
WORKERS_SUBDOMAIN=
# Public dashboard hostname — feeds https://<host>/api/screenshots/<id> links
# Must equal this stage's public host; required explicitly for live deployments.
# Previews derive their own workers.dev host; remove inherited live overrides.
#   WORKER_HOSTNAME=

# API token optional when an Alchemy Cloudflare profile is stored.
CLOUDFLARE_API_TOKEN=
# Required deployment target: exactly 32 lowercase hexadecimal characters.
CLOUDFLARE_ACCOUNT_ID=
# Optional prebuilt image; must belong to CLOUDFLARE_ACCOUNT_ID.
SANDBOX_IMAGE=

# Secrets
GITHUB_TOKEN=
AI_GATEWAY_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_APPROVERS=
ARTIFACT_SIGNING_KEY=
SLACK_CHANNEL_REPOS=
# Dashboard sign-in emails allowed to approve shared (automation/review/Sentry) runs; empty = nobody
DASHBOARD_APPROVERS=
# Slack channel for approval messages (optional)
#   SLACK_APPROVALS_CHANNEL=
# Collaboration-room outbound delivery is disabled unless explicitly set true.
SLACK_ROOM_OUTBOX_ENABLED=false
# Optional native agent-session status, after reviewing docs/slack-agent-sessions.md.
# Existing ordinary Slack messages and approvals do not require this feature.
SLACK_AGENT_SESSIONS_ENABLED=false
SLACK_AGENT_SESSIONS_TEAM_ID=
# Exact Slack team/channel to Access owner mapping. Empty disables Slack canvas views.
# JSON array with teamId, channelId, ownerId and optional viewerIds for each configured channel.
# viewerIds allows at most 16 Access emails to read only that channel's exact Slack canvases.
SLACK_CANVAS_OWNERS="[]"
# External MCP egress is deny-by-default; add exact public hostnames only.
MCP_TRUSTED_HOSTS=
# Optional vendor-registered OAuth client IDs; unset vendors remain unavailable for OAuth.
MCP_OAUTH_CLIENT_STRIPE=
MCP_OAUTH_CLIENT_NOTION=
MCP_OAUTH_CLIENT_SENTRY=
MCP_OAUTH_CLIENT_POSTHOG=
MCP_OAUTH_CLIENT_FIGMA=
MCP_OAUTH_CLIENT_JIRA_ATLASSIAN=
GITHUB_WEBHOOK_SECRET=
TYPESAFE_API_KEY=

# Built-in dashboard auth (unset = lane dark; >=32 chars turns it on)
BETTER_AUTH_SECRET=
# Optional override; must exactly match this stage's HTTPS origin.
BETTER_AUTH_URL=
# First account on a public host requires a token. Owner email further restricts signup. Loopback dev can omit both.
BETTER_AUTH_BOOTSTRAP_TOKEN=
BETTER_AUTH_OWNER_EMAIL=
# Native team enrollment also needs SEND_EMAIL and an HTTPS BETTER_AUTH_URL.
# Use an already verified email sender. No invitations are emailed automatically.
BETTER_AUTH_VERIFICATION_FROM=

# Subscription lanes — each pair is flag + credential (all unset = lane dark).
# Per-account credentials resolve as <NAME>_<ACCOUNT> at egress.
#   SHIBA_CLAUDE_SUBSCRIPTION=1
#   CLAUDE_SUBSCRIPTION_TOKEN=       `claude setup-token` output
#   CLAUDE_SUBSCRIPTION_MODEL=       per-deploy model override
#   SHIBA_CODEX_SUBSCRIPTION=1
#   CODEX_SUBSCRIPTION_AUTH_JSON=    `codex login` auth.json contents verbatim
#   CODEX_SUBSCRIPTION_MODEL=
#   SHIBA_ANTIGRAVITY_SUBSCRIPTION=1
#   ANTIGRAVITY_SUBSCRIPTION_MODEL=  (in-container OAuth — no token var)
#   SHIBA_CURSOR_SUBSCRIPTION=1
#   CURSOR_SUBSCRIPTION_TOKEN=       the operator's Cursor Agent API key
#   CURSOR_SUBSCRIPTION_MODEL=
# T51 local runtime (all unset = dark):
#   SHIBA_LOCAL_RUNTIME=1        admits runtime:"local" on the dashboard + opens /api/local
#   LOCAL_ADAPTER_TOKEN=         bearer the `shiba local` daemon presents on /api/local/*

# Feature flags (plain vars, never secrets):
#   AUTOMATIONS_ENABLED=1        the automations scheduler loop
#   MEMORY_ENABLED=1             memory subsystem (Vectorize + Memory DO)
#   REQUIRE_ACCESS=              derived by managed Access — do not override
#   ALCHEMY_STATE_BACKEND=       `cloudflare` = CF state store; unset = local files

# Harness + model picks:
#   AGENT_HARNESS=               opencode | claude-code | codex | grok | *-acp lanes
#   CLAUDE_CODE_MODEL= / CODEX_MODEL= / GROK_MODEL= / PI_MODEL=
#   ROLE_MODEL_MAP=              one JSON object, e.g. {"fixer":{"harness":"opencode","model":"opencode-go/deepseek-v3.2"}}
#   ROLE_MODEL__<ROLE>=          single "harness/model" or bare "harness" pin
#   ACP_REGISTRY_ALLOWLIST=      comma-separated ACP registry ids ("*" = all; blank = lane dark)
#   ACP_REGISTRY_JSON=           pinned registry.json snapshot (verbatim JSON)
#   ACP_MODEL=                   default acp lane agent, e.g. acp/claude-acp
#                                (ORCHESTRATOR | EXPLORER | FIXER | REVIEWER | DESIGNER)

# Telegram lane (all unset = dark):
#   TELEGRAM_BOT_TOKEN=          @BotFather token — POST /api/telegram/webhook
#   TELEGRAM_WEBHOOK_SECRET=     secret header Telegram must present
#   TELEGRAM_APPROVERS=          approver user ids
#   TELEGRAM_CHAT_REPOS=         chat→repo routing map
#   TELEGRAM_AGENT_HARNESS=      per-channel harness override (blank = AGENT_HARNESS)

# Discord lane (all unset = dark):
#   DISCORD_PUBLIC_KEY=          app Ed25519 key — verifies POST /api/discord/interactions
#   DISCORD_APPROVERS=           approver user ids
#   DISCORD_CHANNEL_REPOS=       channel→repo routing map
#   DISCORD_AGENT_HARNESS=       per-channel harness override

# Usage surfaces:
#   USAGE_BUDGET_USD=            optional daily budget shown on the usage card

# Agent mailbox identity — the address the MCP latest_verification tool
# scans when no mailbox is given (default dev@tryshiba.dev):
#   AGENT_MAILBOX=               the agent's registered inbox address

# Sole SaaS integrations provider: separately deployed open-connector.
INTEGRATIONS_PROVIDER=openconnector
OPEN_CONNECTOR_WORKER=
OPEN_CONNECTOR_URL=
# @sensitive
OPEN_CONNECTOR_ADMIN_TOKEN=
# @sensitive
OPEN_CONNECTOR_RUNTIME_TOKEN=

# Owner-bound local team execution is optional and disabled by default.
SHIBA_PERSONAL_LOCAL_EXECUTION=0

# Optional native team text turns require a separately reviewed operator funding grant.
SHIBA_TEAM_MODEL_SESSIONS=0
SHIBA_TEAM_MODEL_MODEL=@cf/zai-org/glm-4.7-flash

# Optional standing reads, managed Slack installations and isolated desktop.
# No credentials, connections or compute are created by these defaults.
SHIBA_SHARED_COMPUTER=0
SHIBA_SHARED_COMPUTER_IMAGE=
FOUNDER_AUTOMATIC_READS_ENABLED=false
FOUNDER_STRIPE_READS_ENABLED=false
# Worker-only encryption key (64 hex); account restricted keys are entered separately.
FOUNDER_STRIPE_CREDENTIAL_KEY=
FOUNDER_META_READS_ENABLED=false
# Worker-only Meta encryption key (64 hex); account tokens are entered separately.
FOUNDER_META_CREDENTIAL_KEY=
FOUNDER_HUBSPOT_READS_ENABLED=false
FOUNDER_RECONCILIATION_SCHEDULES_ENABLED=false
# Worker-only HubSpot capture encryption key (64 hex); supplied token is separate.
FOUNDER_HUBSPOT_CREDENTIAL_KEY=
OPEN_CONNECTOR_READ_VERSION_ID=
OPEN_CONNECTOR_READ_MANIFEST_SHA256=
SLACK_INSTALLATIONS_ENABLED=false
SLACK_OAUTH_APP_ID=
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_REDIRECT_URI=
SLACK_OAUTH_PKCE_ENABLED=false
SLACK_OAUTH_QUERY_REDACTION_VERIFIED=false
SLACK_LEGACY_MODE_ENABLED=false
SLACK_LEGACY_TEAM_ID=
SLACK_LEGACY_APP_ID=
# Worker-only encrypted bot credential keyring; never expose to a container.
SLACK_INSTALLATION_KEYRING=

# Existing reviewed gateway Worker name, only for the optional Alchemy service binding.
OPEN_CONNECTOR_READ_WORKER=
# Separate scoped read-lane key; never replace the existing manual integration key.
OPEN_CONNECTOR_READ_RUNTIME_TOKEN=
# Exact workspace/connection/operation runtime keys; JSON array, Worker-only.
OPEN_CONNECTOR_SCOPED_READ_RUNTIME_TOKENS=
