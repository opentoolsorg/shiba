{
  "name": "shiba",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted AI employees for marketing, coding, design and QA, with approval-gated repository-backed work.",
  "type": "module",
  "scripts": {
    "generate:og": "node scripts/generate-shiba-og.mjs",
    "build": "turbo run build && node scripts/assemble-public.mjs && pnpm run docs:verify",
    "build:dashboard": "turbo run build --filter=@shiba/frontend",
    "deploy:alchemy": "node scripts/deploy.mjs",
    "deploy:preview": "node scripts/deploy.mjs --plan",
    "deploy:preview:wrangler": "node scripts/deploy.mjs --plan --wrangler",
    "deploy:destroy": "node scripts/deploy.mjs --destroy",
    "dev": "node scripts/local-dev.mjs",
    "dev:all": "node scripts/local-dev.mjs",
    "dev:turbo": "turbo run dev",
    "dev:website": "turbo run dev --filter=@shiba/web",
    "dev:app": "turbo run dev --filter=@shiba/frontend",
    "dev:backend": "turbo run dev --filter=@shiba/backend",
    "docs:build": "turbo run build --filter=@shiba/web",
    "docs:check": "pnpm -C apps/web check",
    "docs:dev": "pnpm -C apps/web dev",
    "docs:preview": "pnpm -C apps/web preview",
    "docs:verify": "node scripts/check-docs.mjs",
    "flags:doc": "node scripts/list-flags.mjs",
    "selfhost:smoke": "node scripts/self-hosting-smoke.mjs",
    "sdk:check-types": "pnpm -C packages/sdk check:types",
    "env:load": "varlock load",
    "env:scan": "varlock scan",
    "check": "biome check --formatter-enabled=false --assist-enabled=false .",
    "check:agent-context": "pnpm -C apps/backend exec vitest run test/agent-context-budget.test.ts",
    "check:ci": "pnpm check:agent-context && biome ci --formatter-enabled=false --assist-enabled=false . && pnpm check:knip && pnpm check:deps",
    "check:deps": "sherif -i tailwindcss",
    "check:knip": "node scripts/check-knip-baseline.mjs",
    "check:deploy": "node scripts/check-alchemy-drift.mjs && node scripts/check-dogfood-drift.mjs && node scripts/check-dogfood-image-pin.mjs && node scripts/check-env-types.mjs && node --experimental-strip-types --test scripts/deploy-config.test.mjs scripts/check-dogfood-drift.test.mjs",
    "check:dev-vars": "node scripts/check-dev-vars-example.mjs",
    "check:source-layout": "node scripts/source-layout.mjs --check",
    "format": "biome format --write .",
    "knip": "knip",
    "lint": "biome lint .",
    "lint:imports": "turbo run lint",
    "precommit": "biome check --write --formatter-enabled=false --assist-enabled=false . && pnpm check:knip",
    "bootstrap": "node scripts/setup.mjs",
    "shiba": "node scripts/shiba.mjs",
    "test": "node apps/backend/scripts/check-migrations.mjs && turbo run test --concurrency=2",
    "test:serial": "node apps/backend/scripts/check-migrations.mjs && turbo run test --concurrency=1",
    "test:personal-daemon": "node --test scripts/personal-cli-auth.test.mjs scripts/personal-daemon.test.mjs",
    "test:acceptance": "node apps/backend/test/acceptance/run.mjs",
    "test:built": "cd apps/backend && pnpm test test/marketing-pages.test.ts test/marketing-seo.test.ts",
    "test:ephemeral": "node scripts/ephemeral-stack.mjs --alchemy",
    "test:live": "pnpm -C apps/backend test:live",
    "typecheck": "turbo run typecheck && tsc -b && pnpm sdk:check-types",
    "verify-shiba:ci": "bash .cursor/skills/verify-shiba/scripts/run-ci.sh",
    "prepare:openconnector": "node infra/openconnector.mjs prepare",
    "provision:openconnector": "node infra/openconnector.mjs provision",
    "configure:openconnector": "node infra/openconnector.mjs configure",
    "apply-openconnector-d1": "node infra/openconnector.mjs apply-d1",
    "deploy:openconnector": "node infra/openconnector.mjs deploy",
    "secret:openconnector": "node infra/openconnector.mjs secret",
    "test:openconnector-deploy": "node --test infra/openconnector.test.mjs",
    "routes:generate": "node scripts/generate-routes.mjs",
    "routes:check": "node scripts/generate-routes.mjs --check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@effect/platform-bun": "4.0.0",
    "@effect/platform-node": "4.0.0",
    "@types/node": "^24.13.6",
    "@types/react": "catalog:",
    "alchemy": "2.0.0-beta.80",
    "effect": "4.0.0",
    "eslint": "^9.39.5",
    "knip": "6.37.0",
    "sherif": "1.13.0",
    "turbo": "2.10.13",
    "typescript": "catalog:",
    "typescript-eslint": "^8.73.0",
    "varlock": "1.20.0",
    "vite": "catalog:",
    "wrangler": "catalog:"
  },
  "bin": {
    "shiba": "./scripts/shiba.mjs"
  },
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.34.4",
  "homepage": "https://shiba-intern.pages.dev/",
  "pnpm": {
    "overrides": {
      "jiti": "2.7.0",
      "chat": "4.40.0",
      "@cloudflare/puppeteer>@puppeteer/browsers": "3.2.2",
      "http-cache-semantics": "4.3.0",
      "@modelcontextprotocol/server": "2.3.1",
      "@modelcontextprotocol/client": "2.3.1",
      "@modelcontextprotocol/sdk": "1.32.2",
      "hono": "^4.13.16",
      "@hono/node-server@1": "^1.19.18",
      "@modelcontextprotocol/sdk>@hono/node-server": "^2.1.6",
      "lodash": "^4.18.0",
      "valibot": "^1.4.2",
      "miniflare>undici": "7.30.2",
      "miniflare>sharp": "0.35.5",
      "@cloudflare/sandbox>zod": "4.6.6"
    }
  }
}
