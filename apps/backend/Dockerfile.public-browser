# syntax=docker/dockerfile:1.7
# Dedicated public-browser image: never the offline desktop or the coding-agent image.
FROM docker.io/library/debian:bookworm-slim@sha256:a3bba7dc7dbcc1f37c2856c51fc9a7fac96608f50cb87b1b4e4d8b8c85ae988e
COPY --from=docker.io/cloudflare/sandbox:1.0.1@sha256:e796e813de8213fb062bba279ddeddbf61277389a2cc7b3e4620075a9188843b /usr/local/bin/sandbox-shim /usr/local/bin/sandbox-shim

# The build-only CA is never copied into a layer; the interception CA is trusted at runtime.
RUN --mount=type=secret,id=proxy_ca,required=true,mode=0444 --mount=type=cache,target=/var/cache/apt,sharing=locked \
    rm -f /etc/apt/sources.list.d/debian.sources \
 && printf '%s\n' \
    'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/20261105T000000Z bookworm main' \
    'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian-security/20261105T000000Z bookworm-security main' > /etc/apt/sources.list \
 && apt-get -o Acquire::https::CaInfo=/run/secrets/proxy_ca -o Acquire::https::Timeout=20 -o Acquire::Retries=3 update \
 && apt-get -o Acquire::https::CaInfo=/run/secrets/proxy_ca -o Acquire::https::Timeout=20 -o Acquire::Retries=3 install -y --no-install-recommends \
    xvfb x11-utils openbox chromium chromium-sandbox xdotool scrot fonts-liberation libnss3-tools \
 && mkdir -p /usr/share/shiba-computer/licenses /etc/chromium/policies/managed \
 && dpkg-query -W -f='${Package}\t${Version}\n' > /usr/share/shiba-computer/packages.tsv
RUN set -eu; for p in xvfb xserver-common openbox chromium chromium-common chromium-sandbox xdotool libxdo3 scrot libnss3-tools; do \
    mkdir -p "/usr/share/shiba-computer/licenses/$p"; \
    cp "/usr/share/doc/$p/copyright" "/usr/share/shiba-computer/licenses/$p/copyright"; \
    done; rm -rf /var/lib/apt/lists/*; \
    useradd --create-home --uid 1001 browser; \
    command -v Xvfb openbox chromium xdotool scrot xdpyinfo certutil; \
    test -x /usr/local/bin/sandbox-shim
COPY public-browser/entrypoint.sh /usr/local/bin/shiba-browser-entrypoint
COPY public-browser/ready.sh /usr/local/bin/shiba-browser-ready
COPY public-browser/policy.json /etc/chromium/policies/managed/shiba.json
COPY computer/NOTICE computer/LICENSE-sandbox /usr/share/shiba-computer/licenses/cloudflare-sandbox/
RUN chmod 0555 /usr/local/bin/shiba-browser-entrypoint /usr/local/bin/shiba-browser-ready && chmod 0444 /etc/chromium/policies/managed/shiba.json
# No exposed ports, debugging listener, login profile, provider CLI or host mount.
USER browser
ENTRYPOINT ["/usr/local/bin/shiba-browser-entrypoint"]
