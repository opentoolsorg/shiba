# Optional outbound observability. Kept in the Worker, never the browser bundle.
# SHIBA_ERROR_REPORTING=none
# SENTRY_DSN=
# SHIBA_ANALYTICS=none
# POSTHOG_HOST=
# POSTHOG_API_KEY=
# SHIBA_OPEN_TELEMETRY=0
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=

# Copy to .dev.vars for local development. Never commit real credentials.
# Non-secret defaults are in wrangler.jsonc. Run:
#   node scripts/check-dev-vars-example.mjs
# to verify this file stays complete.

# --- GitHub (Worker-side only; never sent to containers) ---------------------

# Optional PR publishing and private clone via egress. Prefer a fine-grained PAT
# scoped to the target repo (Contents + Pull requests).
# GITHUB_TOKEN=

# Optional Projects v2 board sync: PAT with `project` scope + board number.
# GITHUB_PROJECT_TOKEN=
# GITHUB_PROJECT_NUMBER=

# Optional HMAC verification of acknowledgment-only GitHub webhooks.
# GITHUB_WEBHOOK_SECRET=

# Optional GitHub App (multi-repo). Worker mints installation tokens; never sent to containers.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_REPO_INSTALLATIONS={"owner/repo":12345678}

# Optional Linear agent sessions (mock locally with LINEAR_ALLOW_UNSIGNED_WEBHOOK=1).
# LINEAR_WEBHOOK_SECRET=
# LINEAR_API_KEY=
# LINEAR_DEFAULT_REPO_URL=https://github.com/owner/repo
# LINEAR_ALLOW_UNSIGNED_WEBHOOK=1

# Optional GitHub API origin (local verify-shiba mock boundary).
# GITHUB_API_BASE=

# --- Models (BYOK in AI Gateway; optional gateway auth secret) --------------

# AI Gateway uses the AI binding and GATEWAY_ID, not a container provider key.
# Optional: sent as cf-aig-authorization on gateway requests (src/egress.ts).
# Required when the gateway is auth-gated or has no BYOK key stored.
# AI_GATEWAY_TOKEN=

# --- Dashboard auth (loopback dev: leave Access/Better Auth unset) -----------

# Set to any value to enforce Cloudflare Access on /app and /api locally too.
# REQUIRE_ACCESS=

# Access application AUD tag — verified Cf-Access-Jwt-Assertion only.
# ACCESS_AUD=

# Built-in email+password dashboard login (>=32 chars). Unset = lane dark.
# BETTER_AUTH_SECRET=
# Optional social-login OAuth client secrets; configure matching client IDs separately.
# BETTER_AUTH_GOOGLE_CLIENT_SECRET=
# BETTER_AUTH_SLACK_CLIENT_SECRET=
# Public hosts refuse the first account until one of these is set.
# Loopback (wrangler dev) can sign up without them.
# BETTER_AUTH_BOOTSTRAP_TOKEN=
# BETTER_AUTH_OWNER_EMAIL=

# --- Shared / edge approvals -------------------------------------------------

# Comma-separated dashboard principals allowed to resolve shared approvals.
# DASHBOARD_APPROVERS=

# Worker-only internal signing root: use a random 32-byte hex value.
# INTERNAL_SIGNING_KEY=
# One-release legacy verification grace; set 0 after migration.
# SHIBA_LEGACY_SIGNING_FALLBACK=1
# ARTIFACT_SIGNING_KEY=

# Optional bearer token for POST /api/trigger (e.g. iPhone Apple Shortcuts).
# TRIGGER_TOKEN=

# Optional TypeSafe System One key for automation run_when (else Workers AI).
# TYPESAFE_API_KEY=

# --- Slack -------------------------------------------------------------------

# Optional Slack wiring. Empty SLACK_APPROVERS means nobody can approve from Slack.
# SLACK_SIGNING_SECRET=
# SLACK_APPROVERS=
# SLACK_BOT_TOKEN=
# Optional managed-installation encryption keyring; remains Worker-only.
# SLACK_INSTALLATION_KEYRING=
# Private coworker notices also require each native user's explicit target consent.
# SLACK_COWORKER_PRIVATE_STATUS_ENABLED=false
# JSON map {channelId: "https://github.com/owner/repo"} for bare @mentions.
# SLACK_CHANNEL_REPOS=

# --- Telegram ----------------------------------------------------------------

# TELEGRAM_APPROVERS empty means nobody can approve.
# TELEGRAM_BOT_TOKEN=
# Secret registered via Bot API setWebhook (X-Telegram-Bot-Api-Secret-Token).
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_APPROVERS=
# JSON map {chatId: "https://github.com/owner/repo"} for /shiba without a URL.
# TELEGRAM_CHAT_REPOS=
# Optional harness override, falls back to AGENT_HARNESS.
# TELEGRAM_AGENT_HARNESS=

# Email task intake. Empty EMAIL_TASK_SENDERS means email never queues work.
# EMAIL_TASK_SENDERS=alice@example.com,bob@example.com
# EMAIL_TASK_EMPLOYEES={"dev@your-company.example":"engineering"}
# JSON map {mailbox: "https://github.com/owner/repo"} for emailed tasks without a URL.
# EMAIL_TASK_REPOS=

# --- Discord -----------------------------------------------------------------

# DISCORD_APPROVERS empty means nobody can approve.
# DISCORD_PUBLIC_KEY=
# Worker-only bot token for the Gateway and Discord REST.
# DISCORD_BOT_TOKEN=
# Application ID for OAuth2 guild installation.
# DISCORD_CLIENT_ID=
# Worker-only Discord OAuth2 client secret.
# DISCORD_CLIENT_SECRET=
# Optional explicit same-origin callback URI.
# DISCORD_OAUTH_REDIRECT_URI=
# DISCORD_APPROVERS=
# JSON map {channelId: "https://github.com/owner/repo"} for commands without a repo.
# DISCORD_CHANNEL_REPOS=
# DISCORD_AGENT_HARNESS=

# --- Teams -------------------------------------------------------------------

# Register a single-tenant Azure Bot; enable the connection as the native workspace owner.
# TEAMS_APP_ID=
# TEAMS_APP_PASSWORD=
# TEAMS_APP_TENANT_ID=
# TEAMS_WORKSPACE_ID=
# Comma-separated Entra user object IDs; empty means nobody can approve.
# TEAMS_APPROVERS=
# JSON map {conversationId: "https://github.com/owner/repo"}.
# TEAMS_CHANNEL_REPOS=
# TEAMS_AGENT_HARNESS=

# --- Optional sandbox providers (@shiba/sandbox) -----------------------------

# E2B_API_KEY=

# --- Providers (per-user OAuth — opencodex-style local dev) ---------------

# Minted by `pnpm dev` / `pnpm shiba dev` — loopback OAuth POST to the Worker.
# SHIBA_DEV_OAUTH_LOOPBACK_SECRET=

# Required for Dashboard Providers sign-in (encrypts tokens in D1). 64 hex chars.
# MODEL_CREDENTIAL_KEY=
# Optional vault keyring JSON {"current":"k2","keys":{"k2":"<64 hex chars>"}} for key rotation.
# VAULT_KEYRING=
# Antigravity / Gemini card: Google OAuth client secret (Worker egress exchange).
# GOOGLE_ANTIGRAVITY_CLIENT_SECRET=

# --- Optional deployment-wide subscription secrets (not needed for Providers OAuth) ---

# Only when matching SHIBA_*_SUBSCRIPTION=1 in wrangler and you are not using
# per-user sign-in on the Providers card.
# CLAUDE_SUBSCRIPTION_TOKEN=
# CODEX_SUBSCRIPTION_AUTH_JSON=
# CURSOR_SUBSCRIPTION_TOKEN=
# SHIBA_SINGLE_USER=1

# --- Gmail read-only connection (optional) -----------------------------------

# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REDIRECT_URI=
# GMAIL_TOKEN_KEY=

# --- Shiba Desktop local runtime (uncomment for Remote Access + desktop pairing) ---
# Requires LocalDispatch binding (wrangler v9 migration). For wrangler dev without Docker:
#   wrangler dev --port 8788 --local-upstream localhost:8788 --enable-containers=false
# Access-fronted production: add Bypass for /api/local/* (see remote-access.md).

# SHIBA_LOCAL_RUNTIME=1
# LOCAL_ADAPTER_TOKEN=
# PAIRING_SECRET=

# Sole provider; local Worker uses the HTTP fallback without a sibling binding.
INTEGRATIONS_PROVIDER=openconnector
# OPEN_CONNECTOR_URL=
# OPEN_CONNECTOR_ADMIN_TOKEN=
# OPEN_CONNECTOR_RUNTIME_TOKEN=
# Separate scoped Worker-only key for the default-off audited read gateway.
# OPEN_CONNECTOR_READ_RUNTIME_TOKEN=
# Exact workspace/connection/operation runtime keys; JSON array, Worker-only.
# OPEN_CONNECTOR_SCOPED_READ_RUNTIME_TOKENS=
# Optional native restricted Stripe reads encryption key (64 hex, Worker-only).
# FOUNDER_STRIPE_CREDENTIAL_KEY=
# Workspace credit top-ups: a Stripe test-mode secret key and the webhook signing
# secret from `stripe listen --forward-to localhost:8788/api/billing/stripe/webhook`.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Optional native Meta reads encryption key (64 hex, Worker-only).
# FOUNDER_META_CREDENTIAL_KEY=
# Optional native HubSpot capture encryption key (64 hex, Worker-only).
# FOUNDER_HUBSPOT_CREDENTIAL_KEY=

# Optional owner-only metadata review. Never enables API-key actions.
# OPEN_CONNECTOR_OPERATOR_REVIEW_ENABLED=false

# Optional Google social-login client ID.
# BETTER_AUTH_GOOGLE_CLIENT_ID=

# Optional Slack social-login client ID.
# BETTER_AUTH_SLACK_CLIENT_ID=

# Optional Linear OAuth access token.
# LINEAR_OAUTH_ACCESS_TOKEN=

# Optional figma MCP OAuth client configuration.
# MCP_OAUTH_CLIENT_FIGMA=

# Optional jira_atlassian MCP OAuth client configuration.
# MCP_OAUTH_CLIENT_JIRA_ATLASSIAN=

# Optional notion MCP OAuth client configuration.
# MCP_OAUTH_CLIENT_NOTION=

# Optional posthog MCP OAuth client configuration.
# MCP_OAUTH_CLIENT_POSTHOG=

# Optional sentry MCP OAuth client configuration.
# MCP_OAUTH_CLIENT_SENTRY=

# Optional stripe MCP OAuth client configuration.
# MCP_OAUTH_CLIENT_STRIPE=

# Optional web search provider API key.
# WEB_SEARCH_API_KEY=
