{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["secrets"],
  "properties": {
    "description": { "type": "string" },
    "secrets": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
