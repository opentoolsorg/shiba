# syntax=docker/dockerfile:1.7
# Dedicated offline human desktop, never the coding-agent image.
# Official linux/amd64 Debian manifest verified through Registry v2, 2026-11-05.
FROM docker.io/library/debian:bookworm-slim@sha256:a3bba7dc7dbcc1f37c2856c51fc9a7fac96608f50cb87b1b4e4d8b8c85ae988e
COPY --from=docker.io/cloudflare/sandbox:1.0.1@sha256:e796e813de8213fb062bba279ddeddbf61277389a2cc7b3e4620075a9188843b /usr/local/bin/sandbox-shim /usr/local/bin/sandbox-shim

# Snapshot repositories freeze all direct/transitive package selections. The
# build-only CA is never copied into a layer; signatures and TLS stay enabled.
RUN --mount=type=secret,id=proxy_ca,required=true,mode=0444 --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=bind,source=computer/pinned-debs,target=/verified-debs,readonly \
    mkdir -p /var/cache/apt/archives \
 && rm -f /etc/apt/sources.list.d/debian.sources \
 && printf '%s\n' \
    'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/20261105T000000Z bookworm main' \
    'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian-security/20261105T000000Z bookworm-security main' > /etc/apt/sources.list \
 && apt-get -o Acquire::https::CaInfo=/run/secrets/proxy_ca -o Acquire::https::Timeout=20 -o Acquire::Retries=3 update \
 && for package in /verified-debs/*.deb; do [ ! -f "$package" ] || cp -- "$package" /var/cache/apt/archives/; done \
 && apt-get -o Acquire::https::CaInfo=/run/secrets/proxy_ca -o Acquire::https::Timeout=20 -o Acquire::Retries=3 install -y --no-install-recommends xvfb x11-utils openbox chromium xdotool scrot fonts-liberation \
 && mkdir -p /usr/share/shiba-computer/licenses \
 && dpkg-query -W -f='${Package}\t${Version}\n' > /usr/share/shiba-computer/packages.tsv
# Keep package-specific copyright paths (same basenames cannot be flattened).
RUN set -eu; for p in xvfb xserver-common openbox chromium chromium-common xdotool libxdo3 scrot; do \
    mkdir -p "/usr/share/shiba-computer/licenses/$p"; \
    cp "/usr/share/doc/$p/copyright" "/usr/share/shiba-computer/licenses/$p/copyright"; \
    done; rm -rf /var/lib/apt/lists/*; \
    useradd --create-home --uid 1000 desktop; \
    command -v Xvfb openbox chromium xdotool scrot xdpyinfo; \
    test -x /usr/local/bin/sandbox-shim
COPY computer/entrypoint.sh /usr/local/bin/shiba-computer-entrypoint
COPY computer/ready.sh /usr/local/bin/shiba-computer-ready
COPY computer/desktop.html /opt/shiba-computer/desktop.html
COPY computer/NOTICE computer/LICENSE-sandbox /usr/share/shiba-computer/licenses/cloudflare-sandbox/
RUN chmod 0555 /usr/local/bin/shiba-computer-entrypoint /usr/local/bin/shiba-computer-ready
# No exposed ports, login/account profile, provider CLI or host mount.
ENTRYPOINT ["/usr/local/bin/shiba-computer-entrypoint"]
