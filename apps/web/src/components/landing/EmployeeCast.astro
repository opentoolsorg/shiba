---
const roles = [
  { t: 'Marketing', kind: 'Built-in template', mascot: 'marketing', d: 'Turn a product brief into campaign drafts for your review.', a: 'Launch brief', b: 'Campaign copy' },
  { t: 'Sales', kind: 'Custom role example', mascot: 'sales', d: 'Prepare account research and outreach drafts from supplied context.', a: 'Account brief', b: 'Draft outreach' },
  { t: 'Research', kind: 'Built-in template', mascot: 'research', d: 'Answer a focused question with sources and gaps made clear.', a: 'Research report', b: 'Sources and open questions' },
  { t: 'Product', kind: 'Custom role example', mascot: 'product', d: 'Turn customer evidence into a product brief your team can discuss.', a: 'Product brief', b: 'Scope and acceptance checks' },
  { t: 'Design', kind: 'Custom role example', mascot: 'design', d: 'Map a user flow and draft interface copy before you build.', a: 'Design specification', b: 'States and accessibility checks' },
  { t: 'Engineering', kind: 'Built-in template', mascot: 'engineering', d: 'Make a focused code change and report the checks run.', a: 'Code changes and tests', b: 'Review handoff' },
  { t: 'QA & Testing', kind: 'Custom role example', mascot: 'qa', d: 'Check a feature and document what passed, failed, or needs another look.', a: 'Test report', b: 'Reproduction steps' },
  { t: 'Operations', kind: 'Built-in template', mascot: 'operations', d: 'Turn a recurring process into a checklist someone can follow.', a: 'Operating runbook', b: 'Readiness and recovery steps' },
  { t: 'Your custom role', kind: 'Custom role', mascot: 'custom', d: 'Give an employee instructions for the work your team repeats.', a: 'Your working brief', b: 'The files you need' },
];
---

<section id="employees" class="lp-section lp-cast" aria-labelledby="employees-title">
  <div class="lp-shell">
    <div class="lp-cast-board" data-motion="reveal">
      <div class="lp-cast-head">
        <h2 id="employees-title" class="lp-h2">Choose a role. Start with one task.</h2>
        <p class="lp-cast-side">
          One role, one brief, one thread. Engineering, Marketing, Research and Operations are built-in templates;
          the others are custom-role examples you can write yourself.
        </p>
      </div>

      <ul class="lp-cast-grid">
        {
          roles.map((e) => (
            <li class="lp-agent">
              <img class="lp-agent-avatar" src={`/landing/mascots/${e.mascot}.svg`} alt="" width="48" height="58" loading="lazy" decoding="async" />
              <div class="lp-agent-body">
                <h3>{e.t} <span class="lp-template-label">{e.kind}</span></h3>
                <p>{e.d}</p>
                <p class="lp-deliverables"><span class="visually-hidden">Example outputs: </span>{e.a} · {e.b}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <p class="lp-cast-notes">
      Roles use information you supply to prepare drafts. A role alone does not connect accounts, make payments,
      update external services, or grant permission to publish.
    </p>
  </div>
</section>

<style>
  .lp-cast-board {
    padding: clamp(24px, 4vw, 48px);
    border: 2px solid var(--lp-ink);
    background-color: var(--lp-raised);
    box-shadow: 3px 3px 0 var(--paper-shadow);
  }

  .lp-cast-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 32px;
    margin-bottom: 32px;
  }

  .lp-cast-side {
    max-width: 420px;
    margin: 0;
    color: var(--lp-ink2);
    font-size: 15px;
  }

  .lp-cast-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 4px 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lp-agent {
    display: flex;
    gap: 14px;
    min-width: 0;
    padding: 18px 0;
    border-top: 1px solid var(--lp-line);
  }

  .lp-agent-avatar {
    flex: none;
    width: 52px;
    height: 48px;
    object-fit: contain;
  }

  .lp-agent-body { min-width: 0; }

  .lp-agent h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
    margin: 0 0 4px;
    color: var(--lp-ink);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .lp-template-label {
    padding: 1px 6px;
    border: 1px solid var(--lp-line2);
    color: var(--lp-ink2);
    font: 500 10px/1.5 var(--lp-font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .lp-agent p {
    margin: 0;
    color: var(--lp-ink2);
    font-size: 14px;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .lp-agent .lp-deliverables {
    margin-top: 6px;
    color: var(--lp-ink);
    font: 500 12px/1.5 var(--lp-font-mono);
    overflow-wrap: anywhere;
  }

  .lp-cast-notes {
    max-width: 760px;
    margin: 28px 0 0;
    color: var(--lp-ink2);
    font: 400 12px/1.6 var(--lp-font-mono);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 1100px) {
    .lp-cast-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 640px) {
    .lp-cast-grid { grid-template-columns: 1fr; }
  }
</style>
