---
import IntegrationLogos from '../IntegrationLogos.astro';
import { plannedCategoryCounts, plannedTools } from '../../data/planned-integrations';

const total = plannedTools.length;
---

<section id="directory" class="planned-catalog" aria-labelledby="planned-title" data-planned-catalog>
  <div class="catalog-shell">
    <div class="head">
      <div>
        <p class="catalog-eyebrow">Looking ahead</p>
        <h2 id="planned-title">More of your tools.<br />On the roadmap.</h2>
      </div>
      <p class="side">A future catalog for the places your team already works.</p>
    </div>
    <p class="intro">
      <strong>All {total} tools below are planned.</strong> They are not available integrations or connected accounts.
      This future roadmap is not a delivery commitment. Any future workflow still needs your configuration, verification,
      and explicit approval.
    </p>

    <div class="toolbar">
      <p class="kicker">Explore the planned catalog</p>
      <div class="search">
        <label class="search-label" for="planned-search">Search planned tools</label>
        <div class="search-row">
          <input
            class="search-input"
            id="planned-search"
            type="search"
            placeholder="Search planned tools…"
            aria-controls="planned-results"
            autocomplete="off"
            data-planned-query
          />
          <button class="ctl" type="button" aria-label="Clear planned tool search" data-planned-clear>Clear</button>
          <button class="ctl" type="button" aria-label="Reset planned search and category" data-planned-reset>Reset</button>
        </div>
      </div>
    </div>

    <div class="filters" role="group" aria-label="Filter planned tools by category">
      {
        plannedCategoryCounts.map(({ name, count }) => (
          <button class="filter" type="button" aria-pressed={name === 'All' ? 'true' : 'false'} data-planned-category={name}>
            {name} <span class="filter-count">{count}</span>
          </button>
        ))
      }
    </div>

    <p class="results" role="status" aria-live="polite" aria-atomic="true" data-planned-status>
      {total} of {total} planned tools · All
    </p>

    <div id="planned-results">
      <div class="grid">
        {
          plannedTools.map((tool) => (
            <article class="tool-card" data-planned-tool={tool.name}>
              <div class="logo">
                <IntegrationLogos providerKey={tool.name} />
              </div>
              <div class="card-copy">
                <h3>{tool.name}</h3>
                <span class="planned-status">Planned</span>
              </div>
            </article>
          ))
        }
      </div>
      <div class="empty" hidden data-planned-empty>
        <h3>No planned tools found</h3>
        <p data-planned-empty-copy></p>
        <button type="button" data-planned-reset>Reset planned search and filters</button>
      </div>
    </div>
  </div>
</section>

<script>
  import { filterPlanned, plannedTools } from '../../data/planned-integrations';

  const root = document.querySelector<HTMLElement>('[data-planned-catalog]');
  if (root) {
    const input = root.querySelector<HTMLInputElement>('[data-planned-query]')!;
    const status = root.querySelector<HTMLElement>('[data-planned-status]')!;
    const empty = root.querySelector<HTMLElement>('[data-planned-empty]')!;
    const emptyCopy = root.querySelector<HTMLElement>('[data-planned-empty-copy]')!;
    const pills = [...root.querySelectorAll<HTMLButtonElement>('[data-planned-category]')];
    const cards = [...root.querySelectorAll<HTMLElement>('[data-planned-tool]')];
    let category = 'All';

    const render = () => {
      const query = input.value.trim();
      const visible = new Set(filterPlanned(plannedTools, { query, category }).map((t) => t.name));
      for (const card of cards) card.hidden = !visible.has(card.dataset.plannedTool ?? '');
      for (const pill of pills) pill.setAttribute('aria-pressed', String(pill.dataset.plannedCategory === category));
      status.textContent = `${visible.size} of ${plannedTools.length} planned tools · ${category}${query ? ` · Search: ${query}` : ''}`;
      empty.hidden = visible.size > 0;
      emptyCopy.textContent = filterPlanned(plannedTools, { category }).length
        ? 'Try another name or reset the planned catalog filters.'
        : `No tools are listed in ${category} yet. Browse all planned tools or choose another category.`;
    };

    input.addEventListener('input', render);
    for (const pill of pills) {
      pill.addEventListener('click', () => {
        category = pill.dataset.plannedCategory ?? 'All';
        render();
      });
    }
    root.querySelector('[data-planned-clear]')!.addEventListener('click', () => {
      input.value = '';
      render();
      input.focus();
    });
    for (const btn of root.querySelectorAll('[data-planned-reset]')) {
      btn.addEventListener('click', () => {
        input.value = '';
        category = 'All';
        render();
        input.focus();
      });
    }
    // Browsers may restore a typed query on back/forward navigation.
    if (input.value) render();
  }
</script>

<style>
  .planned-catalog {
    /* Clears the sticky site header when jumping to #directory. */
    scroll-margin-top: 96px;
    background: var(--lp-paper);
    color: var(--lp-ink);
    border-bottom: 1px solid var(--lp-line);
  }
  .catalog-shell {
    max-width: calc(1312px + 2 * var(--lp-gutter));
    margin-inline: auto;
    padding: 80px max(var(--lp-gutter), env(safe-area-inset-right, 0px)) 80px max(var(--lp-gutter), env(safe-area-inset-left, 0px));
  }
  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    margin-bottom: 24px;
  }
  .catalog-eyebrow,
  .kicker,
  .search-label,
  .results,
  .planned-status {
    font-family: 'Geist Mono', ui-monospace, monospace;
  }
  .catalog-eyebrow {
    margin: 0 0 16px;
    font-size: 11px;
    font-weight: 500;
    color: var(--lp-accent);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  h2 {
    margin: 0;
    max-width: 720px;
    font-size: 44px;
    line-height: 1.08;
    letter-spacing: -0.04em;
    font-weight: 600;
    text-wrap: balance;
  }
  .side {
    max-width: 390px;
    margin: 0;
    color: var(--lp-ink2);
    font-size: 15px;
  }
  .intro {
    max-width: 760px;
    margin: 0 0 32px;
    color: var(--lp-ink2);
    font-size: 15px;
    line-height: 1.6;
  }
  .intro strong {
    color: var(--lp-ink);
  }
  .toolbar {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 24px;
  }
  .kicker {
    margin: 0;
    font-size: 11px;
    font-weight: 500;
    color: var(--lp-ink2);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .search {
    width: 420px;
    max-width: 100%;
  }
  .search-label {
    display: block;
    margin-bottom: 10px;
    font-size: 12px;
    font-weight: 500;
  }
  .search-row {
    display: flex;
    gap: 12px;
    align-items: stretch;
  }
  .search-input {
    flex: 1;
    width: 100%;
    min-width: 0;
    min-height: 50px;
    padding: 12px 16px;
    background: var(--lp-raised);
    color: var(--lp-ink);
    border: 1px solid var(--lp-line2);
    border-radius: 14px;
    font: inherit;
    font-size: 14px;
  }
  .search-input::placeholder {
    color: var(--lp-ink2);
    opacity: 1;
  }
  .ctl {
    flex: none;
    min-width: 78px;
    min-height: 50px;
    border: 1px solid var(--lp-line2);
    border-radius: 14px;
    background: var(--lp-raised);
    color: var(--lp-ink);
    font: 500 12px/1.5 'Geist Mono', ui-monospace, monospace;
    cursor: pointer;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 30px;
  }
  .filter {
    min-height: 46px;
    padding: 10px 18px;
    border: 1px solid var(--lp-line);
    border-radius: 999px;
    background: var(--lp-raised);
    color: var(--lp-ink);
    font-family: inherit;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.4;
    cursor: pointer;
  }
  .filter-count {
    margin-left: 5px;
    opacity: 0.7;
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }
  .filter[aria-pressed='true'] {
    background: var(--lp-ink);
    color: var(--lp-paper);
    border-color: var(--lp-ink);
  }
  .results {
    margin: 0 0 24px;
    font-size: 12px;
    color: var(--lp-ink2);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }
  .tool-card {
    display: flex;
    align-items: center;
    gap: 16px;
    min-width: 0;
    min-height: 122px;
    padding: 22px 20px;
    border-radius: 28px;
    background: var(--lp-raised);
    border: 1px solid var(--lp-line);
  }
  .tool-card[hidden] {
    display: none;
  }
  .logo {
    flex: none;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    padding: 8px;
    border-radius: 18px;
    background: var(--lp-logowell, #faf5f1);
  }
  .card-copy {
    min-width: 0;
  }
  .tool-card h3 {
    margin: 0 0 8px;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.025em;
    overflow-wrap: anywhere;
  }
  .planned-status {
    display: inline-flex;
    align-items: center;
    padding: 3px 8px;
    border: 1px solid var(--lp-line2);
    border-radius: 999px;
    font-size: 11px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--lp-ink2);
  }
  .empty {
    padding: 48px 24px;
    border: 1px dashed var(--lp-line2);
    border-radius: 28px;
    text-align: center;
    background: var(--lp-raised);
  }
  .empty[hidden] {
    display: none;
  }
  .empty h3 {
    margin: 0 0 10px;
    font-size: 22px;
    font-weight: 600;
    line-height: 1.3;
  }
  .empty p {
    margin: 0 0 20px;
    font-size: 14px;
    color: var(--lp-ink2);
  }
  .empty button {
    min-height: 44px;
    padding: 10px 18px;
    border: 1px solid var(--lp-line2);
    border-radius: 999px;
    background: var(--lp-paper);
    color: var(--lp-ink);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }
  .ctl:focus-visible,
  .filter:focus-visible,
  .empty button:focus-visible,
  .search-input:focus-visible {
    outline: 2px solid var(--lp-accent);
    outline-offset: 2px;
  }
  @media (max-width: 1100px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 700px) {
    .catalog-shell {
      padding-block: 56px;
    }
    h2 {
      font-size: 36px;
    }
    .head,
    .toolbar {
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
    }
    .search {
      width: 100%;
    }
    .filters {
      gap: 8px;
    }
    .filter {
      font-size: 12px;
      padding-inline: 14px;
    }
    .tool-card {
      padding: 20px;
      gap: 14px;
    }
  }
  @media (max-width: 480px) {
    .search-row {
      gap: 8px;
    }
    .search-input {
      padding-inline: 14px;
    }
    .ctl {
      min-width: 54px;
    }
    .grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .tool-card {
      min-height: 112px;
    }
    .tool-card h3 {
      font-size: 17px;
    }
  }
</style>
