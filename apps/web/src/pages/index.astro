          panel.hidden = !active;
          panel.classList.toggle('is-active', active);
        });
        var section = group.closest('section');
        if (section) section.querySelectorAll('[data-compare-mascot]').forEach(function(mascot) {
          mascot.hidden = mascot.getAttribute('data-compare-mascot') !== button.getAttribute('data-delivers-tab');
        });
      }
      buttons.forEach(function(button, index) {
        button.addEventListener('click', function() { select(button); });
        button.addEventListener('keydown', function(event) {
          var next = event.key === 'ArrowRight' ? (index + 1) % buttons.length : event.key === 'ArrowLeft' ? (index + buttons.length - 1) % buttons.length : event.key === 'Home' ? 0 : event.key === 'End' ? buttons.length - 1 : -1;
          if (next < 0) return;
          event.preventDefault();
          buttons[next].focus();
          select(buttons[next]);
