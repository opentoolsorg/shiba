---
import AgentCast from '../components/AgentCast.astro';
import MarketingPage from '../layouts/MarketingPage.astro';
import ShibaMascot from '../components/ShibaMascot.astro';

const title = 'Shiba — AI Employees for the Work Behind Your Company';
const description = 'AI employees for the work behind your company: code, design, marketing, sales, operations, finance, and revenue. Describe a task, approve the work, and review the result.';

const faqItems = [
  {"q": "What is Shiba?", "a": "Shiba is an open-source workspace for AI employees. Give an employee a task and the context it needs, review the proposed work, and inspect the files or changes it returns."},
  {"q": "What kind of work can I give it?", "a": "Draft campaign copy, research an account using supplied context, outline a design, fix a bug, prepare an operating checklist, or organize supplied figures into a draft budget or pipeline summary. Set clear instructions and review the result before using it."},
  {"q": "Do I need a repository for non-coding tasks?", "a": "Yes. Every task currently needs a GitHub repository, including non-code work. It gives Shiba context and a place to return draft files. The task does not have to change code."},
  {"q": "What happens before I approve?", "a": "Shiba may use a model to draft a plan. For normal runs, no sandbox starts until you approve the exact task. Reject it and nothing runs."},
  {"q": "Where does my information go?", "a": "Your installation stores Shiba data in your Cloudflare account. Your AI provider receives the context sent with each request. Check access before sharing confidential data."},
  {"q": "Which agents and connections are supported?", "a": "OpenCode, Claude Code, Codex, and other adapters are available when configured. Each integration needs setup; listed support does not mean a live task is verified."},
  {"q": "What does Shiba cost?", "a": "Shiba software is free under AGPL-3.0-only. You pay your Cloudflare and model providers; costs vary by usage. See the cost guide."},
  {"q": "Is Shiba production-ready?", "a": "Shiba is an early prototype. Tests cover core workflows, but no live cloud task with a model and GitHub has been verified. Try a non-critical repo."},
  {"q": "How do I get started?", "a": "Follow the self-hosting guide to configure Cloudflare and a model provider. Then run a small task in a test repository."}
];

const schema = [
  { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Shiba', url: 'https://tryshiba.dev/', description, applicationCategory: 'BusinessApplication', operatingSystem: 'Web, Cloudflare Workers', license: 'https://spdx.org/licenses/AGPL-3.0-only.html', sameAs: 'https://github.com/princepal9120/shiba', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, featureList: ['AI employees for company work', 'Approval-gated sandbox execution', 'Reviewable draft files and diffs', 'Connected repository required for execution', 'Configurable agents and model connections'] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqItems.map(item => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) },
];

const worksWith = [
  { name: 'OpenCode', icon: '/assets/harnesses/opencode.svg' },
  { name: 'Claude Code', icon: '/assets/harnesses/claude.svg' },
  { name: 'Codex', icon: '/assets/harnesses/openai.svg' },
  { name: 'Grok', icon: '/assets/harnesses/grok.svg' },
  { name: 'Cursor', icon: '/assets/harnesses/cursor.svg' },
  { name: 'Slack', icon: '/assets/channels/slack.svg' },
  { name: 'Telegram', icon: '/assets/channels/telegram.svg' },
  { name: 'Discord', icon: '/assets/channels/discord.svg' },
  { name: 'Linear', icon: '/assets/channels/linear.svg' },
  { name: 'GitHub', icon: '/assets/channels/github.svg' },
];

const chatbotComparisons = [
  {
    id: 'marketing',
    role: 'Marketing',
    botReply: "Here's a 7-step marketing strategy: 1. Identify target personas. 2. Draft value proposition. 3. Publish blog posts. 4. Run paid ads. 5. Measure KPIs. Would you like me to elaborate on step 1?",
    shibaAction: {
      branch: 'task/launch-brief',
      files: ['marketing/brief.md', 'marketing/campaign.md'],
      status: 'Ready for your approval',
      summary: 'Drafted campaign brief and announcement copy into repository. Waits for your review before merging.'
    }
  },
  {
    id: 'coding',
    role: 'Coding',
    botReply: "You could fix this by checking if the session exists: `if (!session) return false;`. Paste this into your auth handler and restart your server to see if it resolves the issue.",
    shibaAction: {
      branch: 'task/checkout-fix',
      files: ['src/auth/session.ts', 'test/auth-session.test.ts'],
      status: 'Tests passing · Ready for review',
      summary: 'Reproduced bug in isolated sandbox, wrote regression test, applied fix, verified build cleanly.'
    }
  },
  {
    id: 'design',
    role: 'Design',
    botReply: "I suggest a clean mobile navigation with high contrast, a sticky header, and 44px touch targets. Be sure to test keyboard focus indicators and ARIA roles for screen readers.",
    shibaAction: {
      branch: 'task/mobile-nav-spec',
      files: ['design/spec.md', 'design/review-checklist.md'],
      status: 'Specification drafted',
      summary: 'Outlined full mobile navigation flow, state transitions, keyboard shortcuts, and WCAG checklist.'
    }
  },
  {
    id: 'qa',
    role: 'QA',
    botReply: "Common sign-in edge cases include expired tokens, network dropouts, rate limiting, and SQL injection in input fields. Remember to write tests for each of these scenarios.",
    shibaAction: {
      branch: 'task/auth-qa-run',
      files: ['qa/report.md', 'qa/reproduction-log.txt'],
      status: 'Check completed in sandbox',
      summary: 'Executed sign-in checks in container, captured exact HTTP responses, and logged reproduction steps.'
    }
  }
];

chatbotComparisons.push(
  { id: 'sales', role: 'Sales', botReply: 'Start by researching the account, then personalize the outreach: mention a recent trigger, keep it under 120 words, and follow up in three days.', shibaAction: { branch: 'task/account-outreach', files: ['sales/account-brief.md', 'sales/draft-outreach.md'], status: 'Drafts ready for review', summary: 'Prepared an account brief and outreach drafts from the context you supplied. Nothing is sent until you approve.' } },
  { id: 'research', role: 'Research', botReply: 'There are several approaches worth considering. Look at recent papers, vendor docs and community threads, then compare the tradeoffs yourself.', shibaAction: { branch: 'task/market-question', files: ['research/report.md', 'research/sources.md'], status: 'Report drafted', summary: 'Answered the focused question with sources, and listed open questions and gaps in the evidence.' } },
  { id: 'product', role: 'Product', botReply: 'A good product brief covers the problem, the audience, the scope and the success metrics. You should interview customers and write it up.', shibaAction: { branch: 'task/onboarding-brief', files: ['product/brief.md', 'product/acceptance-checks.md'], status: 'Brief drafted', summary: 'Turned customer evidence into a product brief with scope and acceptance checks your team can discuss.' } },
  { id: 'operations', role: 'Operations', botReply: 'Document the process, assign owners, define escalation paths, and review the checklist every quarter to keep it current.', shibaAction: { branch: 'task/release-runbook', files: ['ops/runbook.md', 'ops/recovery-steps.md'], status: 'Runbook drafted', summary: 'Turned a recurring process into a runbook with readiness and recovery steps someone can follow.' } },
);

// Header mascot follows the selected role tab; QA reuses the engineering character.
const compareMascot: Record<string, { character: 'marketing' | 'engineering' | 'design' | 'sales' | 'research' | 'product' | 'operations'; state: 'idle' | 'thinking' | 'waiting-approval' | 'working' | 'done' }> = {
  marketing: { character: 'marketing', state: 'done' },
  coding: { character: 'engineering', state: 'working' },
  design: { character: 'design', state: 'thinking' },
  qa: { character: 'engineering', state: 'thinking' },
  sales: { character: 'sales', state: 'done' },
  research: { character: 'research', state: 'thinking' },
  product: { character: 'product', state: 'idle' },
  operations: { character: 'operations', state: 'waiting-approval' },
};

const controls = [
  { title: 'Your Cloudflare account', text: 'Runs on Workers and Containers in your cloud infrastructure. Stored data stays yours.' },
  { title: 'Sandbox per task', text: 'Each task executes in an ephemeral container with strict memory and CPU limits.' },
  { title: 'Repository required', text: 'Non-coding and coding tasks operate inside a designated GitHub repository.' },
  { title: 'Deployment-owned credentials', text: 'Model keys stay inside Cloudflare AI Gateway; containers never receive raw secrets.' },
  { title: 'Reviewable diffs', text: 'Inspect line-by-line diffs, generated drafts, and test logs before accepting work.' }
];

const steps = [
  { num: '01', title: 'Self host in your account', text: 'Deploy to Cloudflare Workers with Docker sandbox container in minutes.' },
  { num: '02', title: 'Connect a repository', text: 'Select a GitHub repo to give your AI employees context and output files.' },
  { num: '03', title: 'Assign your first task', text: 'Describe the work, review the proposed plan, and approve the run.' }
];
---
<MarketingPage title={title} description={description} path="/" schema={schema}>
  <div class="landing">
    <!-- Section 1: Hero + Product Window + Works With chips -->
    <section class="home-hero" aria-labelledby="home-title">
      <div class="hero-header-stack">
        <div class="hero-mascot" aria-hidden="true">
          <ShibaMascot character="shiba" state="waiting-approval" size={112} />
        </div>
        <span class="eyebrow-chip">Open source · Self-hosted</span>
        <h1 id="home-title" class="hero-title">
          AI employees for{' '}
          <span class="title-accent">the work behind your company.</span>
        </h1>
        <p class="hero-subhead">
          From code and design to marketing, sales, operations, finance, and revenue work. Give Shiba a task, review the plan, and keep the final decision.
        </p>
        <div class="hero-actions">
          <a class="cta cta-primary" href="/docs/self-hosting/">Self host Shiba</a>
        </div>
        <div class="hero-disclosures">
          <p class="hero-note">Open source · AGPL-3.0-only · Your infrastructure</p>
          <p class="hero-note">Free software to self-host. Hosting and model usage cost extra.</p>
        </div>

        <!-- Static "Works with" chip row -->
        <div class="works-with-band" aria-label="Compatible tools and harnesses">
          <span class="works-label">Works with:</span>
          <div class="works-chips">
            {worksWith.map(tool => (
              <div class="works-chip">
                <img src={tool.icon} alt="" width="16" height="16" class="chip-icon" loading="lazy" decoding="async" />
                <span>{tool.name}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Real workspace with an illustrative approval request. -->
      <div id="dashboard" class="hero-product-frame">
        <div class="workspace-window">
          <div class="workspace-titlebar"><img src="/assets/mascot/pet-logo.png" alt="" width="24" height="24" /><span>shiba.workspace</span><span class="window-status">Example workspace</span></div>
          <picture>
            <source data-theme-source srcset="/assets/dashboard/agents-dark.png" media="(prefers-color-scheme: dark)" />
            <img class="workspace-screenshot" src="/assets/dashboard/agents-light.png" width="1280" height="844" fetchpriority="high" alt="Shiba workspace showing AI employee role templates and the Agents dashboard." />
          </picture>
        </div>
      </div>
    </section>

    <!-- Section 5: A chatbot suggests. Shiba delivers. -->
    <section class="home-section delivers-section" data-reveal aria-labelledby="delivers-title">
      <div class="section-head">
        <div class="delivers-mascot">
          {chatbotComparisons.map((c, i) => (
            <span data-compare-mascot={c.id} hidden={i !== 0}>
              <ShibaMascot character={compareMascot[c.id].character} state={compareMascot[c.id].state} size={112} />
            </span>
          ))}
        </div>
        <p class="eyebrow">Practical outcomes</p>
        <h2 id="delivers-title">A chatbot suggests.<br />Shiba delivers.</h2>
        <p class="section-lead">Examples of files Shiba can prepare. These are illustrative, not customer results or a live run.</p>
      </div>

      <div class="delivers-widget" data-tab-group>
        <div class="delivers-tabs" aria-label="Select comparison role">
          {chatbotComparisons.map((c, i) => (
            <button
              type="button"
              class:list={['delivers-tab-btn', { 'is-active': i === 0 }]}
              data-delivers-tab={c.id}
              data-panel-target={`compare-${c.id}`}
              aria-controls={`compare-${c.id}`}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {c.role}
            </button>
          ))}
        </div>

        <div class="delivers-panels">
          {chatbotComparisons.map((c, i) => (
            <div class:list={['delivers-panel', { 'is-active': i === 0 }]} data-delivers-panel={c.id} data-tab-panel id={`compare-${c.id}`}>
              <div class="compare-col chatbot-col">
                <div class="compare-badge">Standard chatbot</div>
                <h3>Suggests theory</h3>
                <div class="chat-bubble">
                  <p>{c.botReply}</p>
                </div>
                <span class="compare-result fail"><span aria-hidden="true">✕</span> Result: You do all the actual work</span>
              </div>

              <div class="compare-col shiba-col">
                <div class="compare-badge shiba-badge">Shiba AI employee</div>
                <h3>Prepares the deliverable</h3>
                <div class="shiba-deliverable-card">
                  <div class="deliv-meta">
                    <span class="deliv-branch"><span aria-hidden="true">⎇</span> <code>{c.shibaAction.branch}</code></span>
                    <span class="deliv-status">{c.shibaAction.status}</span>
                  </div>
                  <ul class="deliv-files">
                    {c.shibaAction.files.map(f => (
                      <li class="deliv-file-pill"><svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6" /></svg><code>{f}</code></li>
                    ))}
                  </ul>
                  <p class="deliv-desc">{c.shibaAction.summary}</p>
                  <ol class="deliv-steps" aria-label="Progress">
                    <li class="is-done">Plan</li>
                    <li class="is-done">Draft</li>
                    <li>Your review</li>
                  </ol>
                </div>
                <span class="compare-result ok"><span aria-hidden="true">✓</span> Result: You review, approve, and merge</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Section 6: #employees roster (AgentCast) -->
    <section id="employees" class="home-section employees-section" data-reveal aria-labelledby="employees-title">
      <div class="section-head">
        <p class="eyebrow">Nine dedicated roles</p>
        <h2 id="employees-title">AI employees for<br />every company department.</h2>
        <p class="section-lead">Give each employee clear instructions and the files you want back. Four built-in templates, plus your own custom roles.</p>
      </div>
      <AgentCast />
    </section>

    <!-- Section 7: #trust Tagline Reveal -->
    <section id="trust" class="home-section trust-section" aria-labelledby="trust-title">
      <div class="trust-layout" data-reveal>
        <div class="trust-copy">
          <p class="eyebrow">Permission is the point.</p>
          <h2 id="trust-title" class="tagline-reveal" aria-label="Capable by design. Never in charge.">
            <span class="tagline-line"><span class="tagline-word" data-tagline-word>Capable</span> <span class="tagline-word" data-tagline-word>by</span> <span class="tagline-word" data-tagline-word>design.</span></span>
            <span class="tagline-line"><span class="tagline-word" data-tagline-word>Never</span> <span class="tagline-word" data-tagline-word>in</span> <span class="tagline-word" data-tagline-word>charge.</span></span>
          </h2>
          <p class="section-lead">See the proposed task before it runs. Approve the exact request, reject it, or change direction. Unattended automations require explicit, scoped permission.</p>
          <a class="text-link" href="/docs/approval-gates/">Inside the approval gate <span aria-hidden="true">→</span></a>
          <div class="trust-details">
            <div>
              <h3>Keep the work yours.</h3>
              <p>Host Shiba in your own account and choose the connections it uses. Your model provider still receives the context sent with its requests.</p>
            </div>
            <div>
              <h3>Review before you rely on it.</h3>
              <p>Read the returned work and checks, then decide what to keep. Teams evaluating Shiba can start with the <a class="text-link" href="/docs/readiness/">readiness guide</a>.</p>
            </div>
          </div>
        </div>
        <div class="permission-visual" aria-label="Example of the approval boundary">
          <div class="permission-mascot"><ShibaMascot character="shiba" state="waiting-approval" size={132} /></div>
          <div class="permission-top">
            <span class="permission-icon" aria-hidden="true">◇</span>
            <span>Example approval</span>
            <span class="permission-status">Waiting for you</span>
          </div>
          <div class="permission-plan">
            <span class="small-label">Proposed task</span>
            <strong>Prepare a draft budget from supplied figures</strong>
            <div class="permission-data">
              <span>Repository</span><code>example/team-workspace</code>
              <span>Branch</span><code>task/draft-budget</code>
            </div>
          </div>
          <div class="gate-line"><span></span><b>Human approval required</b><span></span></div>
          <div class="permission-bottom">
            <span class="lock-symbol" aria-hidden="true">⌑</span>
            <div>
              <strong>Sandbox not started</strong>
              <p>Review the request before work begins.</p>
            </div>
            <span class="quiet-dot" aria-hidden="true"></span>
          </div>
          <p class="visual-caption">Illustrative boundary, not a live run. Planning may call a model before approval.</p>
        </div>
      </div>
    </section>

    <!-- Section 8: Autonomous, not unsupervised -->
    <section class="home-section controls-section" data-reveal aria-labelledby="controls-title">
      <div class="section-head">
        <ShibaMascot character="operations" state="waiting-approval" size={120} />
        <p class="eyebrow">Governance &amp; safety</p>
        <h2 id="controls-title">Autonomous,<br />not unsupervised.</h2>
        <p class="section-lead">Real guardrails built into the architectural foundation. No hidden external calls or unvetted merges.</p>
      </div>

      <dl class="controls-list">
        {controls.map(item => (
          <div class="control-row">
            <dt>{item.title}</dt>
            <dd>{item.text}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- Section 9: #how-it-works -->
    <section id="how-it-works" class="home-section steps-section" data-reveal aria-labelledby="steps-title">
      <div class="section-head">
        <ShibaMascot character="engineering" state="working" size={112} />
        <p class="eyebrow">A task. A plan. A result to review.</p>
        <h2 id="steps-title">From “what if”<br />to ready for review.</h2>
        <p class="section-lead">Start with a piece of work you can describe. Shiba helps turn it into files and changes your team can review.</p>
      </div>

      <div class="steps-container">
        <div class="steps-grid">
          {steps.map(step => (
            <article class="step-card" id={`setup-${step.num}`}>
              <span class="step-number" aria-hidden="true">{step.num}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </article>
          ))}
        </div>

        <!-- Terminal tile with real command from docs -->
        <div class="terminal-tile" aria-label="Terminal installation command">
          <div class="terminal-bar">
            <span class="term-dots"><span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span></span>
            <span class="term-title">bash — shiba local setup</span>
          </div>
          <pre class="terminal-body"><code><span class="term-prompt">$</span> git clone https://github.com/princepal9120/shiba.git
<span class="term-prompt">$</span> cd shiba &amp;&amp; pnpm install
<span class="term-prompt">$</span> pnpm shiba dev
<span class="term-dim">› worker listening at http://127.0.0.1:8787</span>
<span class="term-dim">› sandbox container image built: standard-4</span>
<span class="term-ok">✓ ready for task assignment</span></code></pre>
        </div>
      </div>
    </section>

    <!-- Section 10: #proof -->
    <section id="proof" class="home-section proof-section" data-reveal aria-labelledby="proof-title">
      <div class="proof-layout">
        <div class="section-head">
          <ShibaMascot character="research" state="thinking" size={112} />
          <p class="eyebrow">Know what you’re trying.</p>
          <h2 id="proof-title">Start small.<br />Check the result.</h2>
        <p class="section-lead">Shiba is an early prototype. Explore the source and the verification notes before giving it work your company depends on.</p>
          <a class="text-link" href="/docs/readiness/">Read the readiness notes <span aria-hidden="true">→</span></a>
        </div>
        <div class="readiness-list">
          <article class="proof-card">
            <span class="readiness-marker" aria-hidden="true">↗</span>
            <div>
              <h3>Yours to inspect.</h3>
              <p>The source is public under AGPL-3.0-only. Read how work is planned, approved, and returned before running it in your own account.</p>
              <a class="text-link" href="https://github.com/princepal9120/shiba" target="_blank" rel="noopener noreferrer">Explore the source <span aria-hidden="true">↗</span></a>
            </div>
          </article>
          <article class="proof-card">
            <span class="readiness-marker" aria-hidden="true">◌</span>
            <div>
              <h3>What still needs proving.</h3>
              <p>No successful cloud task with a live model and GitHub is established in the readiness record.</p>
              <dl class="verification-split">
                <div>
                  <dt>In the repository</dt>
                  <dd>Automated checks for task handling, approval, and execution adapters.</dd>
                </div>
                <div>
                  <dt>Needs live proof</dt>
                  <dd>A complete task using your hosting, model connection, and GitHub setup.</dd>
                </div>
              </dl>
            </div>
          </article>
          <article class="proof-card">
            <span class="readiness-marker" aria-hidden="true">◇</span>
            <div>
              <h3>Know the boundaries.</h3>
              <p>Connections have different access and data-handling requirements. Review them before adding private company information or enabling an experimental agent.</p>
              <a class="text-link" href="/docs/configuration/">Connection setup and limits <span aria-hidden="true">→</span></a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Section 11: #faq Accordion -->
    <section id="faq" class="home-section faq-section" data-reveal aria-labelledby="faq-title">
      <div class="faq-layout">
        <div class="section-head">
          <ShibaMascot character="research" state="idle" size={112} />
          <p class="eyebrow">A few things worth asking.</p>
          <h2 id="faq-title">Good<br />questions.</h2>
          <p class="section-lead">The short version here.<br />The details are in the docs.</p>
          <a class="text-link" href="/docs/overview/">Open the docs <span aria-hidden="true">→</span></a>
        </div>
        <div class="faq-list">
          {faqItems.map(item => (
            <details class="faq-item">
              <summary>
                <span>{item.q}</span>
                <span class="faq-toggle" aria-hidden="true">+</span>
              </summary>
              <div class="faq-answer">
                <p>{item.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Section 12: Closing CTA -->
    <section class="closing-section" data-reveal aria-labelledby="closing-title">
      <div class="closing-inner">
        <ShibaMascot character="shiba" state="done" size={160} />
        <p class="eyebrow">Your next employee runs on your terms.</p>
        <h2 id="closing-title">Give the next task<br />a clear place to start.</h2>
        <p class="closing-lead">Set up Shiba, choose one piece of work, and review what comes back.</p>
        <div class="hero-actions">
          <a class="cta cta-primary" href="/docs/self-hosting/">Self host Shiba</a>
        </div>
      </div>
    </section>
  </div>
</MarketingPage>

<script is:inline>
  (function() {
    var motion = matchMedia('(prefers-reduced-motion: reduce)');

    // Staggered per-word tagline observer
    var tagline = document.querySelector('.tagline-reveal');
    var words = document.querySelectorAll('.tagline-reveal .tagline-word');
    if (tagline && words.length > 0 && 'IntersectionObserver' in window && !motion.matches) {
      tagline.classList.add('tagline-interactive');
      words.forEach(function(word, index) {
        word.style.transitionDelay = (index * 75) + 'ms';
      });
      var wordObserver = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-active');
            wordObserver.unobserve(entry.target);
          }
        });
      }, {
        threshold: 0.1,
        rootMargin: '0px 0px -15% 0px'
      });
      words.forEach(function(word) {
        wordObserver.observe(word);
      });
    }

    // Panels stay stacked until enhancement succeeds; native buttons retain Tab/Enter/Space.
    document.querySelectorAll('[data-tab-group]').forEach(function(group) {
      var buttons = Array.from(group.querySelectorAll('[data-panel-target]'));
      var panels = group.querySelectorAll('[data-tab-panel]');
      function select(button) {
        buttons.forEach(function(item) {
          var active = item === button;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-pressed', String(active));
