---
import '../styles/landing.css';
import EmployeeCast from '../components/landing/EmployeeCast.astro';
import ThemedScreenshot from '../components/landing/ThemedScreenshot.astro';
import MarketingPage from '../layouts/MarketingPage.astro';

const repoUrl = 'https://github.com/opentoolsorg/shiba';
const title = 'Shiba — AI Employees for the Work Behind Your Company';
const description =
  'Hire AI employees you own. Shiba is open-source and self-hosted in your Cloudflare account: brief code, design, marketing and ops work, review the plan, and nothing executes until you approve.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Shiba',
    url: 'https://tryshiba.dev/',
    description,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web, Cloudflare Workers',
    license: 'https://spdx.org/licenses/AGPL-3.0-only.html',
    sameAs: repoUrl,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    featureList: [
      'AI employees for engineering, marketing, research and operations work',
      'Approval before every proposed run',
      'Self-hosted in your own Cloudflare account',
      'Repository tasks and configured private file workspaces',
      'Open source under AGPL-3.0',
    ],
  },
];

const steps = [
  { n: '01', t: 'Describe the task', d: 'Name the output: a code change, campaign draft, or account brief. Pick the repository or private workspace it works in.' },
  { n: '02', t: 'Review the proposal', d: 'See the exact files, branch and actions before anything runs. Approve or reject the request.' },
  { n: '03', t: 'Keep the decision', d: 'Shiba returns a pull request and checks. Publishing and sending stay a separate, human step.' },
];

const rows = [
  { k: 'Source code', a: 'Closed, or source-available', b: 'Open source, AGPL-3.0' },
  { k: 'Where it runs', a: 'The vendor’s cloud', b: 'Your Cloudflare account' },
  { k: 'Before it acts', a: 'Varies; often a setting you must find', b: 'Approval on every proposed run' },
  { k: 'If the vendor changes', a: 'You follow their roadmap or leave', b: 'Fork it. You hold the code and the data' },
  { k: 'Cost', a: 'Seats plus usage', b: 'Free software; hosting and model usage are yours' },
];

const controls = [
  { t: 'Approval before execution', d: 'Every proposed run waits for a human decision.' },
  { t: 'Runs in your account', d: 'Self-hosted on your Cloudflare account, not ours.' },
  { t: 'You choose where work happens', d: 'Coding tasks use a GitHub repository. File work can use a private workspace when artifact storage is configured.' },
  { t: 'Auditable source', d: 'AGPL-3.0. Read exactly what the agent can do.' },
];
---
<MarketingPage title={title} description={description} path="/" schema={schema}>
  <div class="landing">
    <section class="hero" aria-labelledby="home-title">
      <div class="hero-dots" aria-hidden="true"></div>
      <div class="lp-shell hero-inner" data-motion="hero">
        <span class="hero-pill">Open source · AGPL-3.0 · Self-hosted</span>
        <h1 id="home-title" class="hero-title">
          Hire AI employees you own.<br />
          <span class="hero-accent">Approve every move.</span>
        </h1>
        <p class="hero-lead">
          Shiba runs code, design, marketing and ops work in your own Cloudflare account. Brief it in Slack, review the plan, and nothing executes until you say so.
        </p>
        <div class="hero-actions">
          <a class="lp-btn lp-btn-primary" href="https://app.tryshiba.dev/tasks/">Open the app</a>
          <a class="lp-btn lp-btn-secondary" href="/docs/self-hosting/">Self-host Shiba</a>
          <a class="lp-btn lp-btn-secondary" href={repoUrl} target="_blank" rel="noopener noreferrer">Star on GitHub <span aria-hidden="true">↗</span></a>
        </div>
        <p class="hero-note">Free to self-host · hosting and model usage cost extra · coding tasks need a GitHub repository</p>
      </div>
    </section>

    <section id="dashboard" class="dashboard" aria-label="Shiba dashboard">
      <div class="lp-shell dashboard-inner" data-motion="reveal">
        <ThemedScreenshot />
      </div>
    </section>

    <EmployeeCast />

    <section id="approve" class="lp-section" aria-labelledby="approve-title">
      <div class="lp-shell">
        <p class="lp-eyebrow">The approval gate</p>
        <h2 id="approve-title" class="lp-h2 section-title">Autonomous,<br />not unsupervised.</h2>
        <ol class="steps">
          {steps.map((s) => (
            <li class="step" data-motion="reveal">
              <span class="step-num" aria-hidden="true">{s.n}</span>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="compare" class="lp-section lp-band" aria-labelledby="compare-title">
      <div class="lp-shell">
        <p class="lp-eyebrow">Why self-host</p>
        <h2 id="compare-title" class="lp-h2 section-title compare-title">Your employees shouldn't live<br />in someone else's account.</h2>
        <div class="cmp" data-motion="reveal" role="table" aria-label="Hosted agent platform compared with Shiba">
          <div class="cmp-row cmp-head" role="row">
            <span class="cmp-cell" role="columnheader"><span class="visually-hidden">Aspect</span></span>
            <span class="cmp-cell cmp-them" role="columnheader">Hosted agent platform</span>
            <span class="cmp-cell cmp-us" role="columnheader">Shiba</span>
          </div>
          {rows.map((r) => (
            <div class="cmp-row" role="row">
              <span class="cmp-cell cmp-key" role="rowheader">{r.k}</span>
              <span class="cmp-cell cmp-them" role="cell" data-label="Hosted agent platform">{r.a}</span>
              <span class="cmp-cell" role="cell" data-label="Shiba">{r.b}</span>
            </div>
          ))}
        </div>
        <p class="cmp-note">Typical hosted-platform pattern, not a claim about one vendor. Verify any vendor against its own terms.</p>
      </div>
    </section>

    <section id="trust" class="lp-section" aria-labelledby="trust-title">
      <div class="lp-shell trust" data-motion="reveal">
        <div>
          <p class="lp-eyebrow">Trust</p>
          <h2 id="trust-title" class="lp-h2 trust-title">Capable by design.<br />Never in charge.</h2>
          <p class="trust-lead">Only controls you can inspect in the source. No badges we haven't earned.</p>
        </div>
        <ul class="controls">
          {controls.map((c) => (
            <li class="control">
              <span class="control-check" aria-hidden="true">✓</span>
              <div>
                <h3>{c.t}</h3>
                <p>{c.d}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="cta" class="cta" aria-labelledby="cta-title">
      <div class="cta-dots" aria-hidden="true"></div>
      <div class="lp-shell cta-inner" data-motion="reveal">
        <img class="cta-logo" src="/landing/shiba-logo.webp" alt="" width="120" height="120" loading="lazy" decoding="async" />
        <h2 id="cta-title" class="cta-title">Give the next task a clear place to start.</h2>
        <p class="cta-lead">Free to self-host. Your Cloudflare account, your repository, your approval.</p>
        <div class="cta-actions">
          <a class="lp-btn cta-btn cta-btn-solid" href="https://app.tryshiba.dev/tasks/">Open the app</a>
          <a class="lp-btn cta-btn cta-btn-outline" href="/docs/self-hosting/">Self-hosting guide</a>
          <a class="lp-btn cta-btn cta-btn-outline" href={repoUrl} target="_blank" rel="noopener noreferrer">View on GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
  </div>
</MarketingPage>

<script>
  import { initLandingMotion } from '../lib/landing-motion';
  initLandingMotion();
</script>

<style>
  section[id] { scroll-margin-top: 96px; }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding: 96px 0 24px;
    text-align: center;
  }
  .hero-dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--lp-dot) 1.2px, transparent 1.4px);
    background-size: 14px 14px;
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, black 0%, transparent 75%);
    mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, black 0%, transparent 75%);
  }
  .hero-inner {
    position: relative;
    max-width: calc(980px + 2 * var(--lp-gutter));
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero-pill {
    display: inline-block;
    padding: 6px 14px;
    border: 1px solid var(--lp-line2);
    border-radius: 999px;
    background: var(--lp-card);
    color: var(--lp-accent);
    font: 500 11px/1.4 var(--lp-font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .hero-title {
    max-width: none;
    margin: 28px 0 22px;
    color: var(--lp-ink);
    font-size: 84px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }
  .hero-accent { color: var(--lp-accent); }
  .hero-lead {
    max-width: 640px;
    margin: 0 0 34px;
    color: var(--lp-ink2);
    font-size: 20px;
    line-height: 1.55;
    text-wrap: pretty;
  }
  .hero-actions,
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }
  .hero-note {
    margin: 22px 0 0;
    color: var(--lp-ink2);
    font: 500 12px/1.5 var(--lp-font-mono);
  }

  /* Dashboard */
  .dashboard { padding: 40px 0 88px; }
  .dashboard-inner { max-width: calc(1180px + 2 * var(--lp-gutter)); }

  /* Shared section heading spacing */
  .section-title { max-width: 720px; margin: 0 0 40px; }
  .compare-title { max-width: 760px; }

  /* Approval gate */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .step {
    padding: 28px;
    border: 1px solid var(--lp-line2);
    border-radius: 12px;
    background: var(--lp-raised);
    box-shadow: var(--lp-shadow);
  }
  .step-num {
    display: block;
    margin-bottom: 20px;
    color: var(--lp-accent);
    font: 500 12px/1.4 var(--lp-font-mono);
  }
  .step h3 {
    margin: 0 0 10px;
    color: var(--lp-ink);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  .step p,
  .control p {
    margin: 0;
    color: var(--lp-ink2);
    font-size: 15px;
    line-height: 1.55;
  }

  /* Comparison */
  .cmp {
    overflow: hidden;
    border: 1px solid var(--lp-line2);
    border-radius: 12px;
    background: var(--lp-raised);
  }
  .cmp-row {
    display: grid;
    grid-template-columns: 1.1fr 1fr 1fr;
    font-size: 15px;
    line-height: 1.5;
  }
  .cmp-row + .cmp-row { border-top: 1px solid var(--lp-line); }
  .cmp-cell { padding: 18px 20px; min-width: 0; }
  .cmp-head {
    background: var(--lp-panel);
    font: 600 12px/1.4 var(--lp-font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .cmp-head .cmp-cell { padding: 16px 20px; }
  .cmp-head .cmp-us { color: var(--lp-accent); }
  .cmp-key { font-weight: 600; color: var(--lp-ink); }
  .cmp-them { color: var(--lp-ink2); }
  @media (hover: hover) {
    .cmp-row:not(.cmp-head):hover { background: var(--lp-panel); }
  }
  .cmp-note {
    margin: 16px 0 0;
    color: var(--lp-ink2);
    font-size: 13px;
  }

  /* Trust */
  .trust {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 64px;
    align-items: start;
  }
  .trust-title { margin: 0 0 20px; }
  .trust-lead {
    max-width: 440px;
    margin: 0;
    color: var(--lp-ink2);
    font-size: 17px;
  }
  .controls {
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--lp-line2);
    border-radius: 12px;
    background: var(--lp-raised);
  }
  .control {
    display: flex;
    gap: 16px;
    padding: 20px 24px;
  }
  .control + .control { border-top: 1px solid var(--lp-line); }
  .control-check {
    flex: none;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 6px;
    background: var(--lp-accent);
    color: var(--lp-onaccent);
    font: 600 13px/1 var(--lp-font-mono);
  }
  .control h3 {
    margin: 0 0 2px;
    color: var(--lp-ink);
    font-size: 16px;
    font-weight: 600;
  }
  .control p { font-size: 14px; }

  /* Closing CTA */
  .cta {
    position: relative;
    overflow: hidden;
    padding: 96px 0;
    background: var(--lp-ctabg);
    color: var(--lp-ctafg);
    text-align: center;
  }
  .cta-dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--lp-ctafg) 1px, transparent 1.3px);
    background-size: 12px 12px;
    opacity: 0.1;
  }
  .cta-inner { position: relative; }
  .cta-logo {
    display: block;
    width: 120px;
    height: 120px;
    margin: 0 auto 12px;
    object-fit: contain;
  }
  .cta-title {
    max-width: 760px;
    margin: 0 auto 20px;
    color: var(--lp-ctafg);
    font-size: 56px;
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
  .cta-lead {
    max-width: 520px;
    margin: 0 auto 32px;
    font-size: 17px;
    opacity: 0.75;
  }
  .cta-btn-solid {
    background: var(--lp-ctafg);
    color: var(--lp-ctabg);
  }
  .cta-btn-outline {
    border: 1px solid var(--lp-ctafg);
    color: var(--lp-ctafg);
  }
  .cta-btn:focus-visible { outline-color: var(--lp-ctafg); }

  @media (max-width: 900px) {
    .hero { padding-top: 64px; }
    .hero-title { font-size: 44px; }
    .hero-lead { font-size: 17px; }
    .dashboard { padding: 24px 0 56px; }
    .steps { grid-template-columns: 1fr; }
    .trust { grid-template-columns: 1fr; gap: 32px; }
    .cta { padding: 72px 0; }
    .cta-title { font-size: 40px; }

    .cmp-head {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    .cmp-row { grid-template-columns: 1fr; padding: 16px 20px; gap: 8px; }
    .cmp-row:nth-child(2) { border-top: 0; }
    .cmp-cell { padding: 0; }
    .cmp-cell[data-label]::before {
      content: attr(data-label);
      display: block;
      margin-bottom: 2px;
      color: var(--lp-ink2);
      font: 600 11px/1.4 var(--lp-font-mono);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .cmp-cell[data-label='Shiba']::before { color: var(--lp-accent); }
  }

  @media (max-width: 480px) {
    .hero-actions .lp-btn,
    .cta-actions .lp-btn { width: 100%; }
  }
</style>
