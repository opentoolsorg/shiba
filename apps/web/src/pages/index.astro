---
import AgentCast from '../components/AgentCast.astro';
import HeroDemo from '../components/HeroDemo.astro';
import MarketingPage from '../layouts/MarketingPage.astro';

const title = 'Shiba — Your Tasks. Your AI Team. Your Call.';
const description = 'An open-source, self-hosted AI workspace for marketing, sales, research, product, design and engineering tasks. Describe the work, review the plan and approve sandbox execution. Early prototype; live cloud validation is pending.';
const faqItems = [
  { q: 'What is Shiba?', a: 'Shiba is an open-source, self-hosted AI workspace for tasks across marketing, sales, research, product, design and engineering. Start with a task and a role template, review the plan, then approve sandbox execution. Review the resulting files, available downloads and diffs; publishing a GitHub pull request is a separate choice for repository work.' },
  { q: 'Do I need a repository for non-coding tasks?', a: 'Yes. Start by describing the task, but the current execution backend requires a connected repository before a run can execute, including reports and research. The repository provides the working context and a place for files; connecting it is execution setup, not a requirement that every task be a code change.' },
  { q: 'What can a role deliver?', a: 'Role templates guide instructions and expected files: campaign drafts, account briefs, sourced research, product briefs, design specs, or code and tests. Review and download available file deliverables in the app. Outputs depend on your task, evidence and configured access; roles are not dedicated PDF or spreadsheet exporters and do not grant permission to send outreach, post campaigns or change production systems.' },
  { q: 'What happens before I approve?', a: 'The orchestrator proposes a plan and a structured approval card. Planning can call model providers, but no sandbox container starts before approval, except for narrowly scoped unattended automations you explicitly enable.' },
  { q: 'Where do my code and credentials go?', a: 'Execution runs in your Cloudflare account. Your chosen model provider receives code context; its retention and training policies apply. Supported provider-backed harnesses use dummy keys with Worker-side egress authorization. Bare cursor and antigravity routes are registered but unrunnable until proven. The experimental Antigravity configuration stores OAuth tokens in a container profile; do not use it with untrusted repositories. Read the configuration and readiness docs.' },
  { q: 'Which tools can I use?', a: 'Choose OpenCode, Claude Code, Codex, Grok, or Pi, and configure your own credentials in the Providers dashboard. Start tasks from the dashboard, Slack, Telegram, Discord, API v1, or Automations. Only OpenCode has been locally exercised, reaching a provider-auth failure rather than established inference. The other four are adapters, not live-run. Bare cursor and antigravity routes are registered but unrunnable until proven.' },
  { q: 'What does it cost?', a: 'Shiba is free software under AGPL-3.0-only, with no Shiba subscription or seat fees. You pay Cloudflare and your selected model provider directly for infrastructure and model usage.' },
  { q: 'Is it production-ready?', a: 'Not yet. Shiba is an early prototype under active development. Core orchestration, approval gating, and container adapters have automated tests, but a real container, live model, and live GitHub run must still be verified on your deploy. The readiness docs separate shipped code from live proof.' },
  { q: 'How do I get started?', a: 'Clone the repository, install Node.js 22.13+ and pnpm 10+, and test locally with pnpm shiba dev. Follow the self-hosting docs to deploy into your Cloudflare account. Mobile browsers can open the dashboard; native iPhone and desktop apps are not released.' },
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Shiba', url: 'https://tryshiba.dev/', description, applicationCategory: 'BusinessApplication', operatingSystem: 'Web, Cloudflare Workers', license: 'https://spdx.org/licenses/AGPL-3.0-only.html', sameAs: 'https://github.com/princepal9120/shiba', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, featureList: ['Task-first workspace with configurable role templates', 'Approval-gated sandbox execution', 'Reviewable file deliverables, available downloads and diffs', 'Connected repository required for execution', 'OpenCode, Claude Code, Codex, Grok, and Pi harnesses'] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqItems.map(item => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) },
];
const steps = [
  { name: 'Describe the work.', detail: 'A campaign draft, an account brief, a research question or a code change. Start with the outcome and your context; choose a role to shape the instructions.', data: '“Research competitors for our next launch”' },
  { name: 'Set up. Then approve.', detail: 'Connect a repository for execution—even for research and reports. Review the plan, repository, branch and model route. Standard sandbox execution waits for your approval.', data: 'Task → plan → required setup → approval' },
  { name: 'Review the deliverables.', detail: 'Follow progress, inspect files and diffs, and download available deliverables. A GitHub pull request is a separate choice when the work calls for one.', data: 'Progress → files → your review' },
];
const channels = [
  { name: 'Dashboard', type: 'image', src: '/assets/mascot/pet-logo.png', note: 'Your workspace, in a browser.' },
  { name: 'Slack', type: 'image', src: '/assets/channels/slack.svg', note: 'A task and an approval, in-thread.' },
  { name: 'Telegram', type: 'image', src: '/assets/channels/telegram.svg', note: 'Send a task to your configured bot.' },
  { name: 'Discord', type: 'image', src: '/assets/channels/discord.svg', note: 'Commands, mentions, and progress.' },
  { name: 'API v1', type: 'api', note: 'Build it into your own workflow.' },
  { name: 'Automations', type: 'automations', note: 'Configure repeatable work explicitly.' },
];
---
<MarketingPage title={title} description={description} path="/" schema={schema}>
  <div class="landing">
    <section class="shell home-hero" aria-labelledby="home-title">
      <div class="hero-copy">
        <a class="release-note" href="/docs/readiness/"><span class="release-dot" aria-hidden="true"></span>Open source. Early, and out in the open.</a>
        <h1 id="home-title">Your tasks.<br />Your team.<br /><em>Your call.</em></h1>
        <p class="hero-subhead">An AI workspace for marketing, sales, research, product, design and engineering. Describe the work, choose a role and review the plan. You approve standard sandbox execution.</p>
        <div class="hero-actions">
          <a class="cta cta-primary" href="/docs/self-hosting/">Self-host Shiba</a>
          <a class="cta cta-secondary" href="https://github.com/princepal9120/shiba" target="_blank" rel="noopener noreferrer">Star on GitHub <span aria-hidden="true">↗</span></a>
        </div>
        <p class="hero-note">Self-hosted · AGPL-3.0 · Bring your own model</p>
        <p class="hero-note">Start with the task. A connected repository is required before execution, including research and reports.</p>
      </div>
      <div class="hero-product"><HeroDemo /></div>
    </section>

    <div class="compatibility" role="region" aria-label="Surfaces and harness catalog">
      <button type="button" class="marquee-toggle" aria-pressed="false" data-marquee-toggle hidden>Pause scrolling</button>
      <div class="marquee-track">{[false, true].map(duplicate => <div class="marquee-set" aria-hidden={duplicate ? 'true' : undefined}>
        {['Dashboard', 'Slack', 'Telegram', 'Discord', 'API v1', 'Automations', 'OpenCode', 'Claude Code', 'Codex', 'Grok', 'Pi'].map(name => <span>{name}<i aria-hidden="true">·</i></span>)}
      </div>)}</div>
    </div>

    <section id="how-it-works" class="shell home-section steps-section" data-reveal aria-labelledby="steps-title">
      <div class="section-head"><p class="eyebrow">A little direction. A lot of possibility.</p><h2 id="steps-title">From “what if”<br />to <em>ready for review.</em></h2><p class="section-lead">A clear task, a visible plan and work you can inspect. The outcome comes first; repository setup supports execution.</p></div>
      <div class="steps-grid">{steps.map((step, i) => <article class="step-card"><span class="step-number" aria-hidden="true">0{i + 1}</span><h3>{step.name}</h3><p>{step.detail}</p><div class="step-data">{step.data}</div></article>)}</div>
    </section>

    <section id="trust" class="trust-band" aria-labelledby="trust-title">
      <div class="shell trust-layout" data-reveal>
        <div class="trust-copy"><p class="eyebrow">Permission is the point.</p><h2 id="trust-title">Capable by design.<br /><em>Never in charge.</em></h2><p class="section-lead">Shiba can propose the next move. You decide whether it happens. A sandbox starts only after approval, unless you explicitly enable a scoped unattended automation.</p>
          <a class="text-link" href="/docs/approval-gates/">Inside the approval gate <span aria-hidden="true">→</span></a>
          <div class="trust-details"><div><h3>Your account.</h3><p>Execution runs in isolated Cloudflare Sandbox containers, on infrastructure you own.</p></div><div><h3>A visible trail.</h3><p>Follow streaming logs, inspect files and diffs, and review available deliverables before deciding what to do next.</p></div></div>
        </div>
        <div class="permission-visual" aria-label="Example of the approval boundary">
          <div class="permission-top"><span class="permission-icon" aria-hidden="true">◇</span><span>Execution boundary</span><span class="permission-status">Waiting for you</span></div>
          <div class="permission-plan"><span class="small-label">Proposed task</span><strong>Research competitors for our next launch</strong><div class="permission-data"><span>Repository</span><code>example/team-workspace</code><span>Branch</span><code>task/competitor-research</code></div></div>
          <div class="gate-line"><span></span><b>Human approval required</b><span></span></div>
          <div class="permission-bottom"><span class="lock-symbol" aria-hidden="true">⌑</span><div><strong>Sandbox not started</strong><p>Your permission opens the gate.</p></div><span class="quiet-dot" aria-hidden="true"></span></div>
          <p class="visual-caption">Illustrative boundary, not a live run. Planning may call a model before approval.</p>
        </div>
      </div>
    </section>

    <section id="employees" class="shell home-section employees-section" data-reveal aria-labelledby="employees-title">
      <div class="section-head"><p class="eyebrow">A role for the work.</p><h2 id="employees-title">Good company.<br /><em>Clear responsibilities.</em></h2><p class="section-lead">Start with a role template or configure your own. Each Shiba represents a working brief: instructions, expected deliverables and a human handoff. You choose the harness and model separately.</p></div>
      <AgentCast />
      <div class="employees-links"><a class="text-link" href="/why-shiba/">Why Shiba</a><a class="text-link" href="/open-source-devin-alternative/">An open-source Devin alternative</a><a class="text-link" href="/blog/">Journal</a><a class="text-link" href="/waitlist/">Waitlist &amp; contribute</a><a class="text-link" href="/integrations/">Meet the integrations <span aria-hidden="true">→</span></a><a class="text-link" href="/network/">How the network works <span aria-hidden="true">→</span></a></div>
    </section>

    <section id="channels" class="surface-band" aria-labelledby="channels-title">
      <div class="shell home-section" data-reveal><div class="section-head"><p class="eyebrow">Less switching. More doing.</p><h2 id="channels-title">Right where<br /><em>you already work.</em></h2><p class="section-lead">Start a task in chat or open the dashboard. Same agent, same approval boundary, a different way in.</p></div>
        <div class="channels-grid">
          {channels.map(channel => (
            <article class="channel-card">
              <span class="channel-mark" aria-hidden="true">
                {channel.type === 'image' && (
                  <img
                    src={channel.src}
                    alt=""
                    width="36"
                    height="36"
                    class={`channel-icon ${channel.name === 'Dashboard' ? 'channel-mascot' : ''}`}
                    loading="lazy"
                    decoding="async"
                  />
                )}
                {channel.type === 'api' && (
                  <svg class="channel-icon channel-svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5a2 2 0 0 0 2 2h1" />
                    <path d="M16 3h1a2 2 0 0 1 2 2v5a2 2 0 0 0 2 2 2 2 0 0 0-2 2v5a2 2 0 0 1-2 2h-1" />
                  </svg>
                )}
                {channel.type === 'automations' && (
                  <svg class="channel-icon channel-svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
                    <path d="M3 3v5h5" />
                    <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16" />
                    <path d="M16 21h5v-5" />
                  </svg>
                )}
              </span>
              <h3>{channel.name}</h3>
              <p>{channel.note}</p>
            </article>
          ))}
        </div>
        <div class="surface-foot"><p>Bring your own credentials and configure each integration. Mobile browsers can open the dashboard; native iPhone and desktop apps are not released.</p><a class="text-link" href="/integrations/">Find your way in <span aria-hidden="true">→</span></a></div>
      </div>
    </section>

    <section id="proof" class="shell home-section proof-section" data-reveal aria-labelledby="proof-title">
      <div class="proof-layout"><div class="section-head"><p class="eyebrow">Open source. Open about the edges.</p><h2 id="proof-title">Early days.<br /><em>Nothing to hide.</em></h2><p class="section-lead">No invented benchmarks. No borrowed customer logos. Just the code, the boundaries, and the work still ahead.</p><a class="text-link" href="/docs/readiness/">Read the readiness notes <span aria-hidden="true">→</span></a></div>
        <div class="readiness-list"><article><span class="readiness-marker" aria-hidden="true">↗</span><div><h3>Yours to inspect.</h3><p>AGPL-3.0-only. The orchestration, sandbox adapters, and approval logic are public. No Shiba seat fees; Cloudflare and model usage are billed by those providers.</p><a class="text-link" href="https://github.com/princepal9120/shiba" target="_blank" rel="noopener noreferrer">Explore the source <span aria-hidden="true">↗</span></a></div></article><article><span class="readiness-marker" aria-hidden="true">◌</span><div><h3>What is—and isn't—verified.</h3><p>Shiba is an early prototype. No cloud end-to-end run is recorded in the readiness docs; shipped code is not the same as live proof.</p><dl class="verification-split"><div><dt>In the repository</dt><dd>Automated checks for orchestration, approval gating, and container adapters.</dd></div><div><dt>Needs live proof</dt><dd>A real container, live model, and GitHub publishing on your deploy. Experimental ComputeSDK backends are not live-verified.</dd></div></dl></div></article><article><span class="readiness-marker" aria-hidden="true">◇</span><div><h3>Know the boundaries.</h3><p>Your model provider receives code context. Credential handling varies by harness; Antigravity OAuth is a known container-profile exception. Read the configuration before enabling it.</p><a class="text-link" href="/docs/configuration/">Configuration and credential flags <span aria-hidden="true">→</span></a></div></article></div>
      </div>
    </section>

    <section id="faq" class="shell home-section faq-section" data-reveal aria-labelledby="faq-title"><div class="faq-layout"><div class="section-head"><p class="eyebrow">A few things worth asking.</p><h2 id="faq-title">Good<br /><em>questions.</em></h2><p class="section-lead">The short version here.<br />The details are in the docs.</p><a class="text-link" href="/docs/overview/">Open the docs <span aria-hidden="true">→</span></a></div><div class="faq-list">{faqItems.map(item => <details class="faq-item"><summary><span>{item.q}</span><span class="faq-toggle" aria-hidden="true">+</span></summary><div class="faq-answer"><p>{item.a}</p></div></details>)}</div></div></section>

    <section class="shell closing" data-reveal aria-labelledby="closing-title"><p class="eyebrow">Your next teammate runs on your terms.</p><h2 id="closing-title">A little more help.<br /><em>A lot more control.</em></h2><p>Make room for an agent that asks first.</p><div class="hero-actions"><a class="cta cta-primary" href="/docs/self-hosting/">Self-host Shiba</a><a class="cta cta-secondary" href="https://github.com/princepal9120/shiba" target="_blank" rel="noopener noreferrer">Star on GitHub <span aria-hidden="true">↗</span></a></div><span class="closing-note">Early prototype. Self-hosted. Always your call.</span></section>
  </div>
</MarketingPage>

<script is:inline>
  (function() {
    var marquee = document.querySelector('.compatibility');
    var toggle = document.querySelector('[data-marquee-toggle]');
    var motion = matchMedia('(prefers-reduced-motion: reduce)');
    if (marquee && toggle) {
      var track = marquee.querySelector('.marquee-track');
      function updateMarqueeControl() { toggle.hidden = motion.matches || !track || getComputedStyle(track).animationName === 'none'; }
      updateMarqueeControl();
      motion.addEventListener('change', updateMarqueeControl);
      toggle.addEventListener('click', function() {
        var paused = toggle.getAttribute('aria-pressed') !== 'true';
        toggle.setAttribute('aria-pressed', String(paused));
        toggle.textContent = paused ? 'Play scrolling' : 'Pause scrolling';
        marquee.classList.toggle('is-paused', paused);
      });
      document.addEventListener('visibilitychange', function() { marquee.classList.toggle('is-hidden', document.hidden); });
    }
    if (!('IntersectionObserver' in window) || motion.matches) return;
    var observer = new IntersectionObserver(function(entries) { entries.forEach(function(entry) { if (entry.isIntersecting) { entry.target.classList.add('is-in'); observer.unobserve(entry.target); } }); }, { rootMargin: '0px 0px -6% 0px' });
    document.querySelectorAll('[data-reveal]').forEach(function(section) { section.classList.add('will-reveal'); observer.observe(section); });
  })();
</script>

<style>
  .landing { --soft-accent: color-mix(in srgb, var(--navy) 5%, var(--paper)); --hairline: color-mix(in srgb, var(--ink) 11%, transparent); --soft-shadow: 0 3px 5px color-mix(in srgb, var(--ink) 3%, transparent), 0 18px 60px color-mix(in srgb, var(--ink) 6%, transparent); overflow: clip; }
  .home-hero { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 28px; align-items: center; padding-block: 64px 88px; min-height: 840px; position: relative; }
  .hero-copy { grid-column: span 5; position: relative; z-index: 1; }
  .hero-product { grid-column: 7 / span 6; position: relative; min-width: 0; }
  .hero-product::before { content: ''; position: absolute; inset: 6% -18% 0 -25%; background: radial-gradient(ellipse at 50% 48%, color-mix(in srgb, var(--navy) 13%, transparent), transparent 68%); pointer-events: none; }
  .release-note { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; text-decoration: none; font-size: 11px; color: var(--ink-2); }
  .release-note > span:last-child { color: var(--navy); margin-left: 2px; }
  .release-dot { display: block; width: 6px; height: 6px; flex: none; background: var(--navy); border-radius: 50%; }
  .hero-copy h1 { font-family: 'Instrument Serif', Georgia, serif; margin: 24px 0 28px; font-size: clamp(72px, 7.1vw, 100px); line-height: .99; font-weight: 400; letter-spacing: -.035em; max-width: none; }
  h1 em, h2 em { font-style: italic; font-weight: 400; color: var(--navy); }
  .hero-subhead { max-width: 37ch; font-size: 17px; line-height: 1.7; color: var(--ink-2); margin: 0; letter-spacing: -.012em; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; align-items: center; }
  .cta { min-height: 50px; display: inline-flex; align-items: center; justify-content: center; gap: 16px; padding: 12px 18px; border-radius: 9px; font-size: 12px; line-height: 1.5; font-weight: 550; text-decoration: none; transition: transform 240ms var(--ease-out), box-shadow 240ms var(--ease-out), background 240ms; }
  .cta-primary { background: var(--navy); color: var(--on-accent); box-shadow: 0 3px 8px color-mix(in srgb, var(--navy) 14%, transparent), inset 0 1px 0 color-mix(in srgb, var(--on-accent) 17%, transparent); }
  .cta-secondary { border: 1px solid var(--hairline); background: color-mix(in srgb, var(--card) 75%, transparent); color: var(--ink); }
  .cta:hover { transform: translateY(-2px); box-shadow: var(--soft-shadow); }
  .cta-primary:hover { background: var(--navy-2); }
  .hero-note { font-size: 11px; color: var(--ink-2); margin-top: 20px; }
  .compatibility { border-block: 1px solid var(--hairline); padding-block: 23px; overflow: hidden; background: color-mix(in srgb, var(--card) 40%, var(--paper)); }
  .marquee-toggle { display: block; margin: 0 auto 16px; min-height: 44px; padding: 8px 16px; border: 1px solid var(--line-2); border-radius: var(--r-sm); background: var(--card); color: var(--ink); font: 12px 'Geist', sans-serif; cursor: pointer; }
  .compatibility:is(.is-paused, .is-hidden) .marquee-track { animation-play-state: paused; }
  .marquee-track { display: flex; width: max-content; }
  :global(.nav-js) .marquee-track { animation: surfaces-drift 48s linear infinite; }
  :global(:root:not(.nav-js)) .marquee-track { width: 100%; }
  :global(:root:not(.nav-js)) .marquee-set { width: 100%; flex-wrap: wrap; justify-content: center; gap: 15px 0; }
  :global(:root:not(.nav-js)) .marquee-set[aria-hidden='true'] { display: none; }
  .marquee-set { flex: none; display: flex; align-items: center; }
  .marquee-set > span { display: inline-flex; align-items: center; gap: 38px; padding-right: 38px; font: 14px 'Geist', sans-serif; font-weight: 450; letter-spacing: -.02em; color: var(--ink-2); }
  .marquee-set i { font-style: normal; color: var(--navy); }
  .compatibility:hover .marquee-track, .compatibility:focus-within .marquee-track { animation-play-state: paused; }
  @keyframes surfaces-drift { to { transform: translateX(-50%); } }
  .home-section { padding-block: 128px; }
  .section-head { max-width: 650px; }
  .eyebrow { font: 12px/1.6 'Geist', sans-serif; font-weight: 500; text-transform: none; letter-spacing: .01em; color: var(--navy); margin: 0 0 22px; }
  h2 { font-size: clamp(44px, 4.4vw, 64px); line-height: 1.05; letter-spacing: -.025em; margin: 0 0 24px; }
  .section-lead { font-size: 17px; line-height: 1.7; color: var(--ink-2); max-width: 49ch; margin: 0; }
  .steps-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 45px; margin-top: 64px; }
  .step-card { min-width: 0; }
  .step-number { display: inline-block; margin-bottom: 25px; font: 48px/.9 'Instrument Serif', Georgia, serif; color: color-mix(in srgb, var(--navy) 75%, var(--ink)); letter-spacing: -.04em; }
  .step-card h3 { font: 550 19px/1.3 'Geist', sans-serif; letter-spacing: -.025em; margin: 0 0 14px; }
  .step-card p { font-size: 14px; line-height: 1.8; color: var(--ink-2); margin: 0; }
  .step-data { margin-top: 26px; padding-top: 20px; border-top: 1px solid var(--hairline); font: 10px/1.7 'Geist Mono', monospace; color: var(--ink-2); }
  .trust-band { background: linear-gradient(120deg, var(--soft-accent), color-mix(in srgb, var(--card) 55%, var(--paper))); border-block: 1px solid var(--hairline); padding-block: 125px; }
  .trust-layout { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 28px; align-items: center; }
  .trust-copy { grid-column: span 6; }
  .trust-copy h2 { font-size: clamp(44px, 4vw, 58px); }
  .trust-copy .section-lead { max-width: 43ch; }
  .text-link { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; color: var(--navy); font-size: 13px; text-decoration: none; }
  .text-link:hover { text-decoration: underline; text-underline-offset: 5px; }
  .trust-copy > .text-link { margin-top: 17px; }
  .trust-details { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; border-top: 1px solid var(--hairline); padding-top: 27px; margin-top: 32px; max-width: 480px; }
  .trust-details h3 { font: 550 13px/1.5 'Geist', sans-serif; margin: 0 0 8px; }
  .trust-details p { font-size: 12px; line-height: 1.8; margin: 0; color: var(--ink-2); }
  .permission-visual { grid-column: 8 / span 5; border: 1px solid var(--hairline); border-radius: 18px; background: var(--card); box-shadow: var(--soft-shadow); padding: 24px; }
  .permission-top { display: flex; align-items: center; gap: 8px; font-size: 11px; color: var(--ink-2); padding-bottom: 24px; }
  .permission-icon { color: var(--navy); font-size: 18px; }
  .permission-status { margin-left: auto; padding: 5px 8px; border-radius: 20px; background: var(--soft-accent); color: var(--navy); font-size: 9px; }
  .small-label { display: block; color: var(--ink-2); font-size: 10px; margin-bottom: 9px; }
  .permission-plan > strong { font-weight: 550; font-size: 16px; line-height: 1.6; letter-spacing: -.02em; display: block; }
  .permission-data { display: grid; grid-template-columns: 70px minmax(0, 1fr); gap: 12px; margin-top: 24px; font-size: 10px; color: var(--ink-2); }
  .permission-data code { font: 10px 'Geist Mono', monospace; overflow-wrap: anywhere; color: var(--ink); }
