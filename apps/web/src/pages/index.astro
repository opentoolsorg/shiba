---
import ReachAnywhere from '../components/ReachAnywhere.astro';
import MarketingPage from '../layouts/MarketingPage.astro';

const description =
  'Self-hosted, approval-gated coding agent for your Cloudflare account: sandbox runs, optional PR publish, optional review round, pluggable sandboxes, and org custom agents. AGPL-3.0.';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Shiba',
  url: 'https://tryshiba.dev/',
  description,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Web',
  license: 'https://spdx.org/licenses/AGPL-3.0-only.html',
  sameAs: ['https://github.com/princepal9120/shiba'],
};

const comparisons = [
  { point: 'Runs in infrastructure you own', shiba: 'Your Cloudflare account (default sandbox)', them: "The provider's account" },
  { point: 'Model and harness per run', shiba: 'Pinned per approval; connections + purpose policy', them: 'Chosen by the provider' },
  { point: 'Approval before code runs', shiba: 'Required by default', them: 'Varies by product' },
  { point: 'Sandbox backend', shiba: 'Cloudflare default; docker-local / ComputeSDK opt-in', them: 'Opaque hosted pool' },
  { point: 'License', shiba: 'AGPL-3.0, source readable', them: 'Proprietary' },
];

const capabilities = [
  { number: '01', symbol: '▣', title: 'Approval before execution', detail: 'Inspect repo, branch, task, harness, and model route on the card. No sandbox starts until you approve (unless you explicitly configure unattended automations).' },
  { number: '02', symbol: '▧', title: 'Isolated sandboxes', detail: 'Default: Cloudflare Containers with Worker-side egress (`SandboxOutbound`). Alternate providers exist for local dev and experiments — see docs for enforcement limits.' },
  { number: '03', symbol: '◫', title: 'Diff, PR, review', detail: 'Watch progress and diffs in the dashboard. Optional GitHub PR publish; optional chained read-only review round after publish (mock-GitHub verified locally; live GitHub not CI-proven).' },
  { number: '04', symbol: '⌁', title: 'Your models', detail: 'Route runs through AI Gateway BYOK and deployment connections. ChatGPT Sign-in (SIWC) and subscription harnesses are optional, flag-gated paths — not the default.' },
  { number: '05', symbol: '◎', title: 'Custom agents', detail: 'Save org presets (harness, model, sandbox defaults) in the dashboard and reference them from tasks or the public API.' },
  { number: '06', symbol: '≋', title: 'Triggers + API', detail: 'Dashboard, Slack, Telegram, Discord, automations, and `/api/v1` with `@shiba/sdk`. Desktop app and native iPhone client are not shipped.' },
];

const sandboxRows = [
  { id: 'cloudflare', label: 'Cloudflare', note: 'Default production path; edge egress enforcement', status: 'Default' },
  { id: 'docker-local', label: 'Docker (local)', note: 'Local engine; requires explicit unenforced-egress opt-in', status: 'Dev' },
  { id: 'computesdk', label: 'ComputeSDK', note: 'E2B / Daytona / Modal / … via host runner — not Worker-native', status: 'Experimental' },
];

const roadmapRows = [
  { phase: 'Shipped in repo', items: 'Task→sandbox→PR→review loop, Sandbox SDK 1.0, den/pack UI, browser E2E capture code, review triage, integrations webhooks, public API + SDK, custom agents, provider catalog.' },
  { phase: 'Not live-verified', items: 'Real container + live model + live GitHub on your deploy; ComputeSDK backends; Electron desktop (#126).' },
  { phase: 'Next', items: 'Owner Mac deploy proof, live E2E entry in VERIFICATION.md, review-loop endpoint, clearer reviewer re-run semantics.' },
];
---

<MarketingPage title="Shiba — self-hosted AI coworker on Cloudflare" description={description} path="/" schema={schema}>
  <section class="shell home-hero" aria-labelledby="home-title">
    <div class="hero-copy">
      <p class="eyebrow">AGPL · SELF-HOSTED · CLOUDFLARE WORKERS</p>
      <h1 id="home-title">It asks before<br /><em>it writes code.</em><span class="hero-caret" aria-hidden="true"></span></h1>
      <p class="hero-lead">Queue a coding task, approve the exact input, run it in an isolated sandbox, then read the diff — and optionally open a pull request with a follow-up review round. You operate the Worker; Shiba does not host your repo or keys.</p>
      <div class="hero-actions">
        <a class="button" href="/docs/self-hosting/">Self-host on Cloudflare <span aria-hidden="true">↗</span></a>
        <a class="button button-outline" href="/docs/getting-started/">Local quickstart</a>
        <a class="button button-outline" href="https://github.com/princepal9120/shiba">Source</a>
      </div>
      <p class="hero-note">Local dev: <code>pnpm shiba dev</code> after Docker is running. Claims on this page match the repo; live cloud proof is listed under Roadmap.</p>
    </div>

    <figure class="hero-showcase" aria-label="Illustration of shiba.workspace">
      <img
        id="hero-showcase-img"
        class="hero-showcase-img"
        src="/assets/shiba-hero-window-dark.png"
        alt="Retro desktop window of the shiba.workspace: harness chips, a pixel workstation, capability icons, and a status bar reading your Cloudflare account, one approval, six harnesses"
        width="1266"
        height="878"
        loading="eager"
        fetchpriority="high"
      />
    </figure>
    <script is:inline>
      (function() {
        var img = document.getElementById('hero-showcase-img');
        if (!img) return;
        function update() {
          var dark = document.documentElement.getAttribute('data-theme') === 'dark';
          img.src = dark ? '/assets/shiba-hero-window-dark.png' : '/assets/shiba-hero-window.png';
        }
        update();
        var obs = new MutationObserver(update);
        obs.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
      })();
    </script>
  </section>
  <script is:inline>
    // Reveal is opt-in on JS so content never stays hidden if the script fails.
    (function() {
      if (!('IntersectionObserver' in window)) return;
      document.documentElement.classList.add('js-reveal');
      var io = new IntersectionObserver(function(entries) {
        entries.forEach(function(e) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -12% 0px' });
      function watch() {
        document.querySelectorAll('.harness-grid, .channels-grid, .capability-grid, .steps-grid, .sandbox-table, .roadmap-grid').forEach(function(g) {
          Array.prototype.forEach.call(g.children, function(c, i) { c.style.setProperty('--i', i); });
        });
        document.querySelectorAll('[data-reveal]').forEach(function(el) { io.observe(el); });
      }
      document.readyState === 'loading' ? document.addEventListener('DOMContentLoaded', watch) : watch();
    })();
  </script>

  <div class="shell compatibility" aria-label="Ways to use Shiba"><span>USE FROM</span><span>Dashboard</span><span>Slack</span><span>Telegram</span><span>Discord</span><span>API v1</span><span>Automations</span><span class="compatibility-end">Mobile web works; native iPhone and desktop apps are not released.</span></div>

  <section id="harnesses" class="shell harness-section" data-reveal aria-labelledby="harness-title">
    <p class="eyebrow">TOOLS &amp; MODEL PROVIDERS</p>
    <h2 id="harness-title">Bring your tools. Keep control.</h2>
    <p class="harness-lead">Six harnesses are supported. Pick OpenCode, Claude Code, Codex, Devin CLI, Cursor, or Antigravity, and run them with your own provider credentials.</p>
    <div class="harness-grid" role="list" aria-label="Coding tools and model providers">
      <div class="harness-item integrated" role="listitem"><span class="harness-icon"><img src="/assets/harnesses/opencode.svg" alt="" width="32" height="32" /></span><span class="harness-label">OpenCode<small>INTEGRATED</small></span></div>
      <div class="harness-item integrated" role="listitem"><span class="harness-icon"><img src="/assets/harnesses/claude.svg" alt="" width="32" height="32" /></span><span class="harness-label">Claude Code<small>INTEGRATED</small></span></div>
      <div class="harness-item integrated" role="listitem"><span class="harness-icon"><img src="/assets/harnesses/openai.svg" alt="" width="32" height="32" /></span><span class="harness-label">Codex<small>INTEGRATED</small></span></div>
      <div class="harness-item integrated" role="listitem"><span class="harness-icon"><img src="/assets/harnesses/devin.svg" alt="" width="32" height="32" /></span><span class="harness-label">Devin CLI<small>INTEGRATED</small></span></div>
      <div class="harness-item integrated" role="listitem"><span class="harness-icon"><img src="/assets/harnesses/cursor.svg" alt="" width="32" height="32" /></span><span class="harness-label">Cursor<small>INTEGRATED</small></span></div>
      <div class="harness-item integrated" role="listitem"><span class="harness-icon"><img src="/assets/harnesses/antigravity.svg" alt="" width="32" height="32" /></span><span class="harness-label">Antigravity<small>INTEGRATED</small></span></div>
    </div>
    <p class="harness-note">Product names and logos belong to their respective owners. No affiliation is implied. <a href="/docs/configuration/">Harness and credential flags →</a></p>
  </section>

  <section id="sandboxes" class="shell home-section sandbox-section" data-reveal aria-labelledby="sandbox-title">
    <div class="section-head">
      <h2 id="sandbox-title">Pick where the sandbox runs</h2>
      <p class="micro">PROVIDER PLUG-INS</p>
    </div>
    <p class="sandbox-intro">Production on Cloudflare uses the default provider with Worker-side egress. Other adapters trade enforcement for flexibility — read the matrix before enabling them.</p>
    <div class="sandbox-table" role="table" aria-label="Sandbox providers">
      <div class="sandbox-row sandbox-head" role="row">
        <span role="columnheader">Provider</span>
        <span role="columnheader">Role</span>
        <span role="columnheader">Notes</span>
      </div>
      {sandboxRows.map((row) => (
        <div class="sandbox-row" role="row">
          <span role="cell" class="sandbox-id">{row.label}</span>
          <span role="cell"><span class="sandbox-pill">{row.status}</span></span>
          <span role="cell">{row.note}</span>
        </div>
      ))}
    </div>
    <p class="sandbox-foot"><a class="text-link" href="/docs/sandbox-providers/">Sandbox providers docs <span aria-hidden="true">↗</span></a> · <a class="text-link" href="/docs/sandbox-custom-provider/">Write an adapter <span aria-hidden="true">↗</span></a> · <code>pnpm shiba doctor</code> checks your selection against run requirements.</p>
  </section>

  <ReachAnywhere />

  <section id="channels" class="shell home-section channels-section" data-reveal aria-labelledby="channels-title">
    <div class="section-head">
      <h2 id="channels-title">Start where you work.<br /><em>Stay in control.</em></h2>
      <p class="micro">SLACK · MOBILE WEB · TELEGRAM · DISCORD</p>
    </div>
    <div class="channels-intro">
      <p>Send a task from chat or open the dashboard on your phone. Review the proposed tool input before a sandbox starts, then follow progress and inspect the changes.</p>
    </div>
    <div class="channels-grid">
      <div class="channel-card">
        <div class="channel-top">
          <span class="channel-icon"><img src="/assets/channels/slack.svg" alt="" width="22" height="22" /></span>
          <span class="channel-badge">● LIVE CHATOPS</span>
        </div>
        <h3>Slack</h3>
        <div class="channel-bubble">
          <span class="bubble-prompt"><strong class="highlight">@shiba</strong> fix the token refresh race in auth.ts</span>
          <span class="bubble-reply">↳ Generated plan ready for review</span>
        </div>
        <p>Mention @shiba in a configured Slack channel. Review the approval card in-thread before the sandbox starts.</p>
      </div>

      <div class="channel-card">
        <div class="channel-top">
          <span class="channel-icon"><img src="/assets/channels/iphone.svg" alt="" width="22" height="22" /></span>
          <span class="channel-badge">● MOBILE WEB</span>
        </div>
        <h3>Mobile web</h3>
        <div class="channel-bubble">
          <span class="bubble-prompt"><strong class="highlight">Add to Home Screen</strong> · Mobile dashboard</span>
          <span class="bubble-reply">↳ Review the input. Approve the run.</span>
        </div>
        <p>Mobile-optimized dashboard. Review proposed tool inputs, follow logs, and inspect diffs from anywhere.</p>
      </div>

      <div class="channel-card">
        <div class="channel-top">
          <span class="channel-icon"><img src="/assets/channels/telegram.svg" alt="" width="22" height="22" /></span>
          <span class="channel-badge">● LIVE CHATOPS</span>
        </div>
        <h3>Telegram</h3>
        <div class="channel-bubble">
          <span class="bubble-prompt"><strong class="highlight">/shiba</strong> deploy staging hotfix --branch main</span>
          <span class="bubble-reply">↳ Webhook dispatch &amp; inline buttons</span>
        </div>
        <p>Send a coding task to your configured bot and review it before execution.</p>
      </div>

      <div class="channel-card">
        <div class="channel-top">
          <span class="channel-icon"><img src="/assets/channels/discord.svg" alt="" width="22" height="22" /></span>
          <span class="channel-badge">● LIVE CHATOPS</span>
        </div>
        <h3>Discord</h3>
        <div class="channel-bubble">
          <span class="bubble-prompt"><strong class="highlight">/shiba</strong> task repo:backend issue:#142</span>
          <span class="bubble-reply">↳ Threaded run logs &amp; diff previews</span>
        </div>
        <p>Slash commands and bot mentions for developer servers, with threaded progress updates and sandbox review.</p>
      </div>
    </div>
  </section>

  <section class="shell home-section" data-reveal aria-labelledby="why-title">
    <div class="section-head"><h2 id="why-title">The agent does the work.<br /><em>You keep the keys.</em></h2><p class="micro">ONE DEPLOYMENT · ONE CONTROL PLANE</p></div>
    <div class="section-copy"><p>Your infrastructure. Your approval. An inspectable diff. Shiba runs in your Cloudflare account, keeps provider credentials outside the sandbox, and waits for human approval before coding tasks execute.</p><a class="text-link" href="/why-shiba/">Why we built it <span aria-hidden="true">↗</span></a></div>
  </section>

  <section class="shell home-section compare" data-reveal aria-labelledby="compare-title">
    <div class="section-head"><h2 id="compare-title">Why switch off a hosted agent.</h2><p class="micro">SHIBA VS A MANAGED CLOUD AGENT</p></div>
    <div class="compare-grid" role="table" aria-label="Shiba compared with a managed cloud coding agent">
      <div class="compare-row compare-head" role="row">
        <span role="columnheader"></span>
        <span role="columnheader" class="compare-shiba"><span class="compare-col-label">Shiba</span><span class="compare-col-full">SHIBA</span></span>
        <span role="columnheader"><span class="compare-col-label">Managed cloud agent</span><span class="compare-col-full">MANAGED CLOUD AGENT</span></span>
      </div>
      {comparisons.map((row) => (
        <div class="compare-row" role="row">
          <span role="cell">{row.point}</span>
          <span role="cell" class="compare-shiba"><span class="compare-col-label">Shiba</span><span class="compare-col-full">{row.shiba}</span></span>
          <span role="cell"><span class="compare-col-label">Managed cloud agent</span><span class="compare-col-full">{row.them}</span></span>
        </div>
      ))}
    </div>
  </section>

  <section class="shell home-section capabilities" data-reveal aria-labelledby="capabilities-title">
    <div class="section-head"><h2 id="capabilities-title">What Shiba gives you</h2><p class="micro">SIX PRACTICAL CAPABILITIES</p></div>
    <div class="capability-grid">
      {capabilities.map((item) => <article class="capability-card"><div class="capability-top"><span class="capability-icon" aria-hidden="true">{item.symbol}</span><span class="micro">{item.number}</span></div><h3>{item.title}</h3><p>{item.detail}</p></article>)}
    </div>
  </section>

  <section class="shell home-section steps" data-reveal aria-labelledby="steps-title">
    <div class="section-head"><h2 id="steps-title">From task to inspectable diff</h2><p class="micro">THE APPROVAL GATE IS THE WORKFLOW</p></div>
    <div class="steps-grid">
      <div class="step-card">
        <div class="step-dither-screen" aria-hidden="true">
          <div class="step-illustration"><img class="dithered-light" src="/assets/shiba-card-01-repo.png" alt="" width="1672" height="941" loading="lazy" /><img class="dithered-dark" src="/assets/shiba-card-01-repo-dark.png" alt="" width="1672" height="941" loading="lazy" aria-hidden="true" /></div>
        </div>
        <span class="micro">01 / CONNECT</span>
        <h3>Bring a repository</h3>
        <p>Paste an HTTPS GitHub repository URL and describe the coding task in the dashboard.</p>
      </div>

      <div class="step-card">
        <div class="step-dither-screen" aria-hidden="true">
          <div class="step-illustration"><img class="dithered-light" src="/assets/shiba-card-02-approval.png" alt="" width="1672" height="941" loading="lazy" /><img class="dithered-dark" src="/assets/shiba-card-02-approval-dark.png" alt="" width="1672" height="941" loading="lazy" aria-hidden="true" /></div>
        </div>
        <span class="micro">02 / DECIDE</span>
        <h3>Approve or reject</h3>
        <p>Inspect the proposed tool input. By default, Shiba waits for your approval before starting a sandbox.</p>
      </div>

      <div class="step-card">
        <div class="step-dither-screen" aria-hidden="true">
          <div class="step-illustration"><img class="dithered-light" src="/assets/shiba-card-03-diff.png" alt="" width="1672" height="941" loading="lazy" /><img class="dithered-dark" src="/assets/shiba-card-03-diff-dark.png" alt="" width="1672" height="941" loading="lazy" aria-hidden="true" /></div>
        </div>
        <span class="micro">03 / REVIEW</span>
        <h3>See what changed</h3>
        <p>Follow progress, files, and the diff. Turn on PR publish when GitHub is configured; an optional review round can run after the PR opens.</p>
      </div>

      <div class="step-card">
        <div class="step-dither-screen" aria-hidden="true">
          <div class="step-illustration step-illustration--plain" />
        </div>
        <span class="micro">04 / OPTIONAL</span>
        <h3>Evidence and API</h3>
        <p>Browser E2E frames and preview screenshots attach to runs when configured. Automations, Linear webhooks, and <code>/api/v1</code> reuse the same approval gate.</p>
      </div>
    </div>
  </section>

  <section id="roadmap" class="shell home-section roadmap-section" data-reveal aria-labelledby="roadmap-title">
    <div class="section-head">
      <h2 id="roadmap-title">Roadmap (honest)</h2>
      <p class="micro">CODE VS LIVE PROOF</p>
    </div>
    <div class="roadmap-grid">
      {roadmapRows.map((row) => (
        <article class="roadmap-card">
          <h3>{row.phase}</h3>
          <p>{row.items}</p>
        </article>
      ))}
    </div>
    <p class="roadmap-foot">Detail: <a class="text-link" href="https://github.com/princepal9120/shiba/blob/main/ROADMAP.md">ROADMAP.md</a> in the repo · verification log <a class="text-link" href="https://github.com/princepal9120/shiba/blob/main/VERIFICATION.md">VERIFICATION.md</a></p>
  </section>

  <section class="shell closing" data-reveal aria-labelledby="closing-title"><img class="closing-mascot" src="/assets/mascot/shiba-sticker-hero.webp" alt="" width="512" height="512" loading="lazy" aria-hidden="true" /><div><h2 id="closing-title">Run it on your account.</h2><p>Install deps, run <code>pnpm shiba dev</code> for local Worker + sandbox smoke, then follow <a href="/docs/self-hosting/">self-hosting</a> for Cloudflare. Run <code>pnpm check:deploy</code> after editing <code>wrangler.jsonc</code> so Alchemy stays aligned.</p></div><div class="closing-actions"><a class="button" href="/docs/getting-started/">Get started <span aria-hidden="true">↗</span></a><a class="button button-outline" href="/docs/sdk/">Public API &amp; SDK</a></div></section>
</MarketingPage>

<style>
  /* Hero rhythm — 4-unit base. The label belongs to the headline (tight), the
     headline-to-lead break is the section's main pause, then intervals tighten
     toward the quiet note so the column tapers instead of repeating one value. */
  .home-hero { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1.3fr); gap:clamp(28px, 4vw, 48px); align-items:center; padding-block:36px 18px; min-height:min(640px, calc(100svh - 112px)); --hero-gap-tight:14px; --hero-gap-lg:24px; --hero-gap-md:20px; --hero-gap-sm:14px; }
  .hero-copy { animation:hero-arrive 560ms cubic-bezier(.2,.7,.2,1) both; }
  /* Size the headline to the measure it actually has, not to the viewport.
     10.9cqi keeps "Your AI software engineer." on one line at every column
     width; balance is the backstop when webfont metrics fall back. */
  .hero-copy { container-type:inline-size; }
  .hero-copy h1 { max-width:none; margin:var(--hero-gap-tight) 0 var(--hero-gap-lg); font-size:clamp(32px,10.9cqi,84px); line-height:1.03; text-wrap:balance; }
  .hero-copy h1 em, .home-section h2 em { color:var(--navy); font-weight:400; }
  .hero-lead { max-width:46ch; font-size:16px; line-height:1.65; text-wrap:pretty; }
  .hero-actions, .closing-actions { display:flex; flex-wrap:wrap; align-items:center; gap:12px; margin-top:28px; }
  .home-hero .hero-actions { margin-top:var(--hero-gap-md); }
  .hero-note { display:flex; align-items:flex-start; gap:8px; margin-top:var(--hero-gap-sm); font:10px 'Geist Mono',monospace; letter-spacing:.02em; }
  .hero-note::before { content:''; flex:none; width:6px; height:6px; margin-top:4px; background:var(--navy); }
  .hero-note code { font-family:'Geist Mono',monospace; font-size:9px; color:var(--navy); }
  .hero-showcase { border:1px solid var(--line-2); background:var(--panel-2); padding:4px; box-shadow:6px 6px 0 var(--paper-shadow); transition:transform 220ms ease, box-shadow 220ms ease; animation:hero-arrive 680ms 100ms cubic-bezier(.2,.7,.2,1) both; margin:0; }
  .hero-caret { display:inline-block; width:.08em; height:.78em; margin-left:.08em; vertical-align:-.04em; background:var(--navy); animation:caret-blink 1.1s steps(1) infinite; }
  @keyframes caret-blink { 50% { opacity:0; } }
  .hero-showcase:hover, .hero-showcase:focus-within { transform:translateY(-2px); box-shadow:8px 8px 0 var(--paper-shadow); }
  .hero-showcase-img { display:block; width:100%; height:auto; image-rendering:pixelated; border:1px solid var(--line-2); }
  @media (max-width:900px) {
    .home-hero { grid-template-columns:1fr; }
    .hero-showcase { width:100%; }
  }
  @keyframes approval-pulse { 0%, 100% { opacity:1; } 50% { opacity:.58; } }
  @keyframes hero-arrive { from { opacity:0; translate:0 14px; } to { opacity:1; translate:0 0; } }
  /* Scroll reveal: section fades up, then grid children stagger in. */
  :global(.js-reveal) [data-reveal] { opacity:0; translate:0 18px; transition:opacity 520ms cubic-bezier(.23,1,.32,1), translate 520ms cubic-bezier(.23,1,.32,1); }
  :global(.js-reveal) [data-reveal].is-in { opacity:1; translate:0 0; }
      :global(.js-reveal) [data-reveal] :is(.harness-grid, .channels-grid, .capability-grid, .steps-grid, .sandbox-table, .roadmap-grid) > * { opacity:0; translate:0 10px; transition:opacity 420ms cubic-bezier(.23,1,.32,1), translate 420ms cubic-bezier(.23,1,.32,1), background 150ms ease; transition-delay:calc(120ms + var(--i, 0) * 60ms); }
      :global(.js-reveal) [data-reveal].is-in :is(.harness-grid, .channels-grid, .capability-grid, .steps-grid, .sandbox-table, .roadmap-grid) > * { opacity:1; translate:0 0; }
  @media (hover: hover) and (pointer: fine) {
    .harness-icon, .capability-icon { transition:transform 200ms cubic-bezier(.23,1,.32,1); }
    .harness-item:hover .harness-icon { transform:translateY(-3px) rotate(-4deg); }
    .capability-card:hover .capability-icon { transform:translateX(3px); }
    .closing:hover .closing-mascot { rotate:-2deg; translate:0 -4px; }
  }
  .closing-mascot { flex:none; width:112px; height:auto; rotate:-7deg; filter:drop-shadow(3px 4px 0 var(--paper-shadow)); transition:rotate 260ms cubic-bezier(.23,1,.32,1), translate 260ms cubic-bezier(.23,1,.32,1); }
  .closing > div:not(.closing-actions) { flex:1; }
  @media (prefers-reduced-motion: reduce) {
    .hero-caret { animation:none; }
