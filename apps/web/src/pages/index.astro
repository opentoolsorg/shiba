      });
      var wordObserver = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-active');
            wordObserver.unobserve(entry.target);
          }
        });
      }, {
        threshold: 0.1,
        rootMargin: '0px 0px -15% 0px'
      });
      words.forEach(function(word) {
        wordObserver.observe(word);
      });
    }

    // Role tabs for section 5 ("A chatbot suggests. Shiba delivers.")
    var tabBtns = document.querySelectorAll('[data-delivers-tab]');
    var panels = document.querySelectorAll('[data-delivers-panel]');
    if (tabBtns.length > 0 && panels.length > 0) {
      tabBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var role = btn.getAttribute('data-delivers-tab');
          tabBtns.forEach(function(b) {
            var active = b === btn;
            b.classList.toggle('is-active', active);
            b.setAttribute('aria-pressed', String(active));
          });
          panels.forEach(function(p) {
