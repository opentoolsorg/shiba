---
import IntegrationLogos from '../components/IntegrationLogos.astro';
import MarketingPage from '../layouts/MarketingPage.astro';
import PlannedCatalog from '../components/landing/PlannedCatalog.astro';
import '../styles/landing.css';
import { INTEGRATION_CATALOG } from '../../../../packages/shared/src/integration-catalog';
import { CURATED_MCP_VENDORS } from '../../../../packages/shared/src/curated-mcp-vendors';
import { SKILL_LIBRARY } from '../../../backend/src/skill-library';


const repoUrl = 'https://github.com/princepal9120/shiba';

const workflows = [
  {
    title: 'Brief a campaign',
    mascot: '/landing/mascots/marketing.svg',
    left: 'Slack · task brief',
    right: 'GitHub · draft files',
    copy: 'Supply the product context in a conversation. Review the proposed run before an employee prepares campaign files in your repository.',
    output: 'Example output · launch brief + campaign copy',
    boundary: 'Publication remains a separate decision',
  },
  {
    title: 'Research with context',
    mascot: '/landing/mascots/research.svg',
    left: 'Gmail · read-only context',
    right: 'GitHub · research files',
    copy: 'Use permitted email search results to frame a focused question. Approve the repository task and review its sources and open questions.',
    output: 'Example output · research report',
    boundary: 'No permission to send or modify email',
  },
  {
    title: 'Repeat the useful work',
    mascot: '/landing/mascots/engineering.svg',
    left: 'Cron · scheduled request',
    right: 'GitHub · changes + checks',
    copy: 'Schedule a request for repository maintenance. The proposed run still waits for human approval before the configured AI tool acts.',
    output: 'Example output · code changes + checks',
    boundary: 'A schedule is not blanket approval',
  },
];

const boundaries = [
  {
    title: 'Approval is its own decision',
    copy: 'Conversations, schedules, and clients can request work. A human still approves the proposed run before execution.',
  },
  {
    title: 'You choose where work happens',
    copy: 'Coding tasks use a GitHub repository. File work can use a private workspace when artifact storage is configured. Review the returned files before publishing or sending anything.',
  },
  {
    title: 'Gmail context stays read-only',
    copy: 'Gmail context uses permitted email search results as task context. It does not authorize sending, deleting, or modifying email.',
  },
  {
    title: 'Verify in the account you control',
    copy: 'Shiba is self-hosted in your Cloudflare account. Test your configured tools in your own account; this planned catalog is not proof of a live connection.',
  },
];
---

<MarketingPage
  title="Integrations — Shiba AI Employees"
  description="Plan how Shiba fits the tools your team uses: illustrative workflows, a catalog of planned tools, and the approval boundaries that keep every run in your hands."
  path="/integrations/"
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Integrations', path: '/integrations/' }]}
>
  <div class="landing">
    <section class="lp-shell hero" data-motion="hero" aria-labelledby="integrations-title">
      <p class="lp-eyebrow">Your workspace, on your terms</p>
      <h1 id="integrations-title">Your tools.<br /><span class="accent">Your AI employee.</span></h1>
      <p class="hero-copy">Browse app integrations, remote MCP server presets, and reusable skills. Configure access in your workspace and keep the decision to run in your own hands.</p>
      <div class="actions">
        <a class="lp-btn lp-btn-primary" href="#directory">Explore the directory <span aria-hidden="true">↓</span></a>
        <a class="lp-btn lp-btn-secondary" href="/docs/configuration/">Read the setup guide <span aria-hidden="true">↗</span></a>
      </div>
      <figure class="visual" role="img" aria-label="Conceptual illustration of a Shiba employee with example tools; not a connection-status view">
        <div class="visual-paper" aria-hidden="true"></div>
        <div class="tool-chip chip-a"><IntegrationLogos providerKey="slack" />Slack · a brief</div>
        <div class="tool-chip chip-b"><IntegrationLogos providerKey="gmail" />Gmail · read-only context</div>
        <div class="tool-chip chip-c"><IntegrationLogos providerKey="github" />GitHub · your repository</div>
        <div class="visual-center">
          <div class="visual-tag">Instructions + your approval</div>
          <img src="/landing/mascots/operations.svg" alt="" width="260" height="240" decoding="async" />
          <div class="employee-label">Your Shiba employee</div>
          <div class="visual-tag">Your Cloudflare account</div>
        </div>
        <div class="tool-chip chip-d"><IntegrationLogos providerKey="linear" />Linear · an issue</div>
        <div class="tool-chip chip-e">Your configured AI tool</div>
        <div class="tool-chip chip-f">Schedule · a request</div>
      </figure>
      <p class="caption">Conceptual illustration, not a connection-status view. Browse app catalog entries, MCP presets, and draft skills below. None of these listings indicates a connected account. A request never replaces human approval.</p>
    </section>

    <section class="lp-band" aria-labelledby="workflows-title">
      <div class="lp-shell lp-section">
        <div class="section-head" data-motion="reveal">
          <div>
            <p class="lp-eyebrow">Ways to put it together</p>
            <h2 class="lp-h2" id="workflows-title">A familiar starting point.<br />A reviewable result.</h2>
          </div>
          <p>Illustrative workflows for planning your setup. Provider-backed acceptance is still pending; these are not completed runs.</p>
        </div>
        <div class="workflow-grid">
          {workflows.map((flow) => (
            <article class="workflow" data-motion="reveal">
              <div class="workflow-art">
                <span class="mini-chip mini-left">{flow.left}</span>
                <img src={flow.mascot} alt="" width="190" height="176" loading="lazy" decoding="async" />
                <span class="mini-chip mini-right">{flow.right}</span>
              </div>
              <div class="workflow-copy">
                <h3>{flow.title}</h3>
                <p>{flow.copy}</p>
                <div class="workflow-foot">{flow.output}<br />{flow.boundary}</div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <div class="lp-shell directory-content">
    <nav class="intro-links directory-nav" aria-label="Integration directory sections">
      <a class="text-link" href="#app-catalog">{INTEGRATION_CATALOG.length} app entries</a>
      <a class="text-link" href="#mcp-presets">{CURATED_MCP_VENDORS.length} MCP presets</a>
      <a class="text-link" href="#skill-templates">{SKILL_LIBRARY.length} skill templates</a>
      <a class="text-link" href="#directory">Planned tools</a>
    </nav>

    <section id="app-catalog" class="catalog" aria-labelledby="app-catalog-title">
      <div class="catalog-heading"><div><p class="eyebrow">APP DIRECTORY</p><h2 id="app-catalog-title">Tools for your team's work</h2></div><p class="catalog-meta">Catalog entries, not connected accounts. OpenConnector availability depends on your deployment.</p></div>
      <div class="integration-grid">
        {INTEGRATION_CATALOG.map((app) => (
          <article class="integration-card">
            <div class="card-heading"><IntegrationLogos providerKey={app.id} /><h3>{app.name}</h3></div>
            <p class="card-description">{app.summary}</p>
            <div class="card-bottom"><p class="verification">{app.openConnectorServiceIds?.length ? 'OpenConnector catalog mapping · requires service availability and account connection.' : app.kind === 'mcp' ? 'MCP catalog entry · requires server setup and authorization.' : app.kind === 'webhook' ? 'Webhook setup path · configure and verify in your workspace.' : 'Native setup path · verify access in your workspace.'} Not evidence of a live-tested account.</p><a class="docs-link" href={app.docsUrl}>Provider reference <span aria-hidden="true">↗</span></a></div>
          </article>
        ))}
      </div>
    </section>

    <section id="mcp-presets" class="catalog" aria-labelledby="mcp-presets-title">
      <div class="catalog-heading"><div><p class="eyebrow">REMOTE MCP SERVERS</p><h2 id="mcp-presets-title">Bring tools into a task</h2></div><p class="catalog-meta">Curated server presets, not automatic connections. Sign-in depends on deployment and vendor support.</p></div>
      <div class="integration-grid">
        {CURATED_MCP_VENDORS.map((vendor) => (
          <article class="integration-card">
            <div class="card-heading"><IntegrationLogos providerKey={vendor.catalogId} /><h3>{vendor.name}</h3></div>
            <p class="card-description">Configure the {vendor.name} remote MCP preset in your workspace, then authorize the account and tools you want to use.</p>
            <div class="card-bottom"><p class="verification">Requires configuration and a connection test. Sensitive actions still need approval.</p><a class="docs-link" href={vendor.docsUrl}>Server documentation <span aria-hidden="true">↗</span></a></div>
          </article>
        ))}
      </div>
    </section>

    <section id="skill-templates" class="catalog" aria-labelledby="skill-templates-title">
      <div class="catalog-heading"><div><p class="eyebrow">REUSABLE WORKFLOWS</p><h2 id="skill-templates-title">Start with a skill template</h2></div><p class="catalog-meta">Install from the workspace skill library as a draft, review the instructions, then select it for a task. Skills do not connect accounts.</p></div>
      <div class="integration-grid">
        {SKILL_LIBRARY.map((skill) => (
          <article class="integration-card">
            <div class="card-heading"><h3>{skill.name}</h3></div>
            <p class="card-description">{skill.summary}</p>
            <div class="card-bottom"><p class="verification">Draft workflow template · review before use. No automatic execution or publishing.</p><a class="docs-link" href="/docs/skills/">Skill setup guide <span aria-hidden="true">→</span></a></div>
          </article>
        ))}
      </div>
    </section>

    </div>

    <PlannedCatalog />

    <section class="lp-band" aria-labelledby="boundaries-title">
      <div class="lp-shell lp-section trust-grid" data-motion="reveal">
        <div>
          <p class="lp-eyebrow">Connections with boundaries</p>
          <h2 class="lp-h2" id="boundaries-title">The tools can help.<br />You stay in charge.</h2>
          <p class="trust-copy">A role name does not connect an account, grant a permission, or approve a run. Configure only what your installation needs.</p>
          <a class="text-link" href="/docs/security/">Inspect the security model <span aria-hidden="true">↗</span></a>
        </div>
        <div class="trust-list">
          {boundaries.map((item) => (
            <article class="trust-item">
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="cta" aria-labelledby="cta-title">
      <div class="lp-shell" data-motion="reveal">
        <img src="/landing/mascots/custom.svg" alt="" width="130" height="120" loading="lazy" decoding="async" />
        <h2 id="cta-title">Start with one employee.<br />Give it one clear brief.</h2>
        <p>Set up your own workspace, choose a repository, and verify the tools you plan to use. Free software; hosting and model usage cost extra.</p>
        <div class="actions">
          <a class="lp-btn" href="/docs/self-hosting/">Open the self-hosting guide</a>
          <a class="lp-btn lp-btn-secondary" href={repoUrl}>Inspect the source <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
  </div>
</MarketingPage>

<script>
  import { initLandingMotion } from '../lib/landing-motion';
  initLandingMotion();
</script>

<style>

  .directory-content { padding-block: 48px; }
  .directory-nav { display: flex; flex-wrap: wrap; gap: 24px; padding-bottom: 32px; }
  .directory-content a { color: var(--lp-accent); text-underline-offset: 4px; }
  .catalog { padding: 48px 0; border-top: 1px solid var(--lp-line); scroll-margin-top: 100px; }
  .catalog-heading { display: grid; grid-template-columns: 2fr 1fr; gap: 24px; margin-bottom: 28px; align-items: end; }
  .catalog-heading h2 { font-size: clamp(28px, 3vw, 44px); line-height: 1.1; letter-spacing: -.04em; margin: 0; }
  .eyebrow { font: 11px var(--lp-font-mono); letter-spacing: .12em; color: var(--lp-accent); margin: 0 0 16px; }
  .catalog-meta, .card-description, .verification { color: var(--lp-ink2); line-height: 1.65; }
  .catalog-meta { margin: 0; }
  .integration-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .integration-card { display: flex; flex-direction: column; padding: 24px; border: 1px solid var(--lp-line); background: var(--lp-card); }
  .card-heading { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .card-heading h3 { font-size: 21px; line-height: 1.25; margin: 0; }
  .card-description { font-size: 15px; }
  .card-bottom { margin-top: auto; }
  .verification { font-size: 13px; }
  .docs-link { display: flex; justify-content: space-between; align-items: center; min-height: 44px; border-top: 1px solid var(--lp-line); font-size: 13px; }
  @media (max-width: 900px) { .integration-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .catalog-heading { grid-template-columns: 1fr; } }
  @media (max-width: 600px) { .integration-grid { grid-template-columns: 1fr; } }

  .tool-chip { display: flex; align-items: center; gap: 8px; }

  /* Hero */
  .hero { text-align: center; padding-top: 88px; padding-bottom: 64px; }
  .lp-h2 { font-size: 44px; line-height: 1.08; max-width: 720px; }
  .hero h1 { max-width: none; font: 600 clamp(48px, 6.4vw, 88px)/1.02 'Geist', sans-serif; letter-spacing: -.055em; margin: 0 0 24px; color: var(--lp-ink); text-wrap: balance; }
  .accent { color: var(--lp-accent); }
  .hero-copy { max-width: 640px; margin: 0 auto 30px; color: var(--lp-ink2); font-size: 19px; line-height: 1.6; }
  .actions { display: flex; justify-content: center; gap: 18px; flex-wrap: wrap; }
  /* Canvas paper-OS buttons: square edge, hard offset shadow. */
  .actions .lp-btn { border-radius: 0; border: 1.5px solid var(--lp-ink); background: var(--lp-raised); color: var(--lp-ink); box-shadow: -3px 3px 0 var(--lp-ink); font-size: 12px; }
  .actions .lp-btn-primary { background: var(--lp-accent); color: var(--lp-onaccent); border-color: var(--lp-accent); }

  /* Conceptual figure */
  .visual { position: relative; max-width: 1050px; min-height: 410px; margin: 54px auto 20px; border: 2px solid var(--lp-ink); box-shadow: -5px 5px 0 var(--lp-ink); background: var(--lp-card); overflow: hidden; display: flex; align-items: center; justify-content: center; }
  .visual-paper { position: absolute; inset: 0; background-image: radial-gradient(var(--lp-dot) 1px, transparent 1px); background-size: 15px 15px; opacity: .42; }
  .visual-center { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .visual-center img { width: 260px; height: 240px; object-fit: contain; }
  .employee-label { font: 400 27px/1 'Bebas Neue', sans-serif; letter-spacing: .05em; color: var(--lp-ink); }
  .visual-tag { font: 500 10px/1.5 'Geist Mono', monospace; color: var(--lp-ink2); letter-spacing: .08em; text-transform: uppercase; }
  .tool-chip { position: absolute; z-index: 2; display: flex; align-items: center; justify-content: center; min-height: 52px; padding: 10px 18px; background: var(--lp-raised); color: var(--lp-ink); border: 1.5px solid var(--lp-ink); box-shadow: -3px 3px 0 var(--lp-ink); font: 500 13px/1.4 'Geist Mono', monospace; }
  .chip-a { top: 58px; left: 10%; transform: rotate(-5deg); }
  .chip-b { top: 178px; left: 5%; transform: rotate(3deg); }
  .chip-c { bottom: 50px; left: 16%; transform: rotate(-3deg); }
  .chip-d { top: 62px; right: 10%; transform: rotate(4deg); }
  .chip-e { top: 184px; right: 5%; transform: rotate(-4deg); }
  .chip-f { bottom: 48px; right: 14%; transform: rotate(3deg); }
  .caption { max-width: 760px; margin: 22px auto 0; font: 400 12px/1.6 'Geist Mono', monospace; color: var(--lp-ink2); }

  /* Section heads */
  .section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; flex-wrap: wrap; margin-bottom: 36px; }
  .section-head > p { max-width: 390px; margin: 0; font-size: 15px; line-height: 1.6; color: var(--lp-ink2); }

  /* Workflows */
  .workflow-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .workflow { min-width: 0; display: flex; flex-direction: column; background: var(--lp-paper); border: 2px solid var(--lp-ink); box-shadow: -3px 3px 0 var(--lp-ink); }
  .workflow-art { position: relative; min-height: 220px; display: grid; place-items: center; background: var(--lp-panel); border-bottom: 1.5px solid var(--lp-ink); overflow: hidden; }
  .workflow-art img { width: 190px; height: 176px; object-fit: contain; }
  .mini-chip { position: absolute; padding: 6px 9px; border: 1px solid var(--lp-ink); background: var(--lp-raised); color: var(--lp-ink); font: 500 10px/1.5 'Geist Mono', monospace; }
  .mini-left { top: 20px; left: 16px; transform: rotate(-4deg); }
  .mini-right { bottom: 20px; right: 16px; transform: rotate(3deg); }
  .workflow-copy { flex: 1; display: flex; flex-direction: column; padding: 24px; }
  .workflow h3 { font: 400 30px/1.05 'Bebas Neue', sans-serif; letter-spacing: .03em; text-transform: uppercase; margin: 0 0 12px; color: var(--lp-ink); }
  .workflow p { font: 400 13px/1.6 'Geist Mono', monospace; color: var(--lp-ink2); margin: 0 0 20px; }
  .workflow-foot { margin-top: auto; padding-top: 14px; border-top: 1px dashed var(--lp-line2); font: 500 10px/1.6 'Geist Mono', monospace; color: var(--lp-ink2); text-transform: uppercase; letter-spacing: .04em; }

  /* Boundaries */
  .trust-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 72px; }
  .trust-copy { max-width: 440px; font-size: 17px; line-height: 1.6; color: var(--lp-ink2); }
  .text-link { display: inline-flex; align-items: center; min-height: 44px; color: var(--lp-accent); font: 500 12px/1.5 'Geist Mono', monospace; text-decoration: underline; text-underline-offset: 4px; }
  .trust-list { display: flex; flex-direction: column; border-top: 1.5px solid var(--lp-ink); }
  .trust-item { padding: 24px 0; border-bottom: 1px solid var(--lp-line2); }
  .trust-item h3 { margin: 0 0 8px; font: 600 16px/1.5 'Geist', sans-serif; color: var(--lp-ink); }
  .trust-item p { margin: 0; font: 400 13px/1.65 'Geist Mono', monospace; color: var(--lp-ink2); }

  /* Closing CTA */
  .cta { background: var(--lp-ctabg); color: var(--lp-ctafg); text-align: center; padding-block: 80px; }
  .cta img { width: 130px; height: 120px; object-fit: contain; margin: 0 auto 16px; }
  .cta h2 { color: inherit; font: 600 48px/1.08 'Geist', sans-serif; letter-spacing: -.045em; max-width: 680px; margin: 0 auto 20px; text-wrap: balance; }
  .cta p { max-width: 560px; margin: 0 auto 30px; font-size: 16px; line-height: 1.6; opacity: .8; }
  .cta .lp-btn { background: var(--lp-ctafg); color: var(--lp-ctabg); border-color: var(--lp-ctafg); box-shadow: none; }
  .cta .lp-btn-secondary { background: transparent; color: var(--lp-ctafg); }
  .cta .lp-btn:focus-visible { outline-color: var(--lp-ctafg); }

  @media (max-width: 1100px) {
    .workflow-copy { padding: 20px; }
    .trust-grid { gap: 36px; }
    .tool-chip { font-size: 11px; }
    .chip-a, .chip-c { left: 5%; }
    .chip-d, .chip-f { right: 5%; }
    .chip-b { left: 3%; }
    .chip-e { right: 3%; }
  }
  @media (max-width: 700px) {
    .hero { padding-top: 56px; }
    .hero h1 { font-size: 48px; }
    .lp-h2 { font-size: 36px; }
    .hero-copy { font-size: 16px; }
    .visual { min-height: 500px; margin-top: 40px; }
    .visual-center { padding-top: 40px; }
    .visual-center img { width: 210px; height: 194px; }
    .visual-tag { font-size: 10px; }
    .tool-chip { font-size: 10px; min-height: 38px; padding: 8px 10px; }
    .chip-a { top: 24px; left: 5%; }
    .chip-d { top: 28px; right: 5%; }
    .chip-b { top: 82px; left: 3%; }
    .chip-e { top: 86px; right: 3%; }
    .chip-c { bottom: 22px; left: 5%; }
    .chip-f { bottom: 22px; right: 5%; }
    .workflow-grid, .trust-grid { grid-template-columns: 1fr; }
    .workflow-art { min-height: 210px; }
    .cta h2 { font-size: 38px; }
  }
  @media (max-width: 480px) {
    .tool-chip { font-size: 10px; padding-inline: 6px; }
    .section-head { gap: 20px; }
    .cta { padding-block: 60px; }
  }
</style>
