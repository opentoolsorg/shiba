---
import MarketingPage from '../layouts/MarketingPage.astro';
import { integrationGroups, integrations } from '../data/integrations';
import { INTEGRATION_CATALOG } from '../../../../packages/shared/src/integration-catalog';
import { CURATED_MCP_VENDORS } from '../../../../packages/shared/src/curated-mcp-vendors';
import { SKILL_LIBRARY } from '../../../backend/src/skill-library';


---

<MarketingPage
  title="Integrations — Shiba AI Employees"
  description="Connect AI employees to the tools behind your company work, from engineering and design to marketing, sales, operations and finance."
  path="/integrations/"
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Integrations', path: '/integrations/' }]}
>
  <div class="integrations-page">
    <section class="intro" aria-labelledby="integrations-title">
      <div class="intro-copy-block">
      <p class="eyebrow">INTEGRATIONS / YOUR TOOLS, YOUR ACCOUNT</p>
      <h1 id="integrations-title">Connect your team’s work<br />to the tools you use</h1>
      <p class="intro-copy">Browse app integrations, remote MCP server presets, and reusable skills. Choose what your task needs, configure access in your workspace, and review the result.</p>
      <div class="intro-links">
        <a class="primary-link" href="/docs/self-hosting/">Self-host Shiba</a>
        <a class="text-link" href="https://github.com/princepal9120/shiba">Explore the source <span aria-hidden="true">↗</span></a>
      </div>
      </div>
      <aside class="readiness" aria-label="How to read integration status">
        <span class="readiness-mark" aria-hidden="true">i</span>
        <p><strong>Check the setup before you rely on it.</strong> This directory describes supported connections, not the status of your account. Entries marked “Needs live verification” still need a successful test in your installation. See the <a href="/docs/readiness/">readiness guide</a>.</p>
      </aside>
    </section>

    <nav class="intro-links directory-nav" aria-label="Integration directory sections">
      <a class="text-link" href="#app-catalog">{INTEGRATION_CATALOG.length} app entries</a>
      <a class="text-link" href="#mcp-presets">{CURATED_MCP_VENDORS.length} MCP presets</a>
      <a class="text-link" href="#skill-templates">{SKILL_LIBRARY.length} skill templates</a>
      <a class="text-link" href="#catalog-title">Channels &amp; setup</a>
    </nav>

    <section id="app-catalog" class="catalog" aria-labelledby="app-catalog-title">
      <div class="catalog-heading"><div><p class="eyebrow">APP DIRECTORY</p><h2 id="app-catalog-title">Tools for your team's work</h2></div><p class="catalog-meta">Catalog entries, not connected accounts. OpenConnector availability depends on your deployment.</p></div>
      <div class="integration-grid">
        {INTEGRATION_CATALOG.map((app) => (
          <article class="integration-card">
            <div class="card-heading"><h3>{app.name}</h3></div>
            <p class="card-description">{app.summary}</p>
            <div class="card-bottom"><p class="verification">{app.openConnectorServiceIds?.length ? 'OpenConnector catalog mapping · requires service availability and account connection.' : app.kind === 'mcp' ? 'MCP catalog entry · requires server setup and authorization.' : app.kind === 'webhook' ? 'Webhook setup path · configure and verify in your workspace.' : 'Native setup path · verify access in your workspace.'} Not evidence of a live-tested account.</p><a class="docs-link" href={app.docsUrl}>Provider reference <span aria-hidden="true">↗</span></a></div>
          </article>
        ))}
      </div>
    </section>

    <section id="mcp-presets" class="catalog" aria-labelledby="mcp-presets-title">
      <div class="catalog-heading"><div><p class="eyebrow">REMOTE MCP SERVERS</p><h2 id="mcp-presets-title">Bring tools into a task</h2></div><p class="catalog-meta">Curated server presets, not automatic connections. Sign-in depends on deployment and vendor support.</p></div>
      <div class="integration-grid">
        {CURATED_MCP_VENDORS.map((vendor) => (
          <article class="integration-card">
            <div class="card-heading"><h3>{vendor.name}</h3></div>
            <p class="card-description">Configure the {vendor.name} remote MCP preset in your workspace, then authorize the account and tools you want to use.</p>
            <div class="card-bottom"><p class="verification">Requires configuration and a connection test. Sensitive actions still need approval.</p><a class="docs-link" href={vendor.docsUrl}>Server documentation <span aria-hidden="true">↗</span></a></div>
          </article>
        ))}
      </div>
    </section>

    <section id="skill-templates" class="catalog" aria-labelledby="skill-templates-title">
      <div class="catalog-heading"><div><p class="eyebrow">REUSABLE WORKFLOWS</p><h2 id="skill-templates-title">Start with a skill template</h2></div><p class="catalog-meta">Install from the workspace skill library as a draft, review the instructions, then select it for a task. Skills do not connect accounts.</p></div>
      <div class="integration-grid">
        {SKILL_LIBRARY.map((skill) => (
          <article class="integration-card">
            <div class="card-heading"><h3>{skill.name}</h3></div>
            <p class="card-description">{skill.summary}</p>
            <div class="card-bottom"><p class="verification">Draft workflow template · review before use. No automatic execution or publishing.</p><a class="docs-link" href="/docs/skills/">Skill setup guide <span aria-hidden="true">→</span></a></div>
          </article>
        ))}
      </div>
    </section>

    <section class="catalog" aria-labelledby="catalog-title">
      <div class="catalog-heading">
        <div><p class="eyebrow">THE CONNECTION DIRECTORY</p><h2 id="catalog-title">Find your starting point</h2></div>
        <p class="catalog-meta">Find a service, read its status, open the setup guide.</p>
      </div>
      <div class="filters" id="integration-filters" hidden>
        <label class="search-label" for="integration-search"><span class="sr-only">Search connections</span>
          <input id="integration-search" type="search" placeholder="Search connections: GitHub, Slack, approvals" autocomplete="off" />
        </label>
        <div class="filter-buttons" role="group" aria-label="Filter integrations by category">
          <button type="button" data-filter="all" aria-pressed="true">All</button>
          {integrationGroups.map((group) => <button type="button" data-filter={group.id} aria-pressed="false">{group.name}</button>)}
        </div>
      </div>
      <p id="integration-results" class="results" role="status" aria-live="polite" aria-atomic="true">{integrations.length} connections across {integrationGroups.length} categories</p>
      {integrationGroups.map((group, index) => (
        <section class="integration-group" data-group={group.id} aria-labelledby={`group-${group.id}`}>
          <div class="group-heading">
            <span class="section-number" aria-hidden="true">0{index + 1}</span>
            <div><h3 id={`group-${group.id}`}>{group.name}</h3><p>{group.description}</p></div>
          </div>
          <div class="integration-grid">
            {integrations.filter((item) => item.group === group.id).map((item) => (
              <article class="integration-card" data-integration data-category={group.id} data-search={`${item.name} ${item.description} ${item.verification}`.toLowerCase()}>
                <div class="card-heading"><span class={`monogram ${item.logo ? 'brand-chip' : ''}`} aria-hidden="true">{item.logo ? <img src={item.logo} alt="" width="26" height="26" class="monogram-logo" loading="lazy" decoding="async" /> : item.monogram}</span><h4>{item.name}</h4></div>
                <p class="card-description">{item.description}</p>
                <div class="card-bottom">
                  <p class={`status ${item.status === 'Shipped' ? 'is-shipped' : ''}`}><span aria-hidden="true">●</span> {item.status}</p>
                  <a class="docs-link" href={item.docs}>Read docs <span class="sr-only">for {item.name}</span></a>
                </div>
              </article>
            ))}
          </div>
        </section>
      ))}
      <p id="integration-empty" class="empty-state" hidden>No connections match. Try another search or choose All connections.</p>
      <noscript><p class="results">You’re viewing the full directory. Category and search filters are available with JavaScript.</p></noscript>
    </section>

    <section class="catalog" aria-labelledby="workspace-tools-title">
      <div class="catalog-heading"><div><p class="eyebrow">SET UP FOR THE TASK</p><h2 id="workspace-tools-title">Skills, MCP and setup</h2></div><p class="catalog-meta">Connect a service, save instructions, or bring work from another AI app.</p></div>
      <div class="integration-grid">
        <article class="integration-card"><div class="card-heading"><span class="monogram" aria-hidden="true">◇</span><h3>Integrations</h3></div><p class="card-description">Use GitHub for the working repository and a supported chat service to send a brief. Your workspace owner sets up each service before the team can use it.</p><div class="card-bottom"><p class="verification">Available services depend on your installation. Ask the workspace owner if a connection is missing.</p><a class="docs-link" href="/docs/configuration/">Connection setup <span aria-hidden="true">→</span></a></div></article>
        <article class="integration-card"><div class="card-heading"><span class="monogram" aria-hidden="true">▤</span><h3>Saved skills</h3></div><p class="card-description">Save the writing guide, review checklist, or testing notes you reuse. Select those skills when a task needs them.</p><div class="card-bottom"><p class="verification">Skills are saved in this browser. A source link is a reference, not an installed tool.</p><a class="docs-link" href="/docs/skills/">Save a skill <span aria-hidden="true">→</span></a></div></article>
        <article class="integration-card"><div class="card-heading"><span class="monogram" aria-hidden="true">&#123; &#125;</span><h3>MCP clients</h3></div><p class="card-description">Use a supported AI app to request work from Shiba and read the task status. Your workspace owner configures its access.</p><div class="card-bottom"><p class="verification">A client can request a task; it cannot approve the run for you. Test the connection before relying on it.</p><a class="docs-link" href="/docs/mcp/">MCP client setup <span aria-hidden="true">→</span></a></div></article>
      </div>
    </section>

    <section class="approval-note" aria-labelledby="approval-title">
      <div><p class="eyebrow">CONNECTED DOESN’T MEAN AUTHORIZED</p><h2 id="approval-title">A connection is a starting point</h2></div>
      <div>
        <p>A connection brings context into the task. It does not give an employee permission to publish a campaign, update a customer record, or move money. Review the proposed work before approving it.</p>
        <ol>
          <li><strong>Describe the task.</strong> Name the output you want: an account brief, campaign draft, code change, or budget summary from figures you supply. Choose the repository for the work.</li>
          <li><strong>Review the proposal.</strong> Check the task and repository, then approve or reject the exact request before execution.</li>
          <li><strong>Keep the boundary.</strong> Review the returned files and checks. External publishing is a separate action, and automation settings have their own approval rules.</li>
        </ol>
        <a class="text-link" href="/docs/approval-gates/">See how approvals work</a>
      </div>
    </section>

    <section class="closing" aria-labelledby="closing-title">
      <p class="eyebrow">START WITH YOUR OWN ACCOUNT</p>
      <h2 id="closing-title">Your company’s work.<br />Your call to make.</h2>
      <p>Start with one task and a result you can check. Shiba is free to self-host; hosting and model usage cost extra. Follow the setup and readiness guides before relying on a new installation.</p>
      <div class="intro-links"><a class="primary-link" href="/docs/self-hosting/">Open self-hosting guide</a><a class="text-link" href="https://github.com/princepal9120/shiba">View on GitHub <span aria-hidden="true">↗</span></a></div>
    </section>
  </div>
</MarketingPage>

<script>
  const filters = document.querySelector<HTMLElement>('#integration-filters');
  const search = document.querySelector<HTMLInputElement>('#integration-search');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-integration]');
  const groups = document.querySelectorAll<HTMLElement>('[data-group]');
  const results = document.querySelector<HTMLElement>('#integration-results');
  const empty = document.querySelector<HTMLElement>('#integration-empty');
  let category = 'all';
  let announcementTimer: ReturnType<typeof setTimeout>;

  function update() {
    const query = search?.value.trim().toLowerCase() ?? '';
    let count = 0;
    cards.forEach((card) => {
      card.hidden = !(category === 'all' || card.dataset.category === category) || !(card.dataset.search ?? '').includes(query);
      if (!card.hidden) count++;
    });
    groups.forEach((group) => { group.hidden = !group.querySelector('[data-integration]:not([hidden])'); });
    clearTimeout(announcementTimer);
    announcementTimer = setTimeout(() => {
      if (results) results.textContent = `${count} ${count === 1 ? 'connection' : 'connections'} shown`;
    }, 250);
    if (empty) empty.hidden = count !== 0;
  }

  buttons.forEach((button) => button.addEventListener('click', () => {
    category = button.dataset.filter ?? 'all';
    buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
    update();
  }));
  search?.addEventListener('input', update);
  if (filters) filters.hidden = false;
</script>

<style>
  .integrations-page { width: min(100% - 64px, 1440px); margin: 0 auto; color: var(--ink); }
  .eyebrow { font-family: 'Geist Mono', monospace; font-size: 11px; line-height: 1.6; letter-spacing: .12em; color: var(--navy); margin: 0 0 20px; }
  .intro { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(280px, .7fr); align-items: end; gap: clamp(40px, 8vw, 128px); padding: 96px 0 72px; }
  h1 { max-width: 900px; font-size: clamp(48px, 5.5vw, 76px); line-height: 1.02; letter-spacing: -.055em; font-weight: 500; margin: 0 0 28px; text-wrap: pretty; }
  .intro-copy { max-width: 680px; font-size: 19px; line-height: 1.65; color: var(--ink-2); }
  .intro-aside { border-top: 1px solid var(--line-2); padding-top: 20px; }
  .aside-label { color: var(--ink-2); font: 11px/1.5 'Geist Mono', monospace; letter-spacing: .1em; margin: 0 0 16px; }
  .tool-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .tool-chips span { display: inline-flex; align-items: center; min-height: 36px; padding: 0 12px; border: 1px solid var(--line-2); background: var(--card); font-size: 12px; font-weight: 600; }
  .aside-note { color: var(--ink-2); font-size: 13px; line-height: 1.7; margin: 18px 0 12px; }
  .intro-aside > a { color: var(--navy); font-size: 13px; font-weight: 600; text-decoration: underline; text-underline-offset: 4px; }
  .intro-links { display: flex; gap: 24px; flex-wrap: wrap; align-items: center; margin-top: 30px; }
  .primary-link, .text-link { display: inline-flex; align-items: center; justify-content: center; gap: 16px; min-height: 48px; font-size: 14px; font-weight: 600; }
  .primary-link { background: var(--navy); color: var(--on-accent); border: 1px solid var(--navy); padding: 10px 20px; }
  .primary-link:hover { background: var(--navy-2); }
  .text-link { color: var(--navy); text-decoration: underline; text-underline-offset: 5px; }
  a:focus-visible, button:focus-visible, input:focus-visible { outline: 3px solid var(--navy); outline-offset: 4px; }
  .readiness { display: flex; align-items: flex-start; gap: 16px; border: 1px solid var(--line-2); background: var(--panel-2); padding: 20px 24px; margin-top: 52px; }
  .readiness-mark { display: grid; place-items: center; flex: 0 0 24px; height: 24px; border: 1px solid var(--ink-2); border-radius: var(--r-sm); font: 13px/1 'Geist Mono', monospace; color: var(--ink-2); }
  .readiness, .integration-card, .empty-state { border-radius: var(--r-md); box-shadow: var(--shadow-soft); }
  .primary-link, .filter-buttons button, .monogram, .status { border-radius: var(--r-sm); }
  .primary-link { box-shadow: var(--shadow-soft); }
  .readiness p { margin: 0; font-size: 14px; line-height: 1.75; color: var(--ink-2); }
  .readiness strong { color: var(--ink); }
  .readiness a { color: var(--navy); text-decoration: underline; text-underline-offset: 3px; }
  .directory-nav { padding-bottom: 32px; flex-wrap: wrap; }
  section[id] { scroll-margin-top: 100px; }
  .catalog { padding: 48px 0 80px; border-top: 1px solid var(--line-2); }
  .catalog-heading { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; margin-bottom: 28px; }
  .catalog-heading .eyebrow { margin-bottom: 10px; }
  h2 { font-size: clamp(28px, 3vw, 38px); font-weight: 500; letter-spacing: -.035em; line-height: 1.2; margin: 0; }
  .catalog-meta { color: var(--ink-2); max-width: 230px; font-size: 13px; line-height: 1.65; margin: 0; }
  .filters { position: sticky; top: 0; z-index: 5; padding: 16px 0; border-block: 1px solid var(--line-2); background: var(--paper); }
  .filter-buttons { display: flex; flex-wrap: wrap; gap: 8px; }
  .filter-buttons button { min-height: 44px; padding: 10px 14px; border: 1px solid var(--input-line); background: var(--card); color: var(--ink); font: inherit; font-size: 13px; cursor: pointer; }
  .filter-buttons button[aria-pressed='true'] { background: var(--navy); border-color: var(--navy); color: var(--on-accent); }
  .search-label { display: flex; align-items: center; gap: 16px; color: var(--ink-2); font-size: 13px; margin-top: 16px; }
  input { width: min(100%, 340px); min-height: 44px; background: var(--card); color: var(--ink); border: 1px solid var(--input-line); padding: 10px 14px; border-radius: var(--r-sm); font: inherit; }
  input::placeholder { color: var(--ink-2); opacity: 1; }
  .results { font-family: 'Geist Mono', monospace; font-size: 11px; line-height: 1.7; color: var(--ink-2); margin: 18px 0 32px; }
  .integration-group { margin-bottom: 56px; scroll-margin-top: 100px; }
  .group-heading { display: flex; gap: 16px; margin-bottom: 20px; align-items: flex-start; }
  .section-number { color: var(--navy); font: 12px/2 'Geist Mono', monospace; }
  h3 { font-size: 22px; line-height: 1.3; font-weight: 500; letter-spacing: -.025em; margin: 0 0 6px; }
  .group-heading p { font-size: 14px; line-height: 1.6; color: var(--ink-2); margin: 0; }
  .integration-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  .integration-card { display: flex; flex-direction: column; min-width: 0; background: var(--card); border: 1px solid var(--line-2); padding: 22px; transition: border-color 160ms ease, transform 160ms ease; }
  @media (hover: hover) { .integration-card:hover { border-color: var(--navy); transform: translateY(-2px); } }
  .card-heading { display: flex; align-items: center; gap: 14px; margin-bottom: 18px; }
  .monogram { display: grid; place-items: center; flex: 0 0 44px; height: 44px; background: var(--panel-2); border: 1px solid var(--line-2); color: var(--navy); font: 15px 'Geist Mono', monospace; }
  .monogram.brand-chip, .brand-chip { background: #ffffff !important; }
  .monogram-logo { width: 26px; height: 26px; object-fit: contain; }
  h4 { font-size: 17px; font-weight: 600; letter-spacing: -.025em; line-height: 1.3; margin: 0; }
  .card-description { font-size: 14px; line-height: 1.7; color: var(--ink-2); margin: 0 0 24px; }
  .card-bottom { margin-top: auto; }
  .status { font: 10px/1.7 'Geist Mono', monospace; color: var(--ink); margin: 0 0 8px; }
  .status span { color: var(--navy); }
  .verification { font-size: 12px; line-height: 1.65; color: var(--ink-2); margin: 0; }
  .docs-link { display: flex; align-items: center; justify-content: space-between; min-height: 44px; margin-top: 16px; border-top: 1px solid var(--line); padding-top: 10px; font-size: 13px; font-weight: 600; color: var(--navy); }
  .docs-link:hover { text-decoration: underline; text-underline-offset: 4px; }
  [hidden] { display: none !important; }
  .empty-state { background: var(--panel-2); border: 1px solid var(--line-2); color: var(--ink); padding: 32px; font-size: 16px; }
  .approval-note { display: grid; grid-template-columns: 1fr 1.3fr; gap: 64px; padding: 48px 0; border-block: 1px solid var(--line-2); }
  .approval-note p, .approval-note li { color: var(--ink-2); font-size: 15px; line-height: 1.8; }
  .approval-note p:first-child { margin-top: 0; }
  .approval-note .eyebrow { font-size: 11px; color: var(--navy); }
  .approval-note ol { list-style: decimal; padding-left: 20px; margin: 20px 0; }
  .approval-note li { padding-left: 8px; margin-bottom: 12px; }
  .approval-note strong { color: var(--ink); font-weight: 600; }
  .closing { padding: 80px 0 96px; }
  .closing h2 { font-size: clamp(36px, 5vw, 58px); letter-spacing: -.045em; }
  .closing > p:not(.eyebrow) { font-size: 16px; line-height: 1.7; color: var(--ink-2); max-width: 520px; margin-top: 24px; }
  @media (max-width: 1100px) { .integration-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 900px) { .intro { grid-template-columns: 1fr; gap: 40px; } .intro-aside { max-width: 560px; } .integration-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .approval-note { gap: 32px; } }
  @media (max-width: 600px) {
    .integrations-page { width: calc(100% - 40px); }
    .intro { display: block; padding: 56px 0 48px; }
    .intro-aside { margin-top: 44px; }
    .intro-copy { font-size: 17px; }
    .readiness { padding: 18px; margin-top: 36px; }
    .catalog-heading { display: block; }
    .catalog-meta { margin-top: 16px; max-width: none; }
    .search-label { align-items: stretch; flex-direction: column; gap: 8px; }
    input { width: 100%; }
    .integration-grid, .approval-note { grid-template-columns: 1fr; }
    .integration-card { padding: 22px; }
    .closing { padding-block: 56px; }
  }
  @media (prefers-reduced-motion: reduce) { .integration-card { transition: none; } }

  /* competitor-informed: centered hero, search-first directory, compact tiles */
  .intro { display: block; text-align: center; padding: 80px 0 40px; }
  .intro-copy-block { display: flex; flex-direction: column; align-items: center; }
  h1 { max-width: 760px; font-size: clamp(40px, 5vw, 64px); }
  .intro-copy { max-width: 560px; font-size: 18px; }
  .intro .intro-links { justify-content: center; }
  .readiness { max-width: 720px; margin: 40px auto 0; text-align: left; }
  .catalog { padding: 40px 0 64px; }
  #catalog-title { text-align: center; }
  .catalog:has(#catalog-title) > .catalog-heading { display: block; text-align: center; }
  .catalog:has(#catalog-title) .catalog-meta { max-width: none; margin: 12px auto 28px; }
  .filters { position: static; border: 0; background: none; padding: 0 0 8px; display: grid; gap: 14px; justify-items: center; }
  .search-label { width: 100%; max-width: 640px; margin: 0; }
  .search-label input { width: 100%; min-height: 56px; font-size: 16px; padding: 14px 20px; border-radius: 999px; box-shadow: var(--shadow-soft); }
  .filter-buttons { justify-content: center; }
  .filter-buttons button { border-radius: 999px; min-height: 40px; padding: 8px 16px; }
  .results { text-align: center; margin: 12px 0 36px; }
  .integration-grid { gap: 12px; }
  .integration-card { padding: 18px; }
  .card-heading { margin-bottom: 12px; }
  .monogram { flex-basis: 40px; height: 40px; }
  .card-description { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; margin-bottom: 16px; font-size: 13.5px; line-height: 1.6; }
  .status { display: inline-flex; align-items: center; gap: 6px; padding: 3px 9px; border: 1px solid var(--line-2); border-radius: 999px; font-size: 10px; color: var(--ink-2); }
  .status span { color: var(--ink-2); font-size: 8px; }
  .status.is-shipped span { color: #2e9e5b; }
  .docs-link { margin-top: 12px; }
</style>
