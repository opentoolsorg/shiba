---
import MarketingPage from '../../layouts/MarketingPage.astro';
import { CATEGORY_LABEL, PATTERN_LABEL, getPublishedPosts, readingTime } from '../../lib/journal';

const posts = await getPublishedPosts();

// Only surface categories that have at least one post. A filter chip that
// leads to an empty page is a dead link, and the build's link check would
// (correctly) fail on it.
const CATEGORIES = (['guide', 'journal', 'note'] as const).filter((c) =>
	posts.some((p) => p.data.category === c),
);

const fmt = (d: Date) =>
	d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });

const collectionSchema = {
	'@context': 'https://schema.org',
	'@type': 'Blog',
	name: 'Shiba Journal',
	description:
		'Notes on building AI employees for company work, with clear briefs, approval, and results to review.',
	url: 'https://tryshiba.dev/blog/',
	blogPost: posts.map((p) => ({
		'@type': 'BlogPosting',
		headline: p.data.title,
		url: 'https://tryshiba.dev/blog/' + p.id + '/',
		datePublished: p.data.pubDate.toISOString(),
	})),
};
---

<MarketingPage
	title="Journal — Shiba"
	description="Notes on building AI employees for company work—from engineering and design to marketing, sales, operations, finance and revenue planning."
	path="/blog/"
	schema={collectionSchema}
	breadcrumbs={[
		{ name: 'Home', path: '/' },
		{ name: 'Journal', path: '/blog/' },
	]}
>
	<div class="shell">
		<header class="blog-index-hero">
			<div class="micro">Journal</div>
			<h1>Building an AI team,<br />one useful task at a time</h1>
			<p class="blog-lede">
				Shiba is being built for the work behind a company: product and code, marketing
				and sales, operations and finance. This journal shares the decisions, experiments,
				and lessons behind it. Older articles reflect the product at the time they were written.
			</p>
			<ul class="blog-filters">
				<li>
					<a class="blog-filter" href="/blog/" aria-current="true">
						<span>All</span>
						<span class="blog-filter-count">{posts.length}</span>
					</a>
				</li>
				{CATEGORIES.map((c) => (
					<li>
						<a class="blog-filter" href={`/blog/category/${c}/`}>
							<span>{CATEGORY_LABEL[c]}</span>
							<span class="blog-filter-count">
								{posts.filter((p) => p.data.category === c).length}
							</span>
						</a>
					</li>
				))}
				<li>
					<a class="blog-filter" href="/blog/rss.xml">
						<span>RSS</span>
					</a>
				</li>
			</ul>
			<figure class="blog-hero-media">
				<img
					class="blog-hero-window"
					src="/blog/journal-header.png"
					alt="Retro OS window floating in a dark void, holding a glass terminal console with holographic code panels"
					width="1672"
					height="941"
					loading="eager"
				/>
				<img
					class="blog-hero-side"
					src="/blog/journal-side.gif"
					alt="Pixel-art workstation of two CRT monitors on a network node"
					width="1254"
					height="1254"
					loading="lazy"
				/>
			</figure>
		</header>

		{posts.length === 0 ? (
			<div class="blog-empty">
				<h2>No posts published yet</h2>
				<p>
					The first entries are being written. In the meantime, the docs
					can help you start a task and review its result.
				</p>
				<a class="button" href="/docs/overview/">
					<span>Read the docs</span>
					<span aria-hidden="true">→</span>
				</a>
			</div>
		) : (
			<ul class="post-list">
				{posts.map((post) => (
					<li class="post-row">
						<a class="post-card" href={`/blog/${post.id}/`}>
							<span class="post-card-rail">
								<span class="post-card-date">
									<time datetime={post.data.pubDate.toISOString().slice(0, 10)}>
										{fmt(post.data.pubDate)}
									</time>
								</span>
								<span class="post-card-read">{readingTime(post.body)} min read</span>
							</span>
							<span>
								<span class="post-card-title">{post.data.title}</span>
								<span class="post-card-summary">{post.data.summary}</span>
								<span class="post-card-tags">
									<span class="chip chip-accent">{CATEGORY_LABEL[post.data.category]}</span>
									<span class="chip">{PATTERN_LABEL[post.data.pattern]}</span>
								</span>
								<span class="post-card-more">
									<span>Read</span>
									<span aria-hidden="true">→</span>
								</span>
							</span>
						</a>
					</li>
				))}
			</ul>
		)}
	</div>
</MarketingPage>
