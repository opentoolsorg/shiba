---
import MarketingPage from '../layouts/MarketingPage.astro';

const waitlistSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Join the Shiba Waitlist & Open Source Contributor Community',
  description:
    'Join the Shiba community for project release updates, early deployment feedback, and open-source contributor invitations. Self-hosting requires no invite code.',
  url: 'https://tryshiba.dev/waitlist/',
  potentialAction: {
    '@type': 'CommunicateAction',
    target: 'https://tryshiba.dev/api/waitlist',
  },
};
---

<MarketingPage
  title="Join the Waitlist & Community — Shiba"
  description="Sign up for Shiba project updates, early deployment feedback, and open-source contributor invitations. Run approval-gated coding agents in your own Cloudflare account."
  path="/waitlist/"
  type="website"
  schema={waitlistSchema}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Join & Contribute', path: '/waitlist/' },
  ]}
>
  <!-- TOP INTRO HERO -->
  <section class="shell hero-grid">
    <!-- LEFT: INVITATION & VALUE -->
    <div class="intro-pane" aria-labelledby="waitlist-title">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-[var(--card)] border border-[var(--line-2)] text-[10px] font-mono uppercase tracking-[0.14em] text-[var(--navy)] mb-6 shadow-[2px_2px_0_var(--paper-shadow)]">
        <span class="w-2 h-2 bg-[var(--navy)]" aria-hidden="true"></span>
        <span>OPEN SOURCE · CLOUDFLARE NATIVE</span>
      </div>

      <h1 id="waitlist-title" class="manifesto-title text-[var(--ink)]">
        The next coding coworker is <span class="text-[var(--navy)]">built in the open.</span>
      </h1>

      <p class="lead text-base sm:text-lg text-[var(--ink-2)] leading-relaxed mb-6">
        Shiba is completely open source under AGPL-3.0-only. You do not need an invitation or license key to self-host it on Cloudflare.
        Sign up here to receive project release announcements, setup walkthroughs, and contributor invitations.
      </p>

      <div class="truth-box">
        <div class="text-[var(--navy)] text-xl font-bold" aria-hidden="true">✦</div>
        <div>
          <h2 class="text-[var(--ink)] font-bold text-sm mb-1">Why join this list?</h2>
          <p class="text-[var(--ink-2)] text-xs leading-relaxed">
            Get notified of major releases and contributor invitations. Shiba is free software; this list is purely for updates and community participation.
          </p>
        </div>
      </div>

      <!-- WAYS TO FOLLOW -->
      <div class="mt-8 pt-6 border-t border-[var(--line)] space-y-3 font-mono text-xs">
        <div class="text-[var(--navy)] uppercase tracking-wider font-bold text-[11px]">Ways to follow the project</div>
        <div class="flex flex-wrap gap-3">
          <a href="https://github.com/princepal9120/shiba" target="_blank" rel="noopener noreferrer" class="watch-link">
            <span>⭐ Star on GitHub</span>
            <span class="text-[var(--navy)]" aria-hidden="true">↗</span>
          </a>
          <a href="/why-shiba/" class="watch-link">
            <span>Why I Built Shiba</span>
            <span class="text-[var(--navy)]" aria-hidden="true">→</span>
          </a>
          <a href="/open-source-devin-alternative/" class="watch-link">
            <span>Devin Alternative Guide</span>
            <span class="text-[var(--navy)]" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>

    <!-- RIGHT: INTERACTIVE FORM CARD -->
    <div class="form-pane">
      <div class="form-card" aria-labelledby="form-heading">
        <div class="flex items-center justify-between border-b border-[var(--line)] pb-4 mb-6">
          <div>
            <span class="text-[var(--navy)] font-mono text-[10px] font-medium uppercase tracking-[0.14em]">Project Updates &amp; Community</span>
            <h2 id="form-heading" class="text-2xl sm:text-3xl text-[var(--ink)] font-bold tracking-tight mt-1">Join the community.</h2>
          </div>
          <span class="w-2.5 h-2.5 bg-[var(--navy)] shadow-[0_0_10px_var(--navy)]" aria-hidden="true"></span>
        </div>

        <noscript>
          <div class="p-3 bg-[var(--panel-2)] border border-[var(--danger)] text-[var(--danger)] text-xs mb-4 font-mono">
            Please enable JavaScript in your browser to submit this form directly to the Cloudflare Worker API.
          </div>
        </noscript>

        <form id="waitlist-form" method="post" action="/api/waitlist" class="space-y-4 font-mono text-xs">
          <div>
            <label for="email" class="block text-[10px] uppercase tracking-[0.12em] font-medium text-[var(--ink)] mb-1.5">
              Work or Personal Email <span class="text-[var(--navy)]">*</span>
            </label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder="alex@company.com"
              maxlength="254"
              required
              class="w-full bg-[var(--card)] border border-[var(--input-line)] px-3.5 py-3 text-[var(--ink)] placeholder:text-[var(--ink-2)] focus:border-[var(--navy)] focus:outline-none transition-colors"
            />
          </div>

          <div>
            <label for="interest" class="block text-[10px] uppercase tracking-[0.12em] font-medium text-[var(--ink)] mb-1.5">
              Primary Interest <span class="text-[var(--navy)]">*</span>
            </label>
            <select
              id="interest"
              name="interest"
              required
              class="w-full bg-[var(--card)] border border-[var(--input-line)] px-3.5 py-3 text-[var(--ink)] focus:border-[var(--navy)] focus:outline-none transition-colors"
            >
              <option value="" disabled selected>Select an option</option>
              <option value="early-access">Deploy Shiba on Cloudflare &amp; share feedback</option>
              <option value="contribute">Open Source Contributor (Code, Docs, Tests, Design)</option>
              <option value="both">Both deploy and contribute</option>
            </select>
          </div>

          <div>
            <label for="github" class="block text-[10px] uppercase tracking-[0.12em] font-medium text-[var(--ink)] mb-1.5">
              GitHub Username <span class="text-[var(--ink-2)] font-normal">(optional, for contributor recognition)</span>
            </label>
            <div class="field-wrap flex items-center bg-[var(--card)] border border-[var(--input-line)] px-3.5 py-2.5 focus-within:border-[var(--navy)] transition-colors">
              <span class="text-[var(--navy)] mr-1.5" aria-hidden="true">@</span>
              <input
                id="github"
                name="github"
                type="text"
                autocomplete="off"
                placeholder="username"
                maxlength="39"
                pattern="[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?"
                class="w-full bg-transparent text-[var(--ink)] placeholder:text-[var(--ink-2)] focus:outline-none"
              />
            </div>
          </div>

          <!-- Hidden Honeypot for Bot Mitigation -->
          <div class="hidden" aria-hidden="true">
            <label for="company">Company URL</label>
            <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="pt-2">
            <label class="consent flex items-start gap-2.5 cursor-pointer text-[11px] text-[var(--ink-2)] leading-relaxed">
              <input
                type="checkbox"
                name="consent"
                required
                class="mt-0.5 bg-[var(--card)] border-[var(--line-2)] text-[var(--navy)] focus:ring-0 focus:ring-offset-0"
              />
              <span>Send me Shiba project updates and contributor invitations. We respect your privacy: your email is never sold or shared.</span>
            </label>
          </div>

          <button
            type="submit"
            class="button w-full justify-center text-sm py-3.5 mt-2"
          >
            <span>Submit Registration →</span>
          </button>

          <div id="form-status" role="status" aria-live="polite" class="min-h-[28px] text-center text-xs font-mono font-bold text-[var(--navy)]"></div>
        </form>

        <div class="border-t border-[var(--line)] pt-4 mt-4 text-[11px] text-[var(--ink-2)] leading-relaxed font-mono">
          Privacy note: Registrations are stored privately in a dedicated Cloudflare Durable Object SQLite table. Rate-limited at edge with cryptographic IP hash buckets.
        </div>
      </div>
    </div>
  </section>

  <!-- CONTRIBUTOR TRACKS SECTION -->
  <section class="shell mt-24 pt-16 border-t border-[var(--line)]" aria-labelledby="contribute-heading">
    <div class="max-w-2xl mb-12">
      <span class="micro">COMMUNITY SPRINT</span>
      <h2 id="contribute-heading" class="text-3xl sm:text-4xl font-bold text-[var(--ink)] tracking-tight mt-2 mb-4">
        Where we welcome contributions
      </h2>
      <p class="text-[var(--ink-2)] text-sm leading-relaxed">
        Whether you specialize in distributed edge systems, Docker containers, modern React frontends, or technical documentation, there are high-impact issues open for you.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="contrib-card">
        <div>
          <div class="contrib-icon" aria-hidden="true">01</div>
          <h3 class="text-base font-bold text-[var(--ink)] mb-2">Edge Orchestration</h3>
          <p class="text-xs text-[var(--ink-2)] leading-relaxed mb-4">
            Improve TypeScript planning agents, durable tool execution loops, Claude Code / OpenCode harnesses, and task queuing logic.
          </p>
        </div>
        <a href="https://github.com/princepal9120/shiba/tree/main/apps/backend" target="_blank" rel="noopener noreferrer" class="contrib-cta">
          <span>Backend Code</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="contrib-card">
        <div>
          <div class="contrib-icon" aria-hidden="true">02</div>
          <h3 class="text-base font-bold text-[var(--ink)] mb-2">Sandbox Containers</h3>
          <p class="text-xs text-[var(--ink-2)] leading-relaxed mb-4">
            Optimize container startup time, pre-configure dev toolchains, and test egress proxy TLS credential interception.
          </p>
        </div>
        <a href="https://github.com/princepal9120/shiba/blob/main/apps/backend/Dockerfile" target="_blank" rel="noopener noreferrer" class="contrib-cta">
          <span>Dockerfile Spec</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="contrib-card">
        <div>
          <div class="contrib-icon" aria-hidden="true">03</div>
          <h3 class="text-base font-bold text-[var(--ink)] mb-2">Web Dashboard</h3>
          <p class="text-xs text-[var(--ink-2)] leading-relaxed mb-4">
            Refine the real-time WebSocket diff viewer, terminal emulator, memory explorer, and mobile responsive controls.
          </p>
        </div>
        <a href="https://github.com/princepal9120/shiba/tree/main/apps/frontend" target="_blank" rel="noopener noreferrer" class="contrib-cta">
          <span>Frontend Source</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="contrib-card">
        <div>
          <div class="contrib-icon" aria-hidden="true">04</div>
          <h3 class="text-base font-bold text-[var(--ink)] mb-2">Docs &amp; Recipes</h3>
          <p class="text-xs text-[var(--ink-2)] leading-relaxed mb-4">
            Write guides for Cloudflare deployment, Slack bot pairing, GitHub App webhooks, and custom BYOK model configurations.
          </p>
        </div>
        <a href="/docs/contributing/" class="contrib-cta">
          <span>Contributor Guide</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <!-- QUICK GITHUB JUMP -->
    <div class="mt-12 p-6 bg-[var(--card)] border border-[var(--line-2)] flex flex-col sm:flex-row items-center justify-between gap-6 shadow-[2px_2px_0_var(--paper-shadow)]">
      <div class="space-y-1">
        <h3 class="text-[var(--ink)] font-bold text-base">Ready to submit a pull request?</h3>
        <p class="text-[var(--ink-2)] text-xs">Explore open issues labeled <code>good first issue</code> or participate in architecture discussions.</p>
      </div>
      <div class="flex items-center gap-3 shrink-0 font-mono text-xs">
        <a href="https://github.com/princepal9120/shiba/issues" target="_blank" rel="noopener noreferrer" class="button">
          <span>Browse GitHub Issues ↗</span>
        </a>
      </div>
    </div>
  </section>
</MarketingPage>

<script>
  const form = document.querySelector<HTMLFormElement>('#waitlist-form');
  const status = document.querySelector<HTMLElement>('#form-status');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status || !form) return;

    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const data = new FormData(form);

    status.textContent = 'Joining the list…';
    status.className = 'min-h-[28px] text-center text-xs font-mono font-bold text-[var(--navy)]';
    if (button) button.disabled = true;

    try {
      const response = await fetch('/api/waitlist', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: data.get('email'),
          interest: data.get('interest'),
          github: data.get('github'),
          company: data.get('company'),
          consent: data.get('consent') === 'on',
        }),
      });

      const result = await response.json().catch(() => ({}));
      if (!response.ok) {
        throw new Error(result.error ?? 'Could not save your registration. Please try again.');
      }

      status.textContent = result.alreadyJoined
        ? "✓ You're already registered! Thank you for supporting Shiba."
        : "✓ You're in! Thank you for supporting open-source development.";
      status.className = 'min-h-[28px] text-center text-xs font-mono font-bold status-ok p-2 bg-[var(--card)] border border-[var(--line-2)]';
      form.reset();
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : 'Registration failed. Please check your connection and try again.';
      status.className = 'min-h-[28px] text-center text-xs font-mono font-bold status-err p-2 bg-[var(--card)] border border-[var(--line-2)]';
      if (button) button.disabled = false;
    }
  });
</script>

<style>
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(360px, 0.9fr);
    gap: clamp(40px, 6vw, 80px);
    padding-top: clamp(60px, 8vw, 100px);
    align-items: start;
  }
  .manifesto-title {
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: clamp(2rem, 4.5vw, 3.8rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 24px;
  }
  .truth-box {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 18px 20px;
    background: var(--card);
    border: 1px solid var(--line-2);
    box-shadow: 2px 2px 0 var(--paper-shadow);
    max-width: 620px;
  }
  .truth-box h2 {
    font-family: 'Geist', sans-serif;
  }
  .watch-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 8px 14px;
    background: var(--card);
    border: 1px solid var(--line-2);
    color: var(--ink);
    box-shadow: 2px 2px 0 var(--paper-shadow);
    transition: border-color 160ms ease, color 160ms ease, transform var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .watch-link:hover {
      border-color: var(--navy);
      color: var(--navy);
      transform: translateY(-1px);
    }
    .contrib-card:hover { border-color: var(--navy); box-shadow: 3px 3px 0 var(--paper-shadow); }
    .contrib-cta:hover { color: var(--navy-2); }
  }
  .form-card {
    background: var(--card);
    border: 1px solid var(--line-2);
    padding: clamp(24px, 4vw, 36px);
    box-shadow: 3px 3px 0 var(--paper-shadow);
  }
  .form-card h2 {
    font-family: 'Instrument Serif', Georgia, serif;
  }
  .contrib-card {
    background: var(--card);
    border: 1px solid var(--line-2);
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 2px 2px 0 var(--paper-shadow);
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }
  .contrib-icon {
    width: 32px;
    height: 32px;
    background: var(--panel-2);
    border: 1px solid var(--line-2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Geist Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 16px;
  }
  .contrib-cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    font-family: 'Geist Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    color: var(--navy);
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }
  #waitlist-form :is(input:not([type='checkbox']), select, textarea) {
    font-size: 16px;
    min-height: 44px;
    transition: border-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
  }
  #waitlist-form > div > :is(input, select):focus-visible,
  #waitlist-form .field-wrap:focus-within {
    outline: 2px solid var(--navy);
    outline-offset: 2px;
    border-color: var(--navy);
  }
  #waitlist-form .field-wrap { min-height: 44px; padding-block: 0; }
  #waitlist-form .field-wrap input { min-height: 42px; }
  #waitlist-form .field-wrap input:focus-visible { outline: none; }
  #waitlist-form :is(input, select):user-invalid { border-color: var(--danger); }
  #waitlist-form .consent {
    min-height: 44px;
    padding-block: 4px;
    -webkit-user-select: none;
    user-select: none;
  }
  #waitlist-form .consent input {
    flex: none;
    width: 20px;
    height: 20px;
    margin-top: 1px;
    accent-color: var(--navy);
    cursor: pointer;
  }
  #waitlist-form .consent input:focus-visible { outline: 2px solid var(--navy); outline-offset: 2px; }
  #waitlist-form button[type='submit'] { min-height: 48px; }
  .watch-link:active { transform: translate(1px, 1px); box-shadow: 1px 1px 0 var(--paper-shadow); }
  @media (prefers-reduced-motion: reduce) {
    .watch-link, .contrib-card, #waitlist-form :is(input, select) { transition: none; }
    .watch-link:hover, .watch-link:active { transform: none; }
  }
  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
</style>
