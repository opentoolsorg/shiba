---
import '../styles/tailwind.css';
// design.md tokens (--paper, --navy, --ink, …) are declared in this layout's
// scoped <style>, so descendants need the shared sheet imported here rather
// than per-page — a page-level import would compile but resolve to no tokens.
import '../styles/blog.css';

interface Props {
  title: string;
  description: string;
  path: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
  breadcrumbs?: Array<{ name: string; path: string }>;
  /** Overrides the default Open Graph card for this page. */
  ogImage?: string;
  noindex?: boolean;
}
const {
  title,
  description,
  path,
  type = 'website',
  publishedTime,
  modifiedTime,
  schema,
  breadcrumbs = [{ name: 'Home', path: '/' }],
  ogImage = '/assets/og/shiba-og.png',
  noindex = false,
} = Astro.props;
const morePage = [{ path: '/network/', label: 'Network' }, { path: '/docs/costs/', label: 'Cost' }, { path: '/blog/', label: 'Journal' }, { path: '/docs/architecture/', label: 'Architecture' }, { path: '/docs/security/', label: 'Security' }].find(item => path === item.path || (item.path === '/blog/' && path.startsWith('/blog/')));
const canonical = new URL(path, 'https://tryshiba.dev').href;
const ogImageUrl = new URL(ogImage, 'https://tryshiba.dev').href;
// Organization logo must be square; the 1200x630 OG banner is rejected by Google.
const logoUrl = 'https://tryshiba.dev/assets/mascot/shiba-logo-512.png';
const author = { '@type': 'Person', name: 'Prince Pal', sameAs: ['https://github.com/princepal9120'] };

const defaultSchemas: Array<Record<string, unknown>> = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Shiba',
    url: 'https://tryshiba.dev/',
    logo: { '@type': 'ImageObject', url: logoUrl, width: 512, height: 512 },
    founder: author,
    sameAs: ['https://github.com/princepal9120/shiba', 'https://github.com/princepal9120'],
  },
];

if (breadcrumbs && breadcrumbs.length > 1) {
  defaultSchemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((crumb, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: crumb.name,
      item: new URL(crumb.path, 'https://tryshiba.dev').href,
    })),
  });
}

const finalSchemas = schema
  ? [...defaultSchemas, ...(Array.isArray(schema) ? schema : [schema])]
  : defaultSchemas;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap.xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="author" content="Prince Pal" />
    <meta name="theme-color" content="#f6f4ed" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#191a18" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Shiba" />
    <meta property="og:locale" content="en_US" />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="Shiba: It asks before it writes code. A self-hosted AI software engineer on Cloudflare." />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content="Shiba: It asks before it writes code. A self-hosted AI software engineer on Cloudflare." />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Preconnect Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />

    <!-- Structured Data (JSON-LD) -->
    {finalSchemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    <!-- Instant Theme Initializer (No FOIT) -->
    <script is:inline>
      (function() {
        var stored;
        try { stored = localStorage.getItem('shiba-theme'); } catch (_) {}
        var manual = stored === 'light' || stored === 'dark';
        var root = document.documentElement;
        root.classList.add('nav-js');
        root.dataset.themePreference = manual ? 'manual' : 'system';
        var systemTheme = matchMedia('(prefers-color-scheme: dark)');
        function applyTheme() {
          var theme = root.dataset.themePreference === 'system' ? (systemTheme.matches ? 'dark' : 'light') : stored;
          root.dataset.theme = theme;
          document.querySelectorAll('meta[name="theme-color"]').forEach(function(meta) {
            meta.setAttribute('content', theme === 'dark' ? '#191a18' : '#f6f4ed');
          });
          document.querySelectorAll('source[data-theme-source]').forEach(function(source) {
            source.media = theme === 'dark' ? 'all' : 'not all';
          });
          var btn = document.getElementById('theme-toggle-btn');
          if (btn) {
            var preference = root.dataset.themePreference === 'system' ? 'system' : theme;
            var next = preference === 'system' ? 'light' : preference === 'light' ? 'dark' : 'system';
            var label = 'Theme: ' + preference + '. Switch to ' + next + ' theme';
            btn.setAttribute('aria-label', label);
            btn.setAttribute('title', label);
            btn.hidden = false;
          }
        }
        applyTheme();
        document.addEventListener('DOMContentLoaded', function() {
          applyTheme();
          var btn = document.getElementById('theme-toggle-btn');
          if (btn) btn.addEventListener('click', function() {
            var preference = root.dataset.themePreference === 'system' ? 'system' : stored;
            stored = preference === 'system' ? 'light' : preference === 'light' ? 'dark' : 'system';
            root.dataset.themePreference = stored === 'system' ? 'system' : 'manual';
            try { localStorage.setItem('shiba-theme', stored); } catch (_) {}
            applyTheme();
          });
        });
        systemTheme.addEventListener('change', function() {
          if (root.dataset.themePreference === 'system') applyTheme();
        });
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <header class="site-header sticky top-0 z-50">
      <div class="shell header-inner">
        <a class="wordmark" href="/" aria-label="Shiba home">
          <img src="/assets/mascot/pet-logo.png" alt="Shiba Mascot" class="w-7 h-7 rounded-full bg-[var(--logo-paper)] object-contain border border-[var(--line-2)] p-0.5" />
          <span class="wordmark-name">Shiba</span>
        </a>
        <button type="button" id="nav-menu-btn" class="nav-menu-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Open navigation menu"><span class="nav-ico menu-ico" aria-hidden="true">≡</span><span class="nav-ico close-ico" aria-hidden="true">×</span></button>
        <nav aria-label="Main navigation" class="nav-links" id="site-nav">
          <a href="/why-shiba/" class="nav-link" aria-current={path === '/why-shiba/' ? 'page' : undefined}>Why Shiba</a>
          <a href="/#employees" class="nav-link">Agents</a>
          <a href="/integrations/" class="nav-link" aria-current={path === '/integrations/' ? 'page' : undefined}>Integrations</a>
          <a href="/docs/overview/" class="nav-link" aria-current={path === '/docs/overview/' ? 'page' : undefined}>Docs</a>
          <a href="https://github.com/princepal9120/shiba" class="nav-link" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
          <div class="nav-more">
            <button type="button" id="nav-more-btn" class="nav-link nav-more-btn" aria-expanded="false" aria-controls="nav-more-panel" class:list={{ 'has-current': !!morePage }} hidden>{morePage ? `More · ${morePage.label}` : 'More'} <span aria-hidden="true">⌄</span></button>
            <div id="nav-more-panel" class="nav-more-panel" hidden>
              <a href="/network/" aria-current={path === '/network/' ? 'page' : undefined}>Network</a>
              <a href="/docs/costs/" aria-current={path === '/docs/costs/' ? 'page' : undefined}>Cost</a>
              <a href="/blog/" aria-current={path.startsWith('/blog') ? 'page' : undefined}>Journal</a>
              <a href="/docs/architecture/" aria-current={path === '/docs/architecture/' ? 'page' : undefined}>Architecture</a>
              <a href="/docs/security/" aria-current={path === '/docs/security/' ? 'page' : undefined}>Security</a>
            </div>
          </div>
        </nav>
        <div class="nav-actions">
          <button
            type="button"
            id="theme-toggle-btn"
            hidden
            aria-label="Theme: system. Switch to light theme"
            title="Theme: system. Switch to light theme"
            class="nav-theme-toggle"
          >
            <svg class="icon-system size-3.5" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="13" rx="2" /><path d="M8 21h8m-4-4v4" /></svg>
            <svg class="icon-sun size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <svg class="icon-moon size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>
          <a class="nav-cta" href="/docs/self-hosting/">Self-host</a>
        </div>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="border-t border-[var(--line)] bg-[var(--paper)] mt-24 pt-16 pb-12">
      <div class="shell">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
          <div class="md:col-span-2 space-y-4">
            <div class="flex items-center gap-2.5">
              <img src="/assets/mascot/pet-logo.png" alt="Shiba Mascot" class="w-7 h-7 rounded-full bg-[var(--logo-paper)] object-contain border border-[var(--line-2)] p-0.5" />
              <span class="wordmark-name text-lg text-[var(--ink)]">Shiba</span>
            </div>
            <p class="text-xs text-[var(--ink-2)] max-w-sm leading-relaxed">
              A self-hosted AI workspace for tasks across your team. Role templates shape the work; standard sandbox execution requires your approval and a connected repository.
            </p>
            <div class="flex items-center gap-2 text-[11px] text-[var(--ink-2)]">
              <span class="w-1.5 h-1.5 footer-ok-dot"></span>
              <span>Open source (AGPL-3.0-only) · Cloudflare Native</span>
            </div>
          </div>
          <div class="space-y-3 text-xs">
            <div class="footer-h text-[var(--ink)]">Product &amp; Story</div>
            <ul class="space-y-2 text-[var(--ink-2)]">
              <li><a href="/why-shiba/" class="hover:text-[var(--navy)] transition-colors">Why I'm building Shiba</a></li>
              <li><a href="/blog/" class="hover:text-[var(--navy)] transition-colors">Journal</a></li>
              <li><a href="/open-source-devin-alternative/">Hosted alternatives</a></li>
              <li><a href="/integrations/" class="hover:text-[var(--navy)] transition-colors">Integrations</a></li>
              <li><a href="/network/" class="hover:text-[var(--navy)] transition-colors">Network</a></li>
              <li><a href="/waitlist/" class="hover:text-[var(--navy)] transition-colors">Join Waitlist &amp; Contribute</a></li>
              <li><a href="https://github.com/princepal9120/shiba" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--navy)] transition-colors">GitHub Repository ↗</a></li>
            </ul>
          </div>
          <div class="space-y-3 text-xs">
            <div class="footer-h text-[var(--ink)]">Technical Docs</div>
            <ul class="space-y-2 text-[var(--ink-2)]">
              <li><a href="/docs/overview/" class="hover:text-[var(--navy)] transition-colors">Overview</a></li>
              <li><a href="/docs/getting-started/" class="hover:text-[var(--navy)] transition-colors">Quickstart</a></li>
              <li><a href="/docs/architecture/" class="hover:text-[var(--navy)] transition-colors">Architecture Spec</a></li>
              <li><a href="/docs/security/" class="hover:text-[var(--navy)] transition-colors">Security &amp; Egress Gates</a></li>
              <li><a href="/docs/contributing/" class="hover:text-[var(--navy)] transition-colors">Contributor guide</a></li>
              <li><a href="/docs/costs/">Costs</a></li>
              <li><a href="/docs/sandbox-providers/">Sandbox providers</a></li>
              <li><a href="/docs/readiness/">Readiness</a></li>
            </ul>
          </div>
        </div>
        <div class="statusbar">
          <div class="statuscell">© 2026 SHIBA · AGPL-3.0 LICENSE</div>
          <div class="statuscell">CLOUDFLARE WORKERS + SANDBOX</div>
          <div class="statuscell status-links">
            <a href="/privacy/">Privacy</a>
            <a href="/terms/">Terms</a>
            <a href="/sitemap.xml">Sitemap</a>
            <a href="/llms.txt">llms.txt</a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      const menuBtn = document.getElementById('nav-menu-btn');
      const siteNav = document.getElementById('site-nav');
      const moreBtn = document.getElementById('nav-more-btn');
      const morePanel = document.getElementById('nav-more-panel');
      if (menuBtn && siteNav && moreBtn && morePanel) {
        moreBtn.hidden = false;
        const setMore = (open: boolean) => {
          moreBtn.setAttribute('aria-expanded', String(open));
          morePanel.hidden = !open;
        };
        const setMenu = (open: boolean) => {
          menuBtn.setAttribute('aria-expanded', String(open));
          menuBtn.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
          siteNav.classList.toggle('nav-open', open);
          if (!open) setMore(false);
        };
        menuBtn.addEventListener('click', () => setMenu(menuBtn.getAttribute('aria-expanded') !== 'true'));
        moreBtn.addEventListener('click', () => setMore(morePanel.hidden));
        moreBtn.addEventListener('keydown', event => {
          if (event.key === 'ArrowDown') { event.preventDefault(); setMore(true); morePanel.querySelector('a')?.focus(); }
        });
        document.addEventListener('keydown', event => {
          if (event.key !== 'Escape') return;
          if (!morePanel.hidden) { setMore(false); moreBtn.focus(); }
          else if (menuBtn.getAttribute('aria-expanded') === 'true') { setMenu(false); menuBtn.focus(); }
        });
        siteNav.addEventListener('click', event => {
          if ((event.target as HTMLElement).closest('a')) { setMore(false); setMenu(false); }
        });
        document.addEventListener('pointerdown', event => {
          const target = event.target as Node;
          if (!moreBtn.parentElement?.contains(target)) setMore(false);
          if (!siteNav.contains(target) && !menuBtn.contains(target)) setMenu(false);
        });
        siteNav.addEventListener('focusout', () => {
          requestAnimationFrame(() => {
            if (!moreBtn.parentElement?.contains(document.activeElement)) setMore(false);
            if (!siteNav.contains(document.activeElement) && document.activeElement !== menuBtn) setMenu(false);
          });
        });
        matchMedia('(max-width: 800px)').addEventListener('change', () => setMenu(false));
      }

    </script>
  </body>
</html>

<style is:global>
  /* bezalel.sh paper-OS marketing system with Light & Dark Theme Support */
  :root {
    color-scheme: light;
    --paper: #f6f4ed;
    --card: #fffef8;
    --panel-2: #f1efe6;
    --ink: #222320;
    /* Muted ink sits at 6.1:1 on paper (was 3.9:1) so the 9-11px mono
       microcopy that uses it clears WCAG AA for normal text. */
    --ink-2: #585d50;
    --line: #e0ded5;
    --line-2: #d3d2c8;
    --input-line: #7d7e73;
    --navy: #0000a8;
    --navy-2: #1c1cc8;
    --paper-title: #0000a8;
    --paper-title-fg: #ffffff;
    --paper-shadow: #2527261c;
    --paper-dot: #24272919;
    --ok: #227146;
    --pending: #8a5a00;
    --danger: #b3261e;
    --on-accent: #ffffff;
    /* Brand artwork has dark marks baked in; retain its neutral backing in both themes. */
    --logo-paper: #ffffff;
    --mask-opaque: #000000;
    --window-button: #bdbdbd;
    --window-edge: #444444;
    --window-highlight: #f5f5f5;
    --surface: var(--card);
    --text: var(--ink);
    --muted: var(--ink-2);
    --teal: var(--navy);
    --r-sm: 8px;
    --r-md: 12px;
    --r-lg: 18px;
    --shadow-soft: 0 3px 6px #00000008, 0 14px 38px #00000014;
    --dur-fast: 150ms;
    --dur-med: 300ms;
    --ease-out: cubic-bezier(.22, 1, .36, 1);
  }

  html[data-theme='dark'] {
    color-scheme: dark;
    --paper: #191a18;
    --card: #222320;
    --panel-2: #272824;
    --ink: #eae8e1;
    --ink-2: #aaa99f;
    --line: #3b3d36;
    --line-2: #4a4c44;
    --input-line: #85877b;
    --navy: #9cbce2;
    --navy-2: #b4cde9;
    --paper-title: #222320;
    --paper-title-fg: #eae8e1;
    --paper-shadow: rgba(0, 0, 0, 0.5);
    --paper-dot: rgba(255, 255, 255, 0.08);
    --ok: #8fbc6f;
    --pending: #ebc04b;
    --danger: #e26d5a;
    --surface: var(--card);
    --text: var(--ink);
    --muted: var(--ink-2);
    --teal: var(--navy);
    --on-accent: #152335;
    --window-button: #4a4d46;
    --window-edge: #1a1a18;
    --window-highlight: #6c7066;
  }

  /* CSS fallback also honors the OS when scripts or storage are unavailable. */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      color-scheme: dark;
      --paper: #191a18;
      --card: #222320;
      --panel-2: #272824;
      --ink: #eae8e1;
      --ink-2: #aaa99f;
      --line: #3b3d36;
      --line-2: #4a4c44;
      --input-line: #85877b;
      --navy: #9cbce2;
      --navy-2: #b4cde9;
      --paper-title: #222320;
      --paper-title-fg: #eae8e1;
      --paper-shadow: rgba(0, 0, 0, 0.5);
      --paper-dot: rgba(255, 255, 255, 0.08);
      --ok: #8fbc6f;
      --pending: #ebc04b;
      --danger: #e26d5a;
      --on-accent: #152335;
      --window-button: #4a4d46;
      --window-edge: #1a1a18;
      --window-highlight: #6c7066;
    }
    :root:not([data-theme='light']) .icon-sun { display: block; }
    :root:not([data-theme='light']) .icon-moon { display: none; }
  }

  /* theme toggle icon swap (tailwind dark: is media-mode; use attr) */
  .icon-system { display: none; }
  html[data-theme-preference='system'] #theme-toggle-btn :is(.icon-sun, .icon-moon) { display: none; }
  html[data-theme-preference='system'] #theme-toggle-btn .icon-system { display: block; }
  .icon-sun { display: none; }
  .icon-moon { display: block; }
  html[data-theme='dark'] .icon-sun { display: block; }
  html[data-theme='dark'] .icon-moon { display: none; }

  /* Mobile menu button: desktop-only rules hide it; below 960px it becomes
     another cell in the actions group and the links collapse into a dropdown. */
  .nav-menu-toggle { display: none; }
  .nav-ico { font-family: 'Geist Mono', monospace; font-size: 16px; line-height: 1; }
  .close-ico { display: none; font-size: 18px; }
  .nav-menu-toggle[aria-expanded='true'] .menu-ico { display: none; }
  .nav-menu-toggle[aria-expanded='true'] .close-ico { display: block; }

  .footer-ok-dot { background: var(--ok); }
  .status-ok { color: var(--ok); }
  .status-err { color: var(--danger); }

  /* TaskForm (React island) theme tokens */
  :root {
    --tf-input-bg: var(--card);
    --tf-line: var(--input-line);
    --tf-ink: var(--ink);
    --tf-muted: var(--ink-2);
    --tf-accent: var(--navy);
    --tf-accent-hover: var(--navy-2);
    --tf-on-accent: var(--on-accent);
    --tf-hover: var(--panel-2);
  }

  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; text-size-adjust: 100%; -webkit-tap-highlight-color: transparent; }
  @media (prefers-reduced-motion: no-preference) { html { scroll-behavior: smooth; } }
  /* Keep reduced-motion navigation instant, including in-page anchors. */
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto !important; } }
  body { margin: 0; background: var(--paper); color: var(--ink); font-family: 'Geist', ui-sans-serif, system-ui, -apple-system, sans-serif; line-height: 1.55; overscroll-behavior-x: none; }
  ::selection { background: var(--navy); color: var(--on-accent); }
  html[data-theme='dark'] ::selection { background: var(--navy); color: var(--on-accent); }
  a { color: inherit; }
  a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 2px solid var(--navy); outline-offset: 2px; }
  .shell { width: min(1160px, calc(100% - 40px)); margin-inline: auto; }
  .pixelated { image-rendering: pixelated; }
  [hidden] { display: none !important; }
  .skip-link { position: fixed; top: 8px; left: 20px; z-index: 100; padding: 10px 16px; background: var(--card); color: var(--navy); transform: translateY(-160%); }
  .skip-link:focus { transform: translateY(0); }

  /* Compact disclosure navigation; the page stays visible behind the header. */
  .site-header { position: sticky; top: 0; z-index: 50; border-bottom: 1px solid color-mix(in srgb, var(--ink) 10%, transparent); background: color-mix(in srgb, var(--paper) 93%, transparent); backdrop-filter: blur(12px); }
