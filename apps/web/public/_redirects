# The waitlist POST lives in the Worker on app.tryshiba.dev; Pages cannot
# serve it. 200 = edge proxy (method, body and headers forwarded), not a
# redirect. The Worker accepts the tryshiba.dev Origin for this route.
/api/waitlist https://app.tryshiba.dev/api/waitlist 200

# The live dashboard is the Worker at app.tryshiba.dev — the static copy
# under /app/ is a snapshot with no /api/* backend. Send dashboard traffic
# to the real host; keep /app/ itself serving for deep assets.
/app https://app.tryshiba.dev/app/ 301
/app/ https://app.tryshiba.dev/app/ 301
/app/* https://app.tryshiba.dev/app/:splat 301

# Path aliases for dashboard
/dashboard https://app.tryshiba.dev/app/ 301
/dashboard/ https://app.tryshiba.dev/app/ 301
/dashboard/* https://app.tryshiba.dev/app/:splat 301
