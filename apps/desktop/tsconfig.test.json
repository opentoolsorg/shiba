{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Vitest loads tests as ESM through Vite (import.meta works), unlike the CJS src build.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": ".",
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest*.mts"]
}
