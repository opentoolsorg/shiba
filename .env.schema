# Copy to .env (gitignored) or run `pnpm run bootstrap`, which writes it for you.
# alchemy.run.ts loads this file; every secret present here is bound on deploy,
# and any secret missing here is REMOVED from the Worker on the next deploy.
#
# varlock schema — `pnpm env:load` validates this file against your .env;
# `pnpm env:scan` greps the repo for leaked secret values. Per-account
# secrets (*_SUBSCRIPTION_*_<ACCOUNT>) resolve by name at egress — declare
# the base name here, suffixes need no item.
# @defaultRequired=false @defaultSensitive=false

# --- Dashboard access -------------------------------------------------------

# Cloudflare Access on each stage's public hostname. When empty, Alchemy requires
# BETTER_AUTH_SECRET plus BETTER_AUTH_BOOTSTRAP_TOKEN or BETTER_AUTH_OWNER_EMAIL.
# @type=email
ACCESS_EMAILS=you@example.com

# The <x> in https://shiba-ai-coworker.<x>.workers.dev
WORKERS_SUBDOMAIN=
# Public hostname of the dashboard/API — the custom-domain route when one is
# bound (e.g. app.tryshiba.dev), else the workers.dev host. Feeds screenshot
# URLs and bootstrap output.
WORKER_HOSTNAME=

# --- Cloudflare deploy credentials ------------------------------------------

# API token optional when an Alchemy Cloudflare profile is stored.
# @sensitive
CLOUDFLARE_API_TOKEN=
# An identifier, not a credential — also embedded in the dogfood container
# image path (registry.cloudflare.com/<id>/...), so not @sensitive.
# Required deployment target: exactly 32 lowercase hexadecimal characters.
# @required @type=string(matches=regex("^[a-f0-9]{32}$"))
CLOUDFLARE_ACCOUNT_ID=
# Optional prebuilt image in the explicit deployment account's registry.
SANDBOX_IMAGE=

# --- Worker secrets (wrangler secret put / alchemy secrets(...)) ------------

# @sensitive
GITHUB_TOKEN=
# @sensitive
AI_GATEWAY_TOKEN=
# @sensitive
SLACK_SIGNING_SECRET=
# @sensitive
SLACK_BOT_TOKEN=
# Comma-separated Slack approver user IDs — not a credential.
SLACK_APPROVERS=
# Slack channel→repo routing map — not a credential.
SLACK_CHANNEL_REPOS=
# Comma-separated dashboard sign-in emails allowed to resolve shared approvals
# (automations, PR review lane, Sentry, email); unset = nobody. Not a credential.
DASHBOARD_APPROVERS=
# @sensitive
GITHUB_WEBHOOK_SECRET=
# @sensitive
TYPESAFE_API_KEY=
# Optional vendor-registered MCP OAuth client IDs (identifiers, not credentials).
MCP_OAUTH_CLIENT_STRIPE=
MCP_OAUTH_CLIENT_NOTION=
MCP_OAUTH_CLIENT_SENTRY=
MCP_OAUTH_CLIENT_POSTHOG=
MCP_OAUTH_CLIENT_FIGMA=
MCP_OAUTH_CLIENT_JIRA_ATLASSIAN=
# Optional deployment-wide operator lanes (not the Dashboard Providers OAuth path).
# Per-user sign-in on /app Providers uses MODEL_CREDENTIAL_KEY + UserProviderOAuth
# instead of these secrets for Codex, Claude, Cursor, Grok, and Antigravity.
# T48: `claude setup-token` when SHIBA_CLAUDE_SUBSCRIPTION=1 and no per-user token.
# @sensitive
CLAUDE_SUBSCRIPTION_TOKEN=

# T49: `codex login` auth.json when SHIBA_CODEX_SUBSCRIPTION=1 and no per-user SIWC.
# @sensitive
CODEX_SUBSCRIPTION_AUTH_JSON=

# Cursor Agent API key when SHIBA_CURSOR_SUBSCRIPTION=1 and no per-user OAuth.
# @sensitive
CURSOR_SUBSCRIPTION_TOKEN=

# T51: the bearer the `shiba local` daemon presents on /api/local/*.
# @sensitive
LOCAL_ADAPTER_TOKEN=

# Edge identity signing: HMAC key for Worker→DO vouched-header requests
# (X-Agent-Principal / X-Shiba-Intake). Unset = header-trust fallback with a
# warning; set = signed requests only for vouched calls.
# @sensitive
INTERNAL_SIGNING_KEY=

# @sensitive
ARTIFACT_SIGNING_KEY=

# Telegram webhook lane (POST /api/telegram/webhook).
# @sensitive
TELEGRAM_BOT_TOKEN=
# @sensitive
TELEGRAM_WEBHOOK_SECRET=

# Discord interactions lane (POST /api/discord/interactions) — the app's
# Ed25519 public key, used to verify request signatures.
# @sensitive
DISCORD_PUBLIC_KEY=

# --- Feature flags and model picks (plain vars, never secrets) ---------------

# Dashboard Providers (Codex, Claude, Cursor, Grok, Antigravity): per-user OAuth
# on the card. Bind MODEL_CREDENTIAL_KEY (64 hex) in worker secrets / .dev.vars;
# Antigravity also needs GOOGLE_ANTIGRAVITY_CLIENT_SECRET on the Worker. No
# CLAUDE_SUBSCRIPTION_TOKEN / CURSOR_SUBSCRIPTION_TOKEN / CODEX_SUBSCRIPTION_AUTH_JSON
# required for that path.

# @sensitive 64 hex chars — encrypts per-user OAuth and setup-token material (D1).
MODEL_CREDENTIAL_KEY=
# @sensitive — Google OAuth client secret for Antigravity / Cloud Code Assist PKCE.
GOOGLE_ANTIGRAVITY_CLIENT_SECRET=

# Optional deployment-wide *-subscription harness lanes (operator wrangler secrets).
# Absent = harness dark. Local opencodex-style runs usually leave these off and
# use Providers sign-in only.
SHIBA_CLAUDE_SUBSCRIPTION=
SHIBA_CODEX_SUBSCRIPTION=
SHIBA_ANTIGRAVITY_SUBSCRIPTION=
SHIBA_CURSOR_SUBSCRIPTION=
# Allow Worker-secret codex-subscription when a single operator owns the deployment.
SHIBA_SINGLE_USER=
# T51 local-runtime opt-in; absent = runtime:"local" is refused.
SHIBA_LOCAL_RUNTIME=
# Sandbox backend: cloudflare (default) | docker-local. Others are documented in sandbox-providers.md.
SHIBA_SANDBOX_PROVIDER=
SHIBA_SANDBOX_TIMEOUT_MS=
SHIBA_SANDBOX_REGION=
SHIBA_SANDBOX_EGRESS_ALLOWLIST=
SHIBA_SANDBOX_ENV_PASSTHROUGH=
SHIBA_E2B_MOCK=
# Required when using a provider without Worker-side egress enforcement (e.g. docker-local).
SHIBA_SANDBOX_ALLOW_UNENFORCED_EGRESS=
# docker-local: container image (build apps/backend/Dockerfile locally).
SHIBA_DOCKER_SANDBOX_IMAGE=
# docker-local: host for preview URLs (default 127.0.0.1).
SHIBA_DOCKER_PREVIEW_HOST=
# ComputeSDK multi-provider harness (Node/Bun host only); see docs/sandbox-cheapest-provider.md
SHIBA_COMPUTESDK_PROVIDER=
# @sensitive — ComputeSDK provider credentials (never log)
E2B_API_KEY=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
DAYTONA_API_KEY=
CLOUDFLARE_SANDBOX_URL=
CLOUDFLARE_SANDBOX_API_KEY=
# Enables the automations scheduler loop.
AUTOMATIONS_ENABLED=
# Enables the memory subsystem (Vectorize + Memory DO).
MEMORY_ENABLED=
# Default harness for runs when none is pinned (gateway/BYOK lanes, not Providers OAuth).
AGENT_HARNESS=
# Gateway-backed harness model ids (AI Gateway BYOK — not per-user OAuth).
CLAUDE_CODE_MODEL=
CODEX_MODEL=
GROK_MODEL=
PI_MODEL=
# OAuth / subscription harness defaults (codex-subscription, claude-subscription,
# antigravity-subscription, cursor-subscription). Providers card OAuth still uses
# per-user tokens; these vars only override the deployment default model id.
CLAUDE_SUBSCRIPTION_MODEL=
CODEX_SUBSCRIPTION_MODEL=
ANTIGRAVITY_SUBSCRIPTION_MODEL=
CURSOR_SUBSCRIPTION_MODEL=
# PLAN-V2-NEXT ACP registry lane: comma-separated agent ids ("*" = all).
# Absent = the `acp` harness is dark.
ACP_REGISTRY_ALLOWLIST=
# Operator-pinned registry snapshot (cdn.agentclientprotocol.com .../registry.json,
# verbatim JSON). Resolution is offline — never fetched at admit time.
ACP_REGISTRY_JSON=
# Deployment default for the acp lane (an `acp/<id>` model id).
ACP_MODEL=
# T52 per-role routing pins (agents/roles.ts). ROLE_MODEL_MAP is one JSON
# object, e.g. {"fixer":{"harness":"opencode","model":"opencode-go/deepseek-v3.2"}};
# ROLE_MODEL__<ROLE> is a single "harness/model" or bare "harness" pin.
ROLE_MODEL_MAP=
ROLE_MODEL__ORCHESTRATOR=
ROLE_MODEL__EXPLORER=
ROLE_MODEL__FIXER=
ROLE_MODEL__REVIEWER=
ROLE_MODEL__DESIGNER=
# Slack channel for approval messages.
SLACK_APPROVALS_CHANNEL=
# Room-to-Slack delivery worker opt-in; unset/false disables outbound delivery.
SLACK_ROOM_OUTBOX_ENABLED=false
# Optional native session status. Requires agent_view and verified installed scopes.
SLACK_AGENT_SESSIONS_ENABLED=false
SLACK_AGENT_SESSIONS_TEAM_ID=
# Exact Slack team/channel to Access owner policy. Empty disables canvas views.
# Keep the JSON wire string intact; the Worker strictly validates every entry.
# @type=string
SLACK_CANVAS_OWNERS="[]"
# External MCP egress allowlist; comma-separated exact public hostnames only.
# Empty = no external MCP servers can be contacted.
MCP_TRUSTED_HOSTS=
# Optional daily USD budget shown on the usage dashboard card.
# @type=number
USAGE_BUDGET_USD=
# Telegram approver user ids + chat→repo routing map — not credentials.
TELEGRAM_APPROVERS=
TELEGRAM_CHAT_REPOS=
# Per-channel harness overrides (blank = AGENT_HARNESS).
TELEGRAM_AGENT_HARNESS=
# Discord approver user ids + channel→repo routing map — not credentials.
DISCORD_APPROVERS=
DISCORD_CHANNEL_REPOS=
DISCORD_AGENT_HARNESS=
# Optional chat-lane employee defaults (Slack/Discord/Telegram).
CHAT_EMPLOYEE_DEFAULT=
CHAT_EMPLOYEE_ORG_ID=
CHAT_EMPLOYEE_ACTOR=
# The agent's mailbox identity — inbound email it may read for logins/OTPs and
# the address `latest_verification` scans when no mailbox arg is given
# (default dev@tryshiba.dev). Plain var, not a secret. Register it with
# `POST /api/mailboxes` after deploy, then point a Cloudflare Email Routing
# custom address at this worker.
# @type=email
AGENT_MAILBOX=
# Set by alchemy live deploys — do not set locally.
REQUIRE_ACCESS=

# Built-in dashboard auth lane (better-auth.ts): email+password accounts and
# signed-cookie sessions at /api/auth/*, backed by the AGENT_AUDIT D1
# database. The library requires >=32 chars; unset/shorter = lane dark and
# the gate falls back to Access / fail-closed. `pnpm run bootstrap` asks and
# generates one when accepted.
# @sensitive
BETTER_AUTH_SECRET=
# Canonical public dashboard URL (cookie scope + origin checks), e.g.
# https://app.tryshiba.dev — unset = each request's own origin.
# @type=url
BETTER_AUTH_URL=
# First dashboard account on a public host. Set one of these before sign-up.
# The sign-up form sends the token as x-shiba-bootstrap-token.
# Loopback dev can create the first account without either.
# @sensitive
BETTER_AUTH_BOOTSTRAP_TOKEN=
# Allowlisted email for that first account. Compared case-insensitively.
# @type=email
BETTER_AUTH_OWNER_EMAIL=
BETTER_AUTH_VERIFICATION_FROM=

# Gmail read-only connection. Configure your own Google OAuth web client;
# consent requests only gmail.readonly, offline access, and PKCE S256.
# Owners are keyed by Access subject+AUD or Better Auth user id: disconnect Gmail
# before changing ACCESS_AUD or the auth lane, or its grants become unreachable.
GMAIL_CLIENT_ID=
# @sensitive
GMAIL_CLIENT_SECRET=
# Exact registered callback URL, e.g. http://localhost:8788/api/connections/gmail/callback.
# HTTPS required except localhost/loopback. Never uses a request-supplied redirect.
# @type=url
GMAIL_REDIRECT_URI=
# 32 cryptographically random bytes as 64 hex chars. Keep stable: changing this
# key makes existing encrypted refresh tokens unreadable; disconnect/reconnect.
# @sensitive
GMAIL_TOKEN_KEY=
# `cloudflare` = alchemy state in CF state store; unset = local state files.
ALCHEMY_STATE_BACKEND=

# Sole SaaS integrations provider: separately deployed open-connector.
INTEGRATIONS_PROVIDER=openconnector
OPEN_CONNECTOR_WORKER=
OPEN_CONNECTOR_URL=
# @sensitive
OPEN_CONNECTOR_ADMIN_TOKEN=
# @sensitive
OPEN_CONNECTOR_RUNTIME_TOKEN=

# Owner-bound local team execution. Existing local runtime flag is also required.
# @type=string
SHIBA_PERSONAL_LOCAL_EXECUTION=0

# Explicit operator-funded native team text turns; never enables an implicit billing fallback.
# @type=string
SHIBA_TEAM_MODEL_SESSIONS=0
# @type=string
SHIBA_TEAM_MODEL_MODEL=@cf/zai-org/glm-4.7-flash

# Optional standing reads, managed Slack installations and isolated desktop.
# No credentials, connections or compute are created by these defaults.
# @type=string
SHIBA_SHARED_COMPUTER=0
# @type=string
SHIBA_SHARED_COMPUTER_IMAGE=
# @type=string
FOUNDER_AUTOMATIC_READS_ENABLED=false
# @type=string
FOUNDER_STRIPE_READS_ENABLED=false
# Worker-only encryption key (64 hex); separate from account credentials.
# @sensitive
FOUNDER_STRIPE_CREDENTIAL_KEY=
# @type=string
FOUNDER_META_READS_ENABLED=false
# Worker-only Meta encryption key (64 hex), separate from account credentials.
# @sensitive
FOUNDER_META_CREDENTIAL_KEY=
# @type=string
OPEN_CONNECTOR_READ_VERSION_ID=
# @type=string
OPEN_CONNECTOR_READ_MANIFEST_SHA256=
# @type=string
SLACK_INSTALLATIONS_ENABLED=false
# @type=string
SLACK_OAUTH_APP_ID=
# @type=string
SLACK_OAUTH_CLIENT_ID=
# @type=string
SLACK_OAUTH_REDIRECT_URI=
# @type=string
SLACK_OAUTH_PKCE_ENABLED=false
# @type=string
SLACK_OAUTH_QUERY_REDACTION_VERIFIED=false
# @type=string
SLACK_LEGACY_MODE_ENABLED=false
# @type=string
SLACK_LEGACY_TEAM_ID=
# @type=string
SLACK_LEGACY_APP_ID=
# Worker-only encrypted bot credential keyring; never expose to a container.
# @sensitive
SLACK_INSTALLATION_KEYRING=

# Existing reviewed gateway Worker name, only for the optional Alchemy service binding.
# @type=string
OPEN_CONNECTOR_READ_WORKER=
# Separate scoped read-lane key; never replace the existing manual integration key.
# @sensitive
OPEN_CONNECTOR_READ_RUNTIME_TOKEN=
# Exact workspace/connection/operation runtime keys; JSON array, Worker-only.
# @sensitive
OPEN_CONNECTOR_SCOPED_READ_RUNTIME_TOKENS=
